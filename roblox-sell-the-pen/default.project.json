{
  "name": "SellMeThisPen",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Remotes": {
        "$className": "Folder",
        "DataSync": { "$className": "RemoteEvent" },
        "Notify": { "$className": "RemoteEvent" },
        "PitchStart": { "$className": "RemoteEvent" },
        "PitchUpdate": { "$className": "RemoteEvent" },
        "PitchEnd": { "$className": "RemoteEvent" },
        "PitchAction": { "$className": "RemoteEvent" },
        "Hum": { "$className": "RemoteEvent" },
        "Purchase": { "$className": "RemoteFunction" },
        "IPO": { "$className": "RemoteFunction" },
        "Teleport": { "$className": "RemoteFunction" },
        "FireBroker": { "$className": "RemoteFunction" },
        "Deal": { "$className": "RemoteEvent" },
        "Flip": { "$className": "RemoteEvent" },
        "GetPreview": { "$className": "RemoteFunction" },
        "Tutorial": { "$className": "RemoteEvent" }
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "StreamingEnabled": false
      },
      "Map": {
        "$path": "map/Map.model.json"
      }
    },

    "Lighting": {
      "$properties": {
        "ClockTime": 15.4,
        "GeographicLatitude": 40.7,
        "Brightness": 3,
        "Ambient": [0.5, 0.47, 0.44],
        "OutdoorAmbient": [0.66, 0.62, 0.58],
        "EnvironmentDiffuseScale": 1,
        "ExposureCompensation": 0.3,
        "EnvironmentSpecularScale": 1,
        "GlobalShadows": true,
        "ShadowSoftness": 0.25,
        "Technology": "Future"
      },
      "Atmosphere": {
        "$className": "Atmosphere",
        "$properties": {
          "Density": 0.3,
          "Offset": 0.2,
          "Color": [0.98, 0.78, 0.6],
          "Decay": [0.55, 0.35, 0.45],
          "Glare": 0.2,
          "Haze": 0.7
        }
      },
      "Bloom": {
        "$className": "BloomEffect",
        "$properties": { "Intensity": 0.6, "Size": 24, "Threshold": 1.6 }
      },
      "SunRays": {
        "$className": "SunRaysEffect",
        "$properties": { "Intensity": 0.08, "Spread": 0.7 }
      },
      "MoneyGrade": {
        "$className": "ColorCorrectionEffect",
        "$properties": {
          "Brightness": 0.05,
          "Contrast": 0.12,
          "Saturation": 0.18,
          "TintColor": [1, 0.97, 0.9]
        }
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
