-- Rendering ------------------------------------------------------------------

local function tagName(tag)
	return session and session.tags and session.tags[tag] or tag
end

local function renderTags()
	local likes = {}
	for _, tag in session.customer.likes do
		table.insert(likes, string.format('<font color="#%s">%s</font>', Theme.TagColors[tag]:ToHex(), tagName(tag)))
	end
	ui.likes.Text = "Likes: " .. (#likes > 0 and table.concat(likes, ", ") or "anything")
	local hates = {}
	for _, tag in session.customer.dislikes do
		if revealedDislikes[tag] then
			table.insert(hates, string.format('<font color="#%s">%s</font>', Theme.TagColors[tag]:ToHex(), tagName(tag)))
		else
			table.insert(hates, '<font color="#777777">???</font>')
		end
	end
	ui.hates.Text = "Hates: " .. (#hates > 0 and table.concat(hates, ", ") or "nothing")
end

local function renderMeters(deltas)
	for _, info in METERS do
		local meter = ui.meters[info.key]
		local value = session.meters[info.key]
		Theme.tween(meter.fill, 0.45, { Size = UDim2.fromScale(value / 10, 1) }, Enum.EasingStyle.Back)
		meter.value.Text = (value % 1 == 0) and string.format("%d", value) or string.format("%.1f", value)
		if deltas and deltas[info.key] then
			deltaPopup(meter, deltas[info.key])
		end
	end
	for _, child in ui.patience:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for i = 1, session.maxPatience do
		Theme.create("Frame", {
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = i <= session.patience and Colors.gold or Colors.panelLight,
			Parent = ui.patience,
		}, { Theme.corner(8) })
	end
	local chance = math.floor(session.closeChance * 100 + 0.5)
	ui.close.Text = string.format("CLOSE\n%d%%", chance)
end

local function renderOptions()
	for _, child in ui.options:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	if #session.options == 0 then
		local note = Theme.button({
			Size = UDim2.new(1, 0, 0, 70),
			BackgroundColor3 = Colors.panel,
			Font = Theme.FontBlack,
			Text = "LAST CHANCE: Close now, or they walk!",
			TextColor3 = Colors.red,
			Parent = ui.options,
		})
		Theme.corner(12).Parent = note
		return
	end
	for index, option in session.options do
		local color = Theme.TagColors[option.tag] or Colors.text
		local button = Theme.button({
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 74),
			BackgroundColor3 = option.napkin and Color3.fromRGB(70, 55, 10) or Colors.panel,
			BackgroundTransparency = 0.05,
			Parent = ui.options,
		}, function()
			PitchUI.choose(index)
		end)
		Theme.corner(12).Parent = button
		Theme.stroke(color, option.napkin and 3 or 1.5).Parent = button
		Theme.label({
			Position = UDim2.fromOffset(12, 8),
			Size = UDim2.fromOffset(34, 58),
			Font = Theme.FontBlack,
			Text = tostring(index),
			TextColor3 = color,
			Parent = button,
		})
		Theme.label({
			Position = UDim2.fromOffset(54, 6),
			Size = UDim2.new(1, -66, 0, 18),
			Font = Theme.FontBlack,
			Text = string.upper(tagName(option.tag)),
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = button,
		})
		Theme.label({
			Position = UDim2.fromOffset(54, 26),
			Size = UDim2.new(1, -66, 0, 40),
			Font = Theme.FontBold,
			Text = '"' .. option.text .. '"',
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = button,
		})
	end
end

local function say(text, color)
	ui.speech.Text = text or ""
	ui.speech.TextColor3 = color or Colors.text
	Theme.pop(ui.speech, 0.25)
end

local function setPhase(newPhase)
	phase = newPhase
	ui.options.Visible = newPhase == "choose" or newPhase == "waiting"
	ui.tonality.Visible = newPhase == "tonality"
end

-- Actions ------------------------------------------------------------------------

function PitchUI.choose(index)
	if phase ~= "choose" or not session.options[index] then
		return
	end
	chosenIndex = index
	signal:Fire("line")
	playDing(1.2)
	needle.pos = math.random()
	needle.dir = math.random() < 0.5 and -1 or 1
	needle.center = 0.2 + math.random() * 0.6
	needle.speed = 1.1 + (session.customer.budget or 1) * 0.04 + math.random() * 0.3
	ui.sweet.Position = UDim2.fromScale(needle.center, 0)
	ui.sweet.Size = UDim2.fromScale(session.sweetSpot, 1)
	ui.tonalityHint.Text = '"' .. session.options[index].text .. '"'
	setPhase("tonality")
end

function PitchUI.stopNeedle()
	if phase ~= "tonality" then
		return
	end
	local distance = math.abs(needle.pos - needle.center)
	local half = session.sweetSpot / 2
	local accuracy
	if distance <= half then
		accuracy = 1 - 0.2 * (distance / half)
	else
		accuracy = math.max(0, 0.8 - (distance - half) * 2.4)
	end
	local verdict
	if accuracy >= 0.95 then
		verdict = "PERFECT TONALITY!"
	elseif accuracy >= 0.8 then
		verdict = "Smooth."
	elseif accuracy >= 0.4 then
		verdict = "A bit shaky..."
	else
		verdict = "You mumbled it."
	end
	say(verdict, accuracy >= 0.8 and Colors.money or Colors.red)
	setPhase("waiting")
	signal:Fire("tonality", accuracy)
	Remotes.PitchAction:FireServer({ type = "line", index = chosenIndex, tonality = accuracy })
end

function PitchUI.close()
	if phase ~= "choose" then
		return
	end
	setPhase("waiting")
	say("...", Colors.muted)
	signal:Fire("close")
	Remotes.PitchAction:FireServer({ type = "close" })
end

function PitchUI.leave()
	if phase == "idle" or phase == "ended" then
		return
	end
	Remotes.PitchAction:FireServer({ type = "leave" })
end

local function showStamp(title, titleColor, amount, amountColor, line)
	ui.stamp.Visible = true
	ui.stampTitle.Text = title
	ui.stampTitle.TextColor3 = titleColor
	ui.stampAmount.Text = amount or ""
	ui.stampAmount.TextColor3 = amountColor or Colors.money
	ui.stampLine.Text = line or ""
	ui.stampTitle.TextTransparency = 0
	ui.stampAmount.TextTransparency = 0
	ui.stampLine.TextTransparency = 0
	local scale = ui.stamp:FindFirstChildOfClass("UIScale") or Theme.create("UIScale", { Parent = ui.stamp })
	scale.Scale = 2.2
	Theme.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		Theme.tween(ui.stampTitle, 0.4, { TextTransparency = 1 })
		Theme.tween(ui.stampAmount, 0.4, { TextTransparency = 1 })
		Theme.tween(ui.stampLine, 0.4, { TextTransparency = 1 })
		task.wait(0.45)
		ui.stamp.Visible = false
	end)
end

local function confetti()
	for _ = 1, 40 do
		local piece = Theme.create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(-40, 40), 0.42, 0),
			Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 24)),
			BackgroundColor3 = ({ Colors.money, Colors.gold, Color3.new(1, 1, 1) })[math.random(1, 3)],
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			ZIndex = 29,
			Parent = screen,
		})
		Theme.tween(piece, 1.6 + math.random(), {
			Position = UDim2.new(0.5 + (math.random() - 0.5) * 1.1, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-400, 400),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(2.8, function()
			piece:Destroy()
		end)
	end
end

-- Plant your feet while pitching (Space is needed for the tonality bar).
local frozen
local function freezeCharacter(freeze)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if freeze and not frozen then
		frozen = { walk = humanoid.WalkSpeed, jump = humanoid.JumpPower, jumpHeight = humanoid.JumpHeight }
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	elseif not freeze and frozen then
		humanoid.WalkSpeed = frozen.walk
		humanoid.JumpPower = frozen.jump
		humanoid.JumpHeight = frozen.jumpHeight
		frozen = nil
	end
end

local function openUI()
	Modal.closeAll()
	freezeCharacter(true)
	ui.root.Visible = true
	Theme.tween(ui.barTop, 0.4, { Size = UDim2.new(1, 0, 0, 54) })
	Theme.tween(ui.barBottom, 0.4, { Size = UDim2.new(1, 0, 0, 54) })
	Theme.pop(ui.bottom, 0.35)
end

local function closeUI()
	phase = "ended"
	Theme.tween(ui.barTop, 0.3, { Size = UDim2.new(1, 0, 0, 0) })
	Theme.tween(ui.barBottom, 0.3, { Size = UDim2.new(1, 0, 0, 0) })
	task.delay(0.3, function()
		if phase == "ended" then
			ui.root.Visible = false
			phase = "idle"
		end
	end)
	stopCamera()
	freezeCharacter(false)
	Store.inPitch = false
end

-- Server events -------------------------------------------------------------------

local function onStart(data)
	session = data
	revealedDislikes = {}
	Store.inPitch = true
	local rarity = Config.getRarity(data.customer.rarity)
	ui.name.Text = data.customer.name
	ui.name.TextColor3 = rarity.color
	ui.zone.Text = string.format('<font color="#%s">%s x%s</font>  ·  %s  ·  %s', rarity.color:ToHex(), string.upper(rarity.name), Format.short(rarity.mult), data.customer.personality, data.customer.zone)
	ui.estimate.Text = "Sale value: ~" .. Format.cash(data.estimate) .. " (more with certainty)"
	renderTags()
	renderMeters()
	renderOptions()
	say('"' .. data.customer.greeting .. '"', Colors.text)
	openUI()
	setPhase("choose")
	signal:Fire("start")
	startCamera(data.model)
	playDing(0.8)
end

local function onUpdate(data)
	if not session then
		return
	end
	session.meters = data.meters
	session.patience = data.patience
	session.options = data.options
	session.closeChance = data.closeChance
	renderMeters(data.deltas)
	renderOptions()
	if data.napkin then
		say('"' .. data.reaction .. '"', Colors.gold)
		playDing(1.5)
	elseif data.reaction then
		say('"' .. data.reaction .. '"', (data.closeFailed or data.disliked) and Colors.red or Colors.text)
	end
	setPhase("choose")
end

-- Cash or recruit ----------------------------------------------------------------

local deal -- the open offer, if any

local function celebrate()
	confetti()
	playDing(1)
	task.delay(0.15, playDing, 1.25)
	task.delay(0.3, playDing, 1.5)
end

local function closeDeal()
	deal = nil
	ui.deal.Visible = false
end

function PitchUI.chooseDeal(choice)
	if not deal then
		return
	end
	if choice == "recruit" and not deal.canRecruit then
		return
	end
	Remotes.Deal:FireServer(choice)
	closeDeal()
end

local function buildDeal()
	ui.deal = Theme.create("Frame", {
		Name = "Deal",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.55),
		Size = UDim2.new(0.92, 0, 0, 300),
		BackgroundColor3 = Colors.bg,
		Visible = false,
		ZIndex = 25,
		Parent = screen,
	}, {
		Theme.corner(18),
		Theme.create("UISizeConstraint", { MaxSize = Vector2.new(620, 300) }),
		Theme.padding(16),
	})
	ui.dealStroke = Theme.stroke(Colors.gold, 3)
	ui.dealStroke.Parent = ui.deal
	ui.dealTitle = Theme.label({
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.FontBlack,
		Text = "DEAL CLOSED!",
		TextColor3 = Colors.gold,
		Parent = ui.deal,
	})
	ui.dealWho = Theme.label({
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 0, 44),
		Font = Theme.FontBold,
		RichText = true,
		TextScaled = true,
		Parent = ui.deal,
	})
	ui.dealCash = Theme.button({
		Position = UDim2.new(0, 0, 0, 92),
		Size = UDim2.new(0.5, -8, 0, 120),
		BackgroundColor3 = Color3.fromRGB(35, 130, 70),
		Font = Theme.FontBlack,
		Parent = ui.deal,
	}, function()
		PitchUI.chooseDeal("cash")
	end)
	Theme.corner(14).Parent = ui.dealCash
	ui.dealRecruit = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 92),
		Size = UDim2.new(0.5, -8, 0, 120),
		BackgroundColor3 = Color3.fromRGB(110, 60, 200),
		Font = Theme.FontBlack,
		Parent = ui.deal,
	}, function()
		PitchUI.chooseDeal("recruit")
	end)
	Theme.corner(14).Parent = ui.dealRecruit
	ui.dealNote = Theme.label({
		Position = UDim2.new(0, 0, 0, 220),
		Size = UDim2.new(1, 0, 0, 20),
		Font = Theme.Font,
		TextColor3 = Colors.muted,
		Parent = ui.deal,
	})
	local track = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 8),
		BackgroundColor3 = Colors.panelLight,
		Parent = ui.deal,
	}, { Theme.corner(4) })
	ui.dealTimer = Theme.create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.gold,
		Parent = track,
	}, { Theme.corner(4) })
end

local function openDeal(data)
	local visitor = Visitors.byId[data.visitorId]
	local rarity = Config.getRarity(visitor.rarity)
	deal = data
	ui.deal.Visible = true
	ui.dealStroke.Color = rarity.color
	ui.dealTitle.Text = data.perfect and "PERFECT CLOSE!" or (data.napkin and "SUPPLY & DEMAND!" or "DEAL CLOSED!")
	ui.dealWho.Text = string.format(
		'<font color="#%s">%s</font>  %s%s',
		rarity.color:ToHex(),
		string.upper(rarity.name),
		visitor.name,
		data.isNew and '  <font color="#FFC846">NEW IN INDEX!</font>' or ""
	)
	ui.dealCash.Text = "TAKE THE CASH\n+" .. Format.cash(data.amount) .. "\n[1]"
	if data.canRecruit then
		ui.dealRecruit.Text = "RECRUIT\n+" .. Format.cash(data.daily) .. "/day\n[2]"
		ui.dealRecruit.BackgroundColor3 = Color3.fromRGB(110, 60, 200)
	else
		ui.dealRecruit.Text = "FIRM FULL\nall brokers are better"
		ui.dealRecruit.BackgroundColor3 = Colors.panelLight
	end
	local replaced = data.replaces and Visitors.byId[data.replaces]
	if replaced and data.canRecruit then
		ui.dealNote.Text = "Recruiting replaces your weakest broker: " .. replaced.name
	else
		ui.dealNote.Text = string.format("Brokers: %d/%d  ·  no choice in %ds = cash", data.brokerCount, Config.MaxBrokers, data.timeout)
	end
	Theme.pop(ui.deal, 0.35)
	ui.dealTimer.Size = UDim2.fromScale(1, 1)
	Theme.tween(ui.dealTimer, data.timeout, { Size = UDim2.fromScale(0, 1) }, Enum.EasingStyle.Linear)
	task.delay(data.timeout + 0.5, function()
		if deal == data then
			closeDeal()
		end
	end)
	celebrate()
end

local function onEnd(data)
	-- These arrive after the pitch screen is gone.
	if data.result == "sold" or data.result == "recruited" then
		signal:Fire("done", data.result)
	end
	if data.result == "sold" then
		closeDeal()
		showStamp("SOLD!", Colors.gold, "+" .. Format.cash(data.amount), Colors.money, nil)
		playDing(1.5)
		return
	elseif data.result == "recruited" then
		closeDeal()
		local visitor = Visitors.byId[data.visitorId]
		showStamp("RECRUITED!", Colors.purple, visitor and visitor.name or "", Colors.text, "Welcome to the firm.")
		playDing(1.2)
		return
	end
	if not session then
		return
	end
	if data.result == "deal" then
		signal:Fire("deal")
		openDeal(data)
	else
		signal:Fire("failed", data.result)
	end
	if data.result == "busted" then
		showStamp("BUSTED!", Colors.red, Format.cash(data.amount), Colors.red, data.line)
	elseif data.result == "walked" then
		showStamp("NO SALE", Colors.red, "", nil, data.line and ('"' .. data.line .. '"'))
	end
	session = nil
	closeUI()
end

function PitchUI.mount(screenGui)
	screen = screenGui
	build()
	buildDeal()

	Remotes.PitchStart.OnClientEvent:Connect(onStart)
	Remotes.PitchUpdate.OnClientEvent:Connect(function(data)
		-- Reveal which hated tag we just hit.
		if data.disliked and session and chosenIndex and session.options[chosenIndex] then
			revealedDislikes[session.options[chosenIndex].tag] = true
			renderTags()
		end
		onUpdate(data)
	end)
	Remotes.PitchEnd.OnClientEvent:Connect(onEnd)

	RunService.RenderStepped:Connect(function(dt)
		if phase ~= "tonality" then
			return
		end
		needle.pos += needle.dir * needle.speed * dt
		if needle.pos > 1 then
			needle.pos = 1
			needle.dir = -1
		elseif needle.pos < 0 then
			needle.pos = 0
			needle.dir = 1
		end
		ui.needle.Position = UDim2.fromScale(needle.pos, 0.5)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if deal and not processed then
			if input.KeyCode == Enum.KeyCode.One then
				PitchUI.chooseDeal("cash")
			elseif input.KeyCode == Enum.KeyCode.Two then
				PitchUI.chooseDeal("recruit")
			end
			return
		end
		if phase == "idle" or phase == "ended" then
			return
		end
		local key = input.KeyCode
		if phase == "tonality" and (key == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.MouseButton1 or key == Enum.KeyCode.ButtonA) then
			PitchUI.stopNeedle()
			return
		end
		if processed then
			return
		end
		if key == Enum.KeyCode.One then
			PitchUI.choose(1)
		elseif key == Enum.KeyCode.Two then
			PitchUI.choose(2)
		elseif key == Enum.KeyCode.Three then
			PitchUI.choose(3)
		elseif key == Enum.KeyCode.C then
			PitchUI.close()
		elseif key == Enum.KeyCode.X then
			PitchUI.leave()
		end
	end)
end

return PitchUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- The shop (pens, suits, phones) and the rebirth screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Animations = require(ReplicatedStorage.Shared.Animations)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Notifier = require(script.Parent.Notifier)
local Store = require(script.Parent.Parent.Store)

local Remotes = ReplicatedStorage.Remotes
local Colors = Theme.Colors

local Shop = {}

local TABS = {
	{ id = "pen", name = "Pens", color = Colors.pen },
	{ id = "suit", name = "Suits", color = Colors.you },
	{ id = "phone", name = "Phones", color = Colors.money },
}

local shopModal, ipoModal
local list
local currentTab = "pen"
local tabButtons = {}

local function buy(category, id)
	local ok, message = Remotes.Purchase:InvokeServer(category, id)
	Notifier.show(message, ok and "success" or "error")
end

-- Returns rows: { title, detail, cost, state = "owned"|"buy"|"locked", action }
local function rowsFor(tab, profile)
	local rows = {}
	if tab == "pen" or tab == "suit" or tab == "phone" then
		local items = tab == "pen" and Config.Pens or (tab == "suit" and Config.Suits or Config.Phones)
		local _, ownedIndex = Config.findById(items, profile[tab])
		for index, item in items do
			local detail
			if tab == "pen" then
				detail = string.format("Base sale %s  ·  %s", Format.cash(item.value), item.blurb)
			elseif tab == "suit" then
				detail = string.format("+%.1f certainty  ·  %d%% sweet spot  ·  x%.2f cash  ·  %s walk", item.startBonus, item.sweetSpot * 100, item.cashMult, Animations.BySuit[item.id] or "?")
			else
				detail = item.income > 0 and string.format("Cold calls earn %s/s while you play (and half offline)", Format.cash(item.income)) or "Silence."
			end
			local state = index <= (ownedIndex or 0) and "owned" or "buy"
			table.insert(rows, {
				title = item.name,
				detail = detail,
				cost = item.cost,
				state = state,
				color = item.color,
				action = function()
					buy(tab, item.id)
				end,
			})
		end
	end
	return rows
end

local lastSignature

local function render(force)
	local profile = Store.profile()
	if not profile or not list then
		return
	end
	local rows = rowsFor(currentTab, profile)
	-- Passive income syncs every second; only rebuild when something visible changed.
	local signature = currentTab
	for _, row in rows do
		signature ..= "|" .. row.title .. row.state .. tostring(profile.cash >= row.cost)
	end
	if signature == lastSignature and force ~= true then
		return
	end
	lastSignature = signature

	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for id, button in tabButtons do
		button.BackgroundColor3 = id == currentTab and Colors.panelLight or Colors.panel
	end

	for order, row in rows do
		local affordable = profile.cash >= row.cost
		local frame = Theme.create("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -8, 0, 64),
			BackgroundColor3 = Colors.panel,
			Parent = list,
		}, {
			Theme.corner(10),
			Theme.stroke(row.state == "owned" and Colors.money or Colors.stroke, 1),
		})
		if row.color then
			Theme.create("Frame", {
				Position = UDim2.fromOffset(10, 12),
				Size = UDim2.fromOffset(40, 40),
				BackgroundColor3 = row.color,
				Parent = frame,
			}, { Theme.corner(20), Theme.stroke(Color3.new(1, 1, 1), 1, 0.6) })
		end
		local textX = row.color and 60 or 14
		Theme.label({
			Position = UDim2.fromOffset(textX, 6),
			Size = UDim2.new(1, -textX - 150, 0, 26),
			Font = Theme.FontBlack,
			Text = row.title,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		Theme.label({
			Position = UDim2.fromOffset(textX, 34),
			Size = UDim2.new(1, -textX - 150, 0, 22),
			Font = Theme.Font,
			Text = row.detail,
			TextColor3 = Colors.muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})

		local buttonText, buttonColor
		if row.state == "owned" then
			buttonText, buttonColor = "OWNED", Colors.panelLight
		elseif row.state == "locked" then
			buttonText, buttonColor = "LOCKED", Colors.panelLight
		else
			buttonText = (row.buyText or "BUY") .. "\n" .. (row.cost == 0 and "FREE" or Format.cash(row.cost))
			buttonColor = affordable and Color3.fromRGB(40, 150, 80) or Color3.fromRGB(90, 45, 45)
		end
		local button = Theme.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(130, 48),
			BackgroundColor3 = buttonColor,
			Font = Theme.FontBlack,
			Text = buttonText,
			Parent = frame,
		}, function()
			if row.state == "buy" then
				row.action()
			end
		end)
		Theme.corner(10).Parent = button
	end
end

local function buildShop(screen)
	shopModal = Modal.new(screen, "PEN STREET SUPPLY CO.", Colors.money, Vector2.new(720, 500))
	shopModal.key = "shop"
	local content = shopModal.content

	local tabs = Theme.create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		Theme.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
		}),
	})
	for _, tab in TABS do
		local button = Theme.button({
			Size = UDim2.new(1 / #TABS, -7, 1, 0),
			BackgroundColor3 = Colors.panel,
			Font = Theme.FontBlack,
			Text = tab.name,
			TextColor3 = tab.color,
			Parent = tabs,
		}, function()
			currentTab = tab.id
			render(true)
		end)
		Theme.corner(10).Parent = button
		tabButtons[tab.id] = button
	end

	list = Theme.create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Colors.stroke,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, {
		Theme.create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	shopModal.onOpen = function()
		render(true)
	end
end

local ipoInfo, ipoButton
local function renderIPO()
	local data = Store.data
	if not data or not ipoInfo then
		return
	end
	local profile = data.profile
	local hasCash = profile.cash >= data.rebirthCost
	local nextZone
	for _, zone in Config.Zones do
		if zone.rebirths == profile.ipos + 1 then
			nextZone = zone
		end
	end
	ipoInfo.Text = string.format(
		"Take Stratton Oakpen public (rebirth %d).\n\nYou LOSE: cash, pen, suit and phone.\nYou KEEP: your brokers, your Index and a permanent x%.1f multiplier (now x%.1f).%s\n\n%s  Have %s cash (you have %s)",
		profile.ipos + 1,
		data.nextIpoMult,
		data.ipoMult,
		nextZone and ("\nUNLOCKS: " .. nextZone.name .. "!") or "",
		hasCash and "[OK]" or "[  ]",
		Format.cash(data.rebirthCost),
		Format.cash(profile.cash)
	)
	ipoButton.BackgroundColor3 = hasCash and Color3.fromRGB(140, 70, 220) or Colors.panelLight
end

local function buildIPO(screen)
	ipoModal = Modal.new(screen, "REBIRTH: RING THE BELL", Colors.purple, Vector2.new(560, 420))
	ipoModal.key = "rebirth"
	ipoInfo = Theme.label({
		Size = UDim2.new(1, 0, 1, -80),
		Font = Theme.FontBold,
		TextScaled = false,
		TextSize = 19,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = ipoModal.content,
	})
	ipoButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(0.7, 0, 0, 60),
		Font = Theme.FontBlack,
		Text = "REBIRTH",
		Parent = ipoModal.content,
	}, function()
		local ok, message = Remotes.IPO:InvokeServer()
		Notifier.show(message, ok and "big" or "error")
		if ok then
			ipoModal:close()
		end
	end)
	Theme.corner(12).Parent = ipoButton
	ipoModal.onOpen = renderIPO
end

function Shop.mount(screen)
	buildShop(screen)
	buildIPO(screen)
	Store.Changed:Connect(function()
		if shopModal.frame.Visible then
			render()
		end
		if ipoModal.frame.Visible then
			renderIPO()
		end
	end)
end

function Shop.toggleShop(tab)
	if tab then
		currentTab = tab
	end
	shopModal:toggle()
end

function Shop.openIPO()
	ipoModal:toggle()
end


return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Colors, fonts and tiny helpers for building UI in code.

local TweenService = game:GetService("TweenService")

local Theme = {}

-- Bright, chunky "simulator" style: saturated gradients, thick black
-- outlines and a cartoon font with outlined text.
Theme.Colors = {
	bg = Color3.fromRGB(28, 36, 78),
	panel = Color3.fromRGB(42, 54, 110),
	panelLight = Color3.fromRGB(62, 78, 150),
	stroke = Color3.fromRGB(15, 15, 25),
	text = Color3.fromRGB(255, 255, 255),
	muted = Color3.fromRGB(185, 200, 240),
	money = Color3.fromRGB(110, 255, 120),
	gold = Color3.fromRGB(255, 210, 60),
	red = Color3.fromRGB(255, 70, 70),
	blue = Color3.fromRGB(70, 180, 255),
	purple = Color3.fromRGB(200, 110, 255),
	pen = Color3.fromRGB(110, 190, 255),
	you = Color3.fromRGB(255, 170, 70),
	firm = Color3.fromRGB(190, 130, 255),
}

Theme.TagColors = {
	rapport = Color3.fromRGB(255, 150, 180),
	question = Color3.fromRGB(110, 200, 255),
	product = Color3.fromRGB(120, 230, 150),
	urgency = Color3.fromRGB(255, 170, 60),
	authority = Color3.fromRGB(190, 140, 255),
	hype = Color3.fromRGB(255, 90, 200),
	pressure = Color3.fromRGB(255, 80, 80),
	honest = Color3.fromRGB(220, 220, 220),
	napkin = Color3.fromRGB(255, 215, 60),
}

Theme.Font = Enum.Font.FredokaOne
Theme.FontBold = Enum.Font.FredokaOne
Theme.FontBlack = Enum.Font.LuckiestGuy
Theme.FontMono = Enum.Font.Code

-- Gradients for the big buttons, top to bottom.
Theme.Gradients = {
	orange = { Color3.fromRGB(255, 200, 60), Color3.fromRGB(255, 110, 20) },
	green = { Color3.fromRGB(120, 240, 90), Color3.fromRGB(30, 160, 60) },
	red = { Color3.fromRGB(255, 110, 90), Color3.fromRGB(200, 30, 50) },
	purple = { Color3.fromRGB(230, 120, 255), Color3.fromRGB(130, 40, 220) },
	blue = { Color3.fromRGB(110, 210, 255), Color3.fromRGB(30, 110, 230) },
	gold = { Color3.fromRGB(255, 240, 120), Color3.fromRGB(240, 160, 20) },
	gray = { Color3.fromRGB(215, 220, 235), Color3.fromRGB(140, 150, 175) },
	navy = { Color3.fromRGB(60, 80, 170), Color3.fromRGB(25, 32, 80) },
}

-- Rainbow used on the rarest things.
Theme.Rainbow = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 70, 70)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 50)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(90, 255, 110)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(70, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 90, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 70, 200)),
})

-- create("Frame", { Size = ..., Parent = ... }, { children })
function Theme.create(className, props, children)
	local instance = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.corner(radius)
	return Theme.create("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.create("UIStroke", {
		Color = color or Theme.Colors.stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.padding(all)
	local p = UDim.new(0, all)
	return Theme.create("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function Theme.gradient(a, b, rotation)
	return Theme.create("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
	})
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.FontBold,
		TextColor3 = Theme.Colors.text,
		TextScaled = true,
		Text = "",
	}
	for key, value in props do
		defaults[key] = value
	end
	local children = defaults.Children
	local outline = defaults.Outline
	defaults.Children = nil
	defaults.Outline = nil
	local label = Theme.create("TextLabel", defaults, children)
	Theme.outline(label, outline)
	return label
end

-- Black text outline (the chunky cartoon look). Pass false to skip, or a thickness.
function Theme.outline(textObject, thickness)
	if thickness == false then
		return
	end
	Theme.create("UIStroke", {
		ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual,
		Color = Color3.fromRGB(10, 10, 20),
		Thickness = type(thickness) == "number" and thickness or 2,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = textObject,
	})
end

-- A vertical gradient fill from Theme.Gradients (or two colors).
function Theme.fill(parent, gradient, rotation)
	local colors = type(gradient) == "string" and Theme.Gradients[gradient] or gradient
	return Theme.create("UIGradient", {
		Color = ColorSequence.new(colors[1], colors[2]),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function Theme.button(props, onClick)
	local defaults = {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.panelLight,
		Font = Theme.FontBold,
		TextColor3 = Theme.Colors.text,
		TextScaled = true,
		Text = "",
	}
	for key, value in props do
		defaults[key] = value
	end
	local children = defaults.Children
	local outline = defaults.Outline
	defaults.Children = nil
	defaults.Outline = nil
	local button = Theme.create("TextButton", defaults, children)
	-- Buttons usually get a border UIStroke too, so outline the text the classic way.
	if outline ~= false then
		button.TextStrokeTransparency = 0
		button.TextStrokeColor3 = Color3.fromRGB(10, 10, 20)
	end
	local scale = Theme.create("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.06, { Scale = 0.95 })
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1.05 })
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function Theme.tween(instance, duration, goal, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

-- Pop in from small.
function Theme.pop(instance, duration)
	local scale = instance:FindFirstChildOfClass("UIScale") or Theme.create("UIScale", { Parent = instance })
	scale.Scale = 0.6
	Theme.tween(scale, duration or 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

return Theme
]]></string>
            </Properties>
          </Item>
