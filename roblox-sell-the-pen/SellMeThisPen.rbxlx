		ZIndex = 4,
		Parent = ui.tonality,
	})
	tonalityClick.Activated:Connect(function()
		PitchUI.stopNeedle()
	end)

	-- Actions (right side).
	local actions = Theme.create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 176, 1, 0),
		BackgroundTransparency = 1,
		Parent = bottom,
	})
	ui.close = Theme.button({
		Size = UDim2.new(1, 0, 0, 150),
		BackgroundColor3 = Color3.fromRGB(210, 160, 40),
		Font = Theme.FontBlack,
		Text = "CLOSE",
		TextColor3 = Color3.fromRGB(30, 20, 5),
		Parent = actions,
	}, function()
		PitchUI.close()
	end)
	Theme.corner(16).Parent = ui.close
	Theme.stroke(Color3.fromRGB(255, 230, 140), 3).Parent = ui.close
	Theme.gradient(Color3.fromRGB(255, 215, 90), Color3.fromRGB(200, 140, 30)).Parent = ui.close
	ui.leave = Theme.button({
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 44),
		BackgroundColor3 = Colors.panel,
		Font = Theme.FontBold,
		Text = "Walk away [X]",
		TextColor3 = Colors.muted,
		Parent = actions,
	}, function()
		PitchUI.leave()
	end)
	Theme.corner(10).Parent = ui.leave

	-- Result stamp.
	ui.stamp = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromOffset(520, 220),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
		Parent = screen,
	})
	ui.stampTitle = Theme.label({
		Size = UDim2.new(1, 0, 0.55, 0),
		Font = Theme.FontBlack,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		Rotation = -6,
		ZIndex = 30,
		Parent = ui.stamp,
	})
	ui.stampAmount = Theme.label({
		Position = UDim2.fromScale(0, 0.55),
		Size = UDim2.new(1, 0, 0.3, 0),
		Font = Theme.FontBlack,
		TextStrokeTransparency = 0.2,
		ZIndex = 30,
		Parent = ui.stamp,
	})
	ui.stampLine = Theme.label({
		Position = UDim2.fromScale(0, 0.86),
		Size = UDim2.new(1, 0, 0.14, 0),
		Font = Theme.FontBold,
		TextStrokeTransparency = 0.3,
		ZIndex = 30,
		Parent = ui.stamp,
	})
end

-- Rendering ------------------------------------------------------------------

local function tagName(tag)
	return session and session.tags and session.tags[tag] or tag
end

local function renderTags()
	local likes = {}
	for _, tag in session.customer.likes do
		table.insert(likes, string.format('<font color="#%s">%s</font>', Theme.TagColors[tag]:ToHex(), tagName(tag)))
	end
	ui.likes.Text = "Likes: " .. (#likes > 0 and table.concat(likes, ", ") or "anything")
	local hates = {}
	for _, tag in session.customer.dislikes do
		if revealedDislikes[tag] then
			table.insert(hates, string.format('<font color="#%s">%s</font>', Theme.TagColors[tag]:ToHex(), tagName(tag)))
		else
			table.insert(hates, '<font color="#777777">???</font>')
		end
	end
	ui.hates.Text = "Hates: " .. (#hates > 0 and table.concat(hates, ", ") or "nothing")
end

local function renderMeters(deltas)
	for _, info in METERS do
		local meter = ui.meters[info.key]
		local value = session.meters[info.key]
		Theme.tween(meter.fill, 0.45, { Size = UDim2.fromScale(value / 10, 1) }, Enum.EasingStyle.Back)
		meter.value.Text = (value % 1 == 0) and string.format("%d", value) or string.format("%.1f", value)
		if deltas and deltas[info.key] then
			deltaPopup(meter, deltas[info.key])
		end
	end
	for _, child in ui.patience:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for i = 1, session.maxPatience do
		Theme.create("Frame", {
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = i <= session.patience and Colors.gold or Colors.panelLight,
			Parent = ui.patience,
		}, { Theme.corner(8) })
	end
	local chance = math.floor(session.closeChance * 100 + 0.5)
	ui.close.Text = string.format("CLOSE\n%d%%", chance)
end

local function renderOptions()
	for _, child in ui.options:GetChildren() do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	if #session.options == 0 then
		local note = Theme.button({
			Size = UDim2.new(1, 0, 0, 70),
			BackgroundColor3 = Colors.panel,
			Font = Theme.FontBlack,
			Text = "LAST CHANCE: Close now, or they walk!",
			TextColor3 = Colors.red,
			Parent = ui.options,
		})
		Theme.corner(12).Parent = note
		return
	end
	for index, option in session.options do
		local color = Theme.TagColors[option.tag] or Colors.text
		local button = Theme.button({
			LayoutOrder = index,
			Size = UDim2.new(1, 0, 0, 74),
			BackgroundColor3 = option.napkin and Color3.fromRGB(70, 55, 10) or Colors.panel,
			BackgroundTransparency = 0.05,
			Parent = ui.options,
		}, function()
			PitchUI.choose(index)
		end)
		Theme.corner(12).Parent = button
		Theme.stroke(color, option.napkin and 3 or 1.5).Parent = button
		Theme.label({
			Position = UDim2.fromOffset(12, 8),
			Size = UDim2.fromOffset(34, 58),
			Font = Theme.FontBlack,
			Text = tostring(index),
			TextColor3 = color,
			Parent = button,
		})
		Theme.label({
			Position = UDim2.fromOffset(54, 6),
			Size = UDim2.new(1, -66, 0, 18),
			Font = Theme.FontBlack,
			Text = string.upper(tagName(option.tag)),
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = button,
		})
		Theme.label({
			Position = UDim2.fromOffset(54, 26),
			Size = UDim2.new(1, -66, 0, 40),
			Font = Theme.FontBold,
			Text = '"' .. option.text .. '"',
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = button,
		})
	end
end

local function say(text, color)
	ui.speech.Text = text or ""
	ui.speech.TextColor3 = color or Colors.text
	Theme.pop(ui.speech, 0.25)
end

local function setPhase(newPhase)
	phase = newPhase
	ui.options.Visible = newPhase == "choose" or newPhase == "waiting"
	ui.tonality.Visible = newPhase == "tonality"
end

-- Actions ------------------------------------------------------------------------

function PitchUI.choose(index)
	if phase ~= "choose" or not session.options[index] then
		return
	end
	chosenIndex = index
	playDing(1.2)
	needle.pos = math.random()
	needle.dir = math.random() < 0.5 and -1 or 1
	needle.center = 0.2 + math.random() * 0.6
	needle.speed = 1.1 + (session.customer.budget or 1) * 0.04 + math.random() * 0.3
	ui.sweet.Position = UDim2.fromScale(needle.center, 0)
	ui.sweet.Size = UDim2.fromScale(session.sweetSpot, 1)
	ui.tonalityHint.Text = '"' .. session.options[index].text .. '"'
	setPhase("tonality")
end

function PitchUI.stopNeedle()
	if phase ~= "tonality" then
		return
	end
	local distance = math.abs(needle.pos - needle.center)
	local half = session.sweetSpot / 2
	local accuracy
	if distance <= half then
		accuracy = 1 - 0.2 * (distance / half)
	else
		accuracy = math.max(0, 0.8 - (distance - half) * 2.4)
	end
	local verdict
	if accuracy >= 0.95 then
		verdict = "PERFECT TONALITY!"
	elseif accuracy >= 0.8 then
		verdict = "Smooth."
	elseif accuracy >= 0.4 then
		verdict = "A bit shaky..."
	else
		verdict = "You mumbled it."
	end
	say(verdict, accuracy >= 0.8 and Colors.money or Colors.red)
	setPhase("waiting")
	Remotes.PitchAction:FireServer({ type = "line", index = chosenIndex, tonality = accuracy })
end

function PitchUI.close()
	if phase ~= "choose" then
		return
	end
	setPhase("waiting")
	say("...", Colors.muted)
	Remotes.PitchAction:FireServer({ type = "close" })
end

function PitchUI.leave()
	if phase == "idle" or phase == "ended" then
		return
	end
	Remotes.PitchAction:FireServer({ type = "leave" })
end

local function showStamp(title, titleColor, amount, amountColor, line)
	ui.stamp.Visible = true
	ui.stampTitle.Text = title
	ui.stampTitle.TextColor3 = titleColor
	ui.stampAmount.Text = amount or ""
	ui.stampAmount.TextColor3 = amountColor or Colors.money
	ui.stampLine.Text = line or ""
	ui.stampTitle.TextTransparency = 0
	ui.stampAmount.TextTransparency = 0
	ui.stampLine.TextTransparency = 0
	local scale = ui.stamp:FindFirstChildOfClass("UIScale") or Theme.create("UIScale", { Parent = ui.stamp })
	scale.Scale = 2.2
	Theme.tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.6, function()
		Theme.tween(ui.stampTitle, 0.4, { TextTransparency = 1 })
		Theme.tween(ui.stampAmount, 0.4, { TextTransparency = 1 })
		Theme.tween(ui.stampLine, 0.4, { TextTransparency = 1 })
		task.wait(0.45)
		ui.stamp.Visible = false
	end)
end

local function confetti()
	for _ = 1, 40 do
		local piece = Theme.create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, math.random(-40, 40), 0.42, 0),
			Size = UDim2.fromOffset(math.random(8, 14), math.random(14, 24)),
			BackgroundColor3 = ({ Colors.money, Colors.gold, Color3.new(1, 1, 1) })[math.random(1, 3)],
			BorderSizePixel = 0,
			Rotation = math.random(0, 360),
			ZIndex = 29,
			Parent = screen,
		})
		Theme.tween(piece, 1.6 + math.random(), {
			Position = UDim2.new(0.5 + (math.random() - 0.5) * 1.1, 0, 1.1, 0),
			Rotation = piece.Rotation + math.random(-400, 400),
		}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(2.8, function()
			piece:Destroy()
		end)
	end
end

-- Plant your feet while pitching (Space is needed for the tonality bar).
local frozen
local function freezeCharacter(freeze)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	if freeze and not frozen then
		frozen = { walk = humanoid.WalkSpeed, jump = humanoid.JumpPower, jumpHeight = humanoid.JumpHeight }
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
	elseif not freeze and frozen then
		humanoid.WalkSpeed = frozen.walk
		humanoid.JumpPower = frozen.jump
		humanoid.JumpHeight = frozen.jumpHeight
		frozen = nil
	end
end

local function openUI()
	Modal.closeAll()
	freezeCharacter(true)
	ui.root.Visible = true
	Theme.tween(ui.barTop, 0.4, { Size = UDim2.new(1, 0, 0, 54) })
	Theme.tween(ui.barBottom, 0.4, { Size = UDim2.new(1, 0, 0, 54) })
	Theme.pop(ui.bottom, 0.35)
end

local function closeUI()
	phase = "ended"
	Theme.tween(ui.barTop, 0.3, { Size = UDim2.new(1, 0, 0, 0) })
	Theme.tween(ui.barBottom, 0.3, { Size = UDim2.new(1, 0, 0, 0) })
	task.delay(0.3, function()
		if phase == "ended" then
			ui.root.Visible = false
			phase = "idle"
		end
	end)
	stopCamera()
	freezeCharacter(false)
	Store.inPitch = false
end

-- Server events -------------------------------------------------------------------

local function onStart(data)
	session = data
	revealedDislikes = {}
	Store.inPitch = true
	ui.name.Text = data.customer.name
	ui.zone.Text = data.customer.zone .. "  ·  selling: " .. data.pen
	ui.estimate.Text = "Sale value: ~" .. Format.cash(data.estimate) .. " (more with certainty)"
	renderTags()
	renderMeters()
	renderOptions()
	say('"' .. data.customer.greeting .. '"', Colors.text)
	openUI()
	setPhase("choose")
	startCamera(data.model)
	playDing(0.8)
end

local function onUpdate(data)
	if not session then
		return
	end
	session.meters = data.meters
	session.patience = data.patience
	session.options = data.options
	session.closeChance = data.closeChance
	renderMeters(data.deltas)
	renderOptions()
	if data.napkin then
		say('"' .. data.reaction .. '"', Colors.gold)
		playDing(1.5)
	elseif data.reaction then
		say('"' .. data.reaction .. '"', (data.closeFailed or data.disliked) and Colors.red or Colors.text)
	end
	setPhase("choose")
end

local function onEnd(data)
	if not session then
		return
	end
	if data.result == "sold" then
		local title = data.perfect and "PERFECT CLOSE!" or (data.napkin and "SUPPLY & DEMAND!" or "SOLD!")
		showStamp(title, Colors.gold, "+" .. Format.cash(data.amount), Colors.money, data.line and ('"' .. data.line .. '"'))
		confetti()
		playDing(1)
		task.delay(0.15, playDing, 1.25)
		task.delay(0.3, playDing, 1.5)
	elseif data.result == "busted" then
		showStamp("BUSTED!", Colors.red, Format.cash(data.amount), Colors.red, data.line)
	elseif data.result == "walked" then
		showStamp("NO SALE", Colors.red, "", nil, data.line and ('"' .. data.line .. '"'))
	end
	session = nil
	closeUI()
end

function PitchUI.mount(screenGui)
	screen = screenGui
	build()

	Remotes.PitchStart.OnClientEvent:Connect(onStart)
	Remotes.PitchUpdate.OnClientEvent:Connect(function(data)
		-- Reveal which hated tag we just hit.
		if data.disliked and session and chosenIndex and session.options[chosenIndex] then
			revealedDislikes[session.options[chosenIndex].tag] = true
			renderTags()
		end
		onUpdate(data)
	end)
	Remotes.PitchEnd.OnClientEvent:Connect(onEnd)

	RunService.RenderStepped:Connect(function(dt)
		if phase ~= "tonality" then
			return
		end
		needle.pos += needle.dir * needle.speed * dt
		if needle.pos > 1 then
			needle.pos = 1
			needle.dir = -1
		elseif needle.pos < 0 then
			needle.pos = 0
			needle.dir = 1
		end
		ui.needle.Position = UDim2.fromScale(needle.pos, 0.5)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if phase == "idle" or phase == "ended" then
			return
		end
		local key = input.KeyCode
		if phase == "tonality" and (key == Enum.KeyCode.Space or input.UserInputType == Enum.UserInputType.MouseButton1 or key == Enum.KeyCode.ButtonA) then
			PitchUI.stopNeedle()
			return
		end
		if processed then
			return
		end
		if key == Enum.KeyCode.One then
			PitchUI.choose(1)
		elseif key == Enum.KeyCode.Two then
			PitchUI.choose(2)
		elseif key == Enum.KeyCode.Three then
			PitchUI.choose(3)
		elseif key == Enum.KeyCode.C then
			PitchUI.close()
		elseif key == Enum.KeyCode.X then
			PitchUI.leave()
		end
	end)
end

return PitchUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- The shop (pens, suits, phones, brokers, zones), the IPO screen and the
-- how-to-play screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Notifier = require(script.Parent.Notifier)
local Store = require(script.Parent.Parent.Store)

local Remotes = ReplicatedStorage.Remotes
local Colors = Theme.Colors

local Shop = {}

local TABS = {
	{ id = "pen", name = "Pens", color = Colors.pen },
	{ id = "suit", name = "Suits", color = Colors.you },
	{ id = "phone", name = "Phones", color = Colors.money },
	{ id = "broker", name = "Brokers", color = Colors.firm },
	{ id = "zone", name = "Zones", color = Colors.gold },
}

local shopModal, ipoModal, helpModal
local list
local currentTab = "pen"
local tabButtons = {}

local function buy(category, id)
	local ok, message = Remotes.Purchase:InvokeServer(category, id)
	Notifier.show(message, ok and "success" or "error")
end

-- Returns rows: { title, detail, cost, state = "owned"|"buy"|"locked", action }
local function rowsFor(tab, profile)
	local rows = {}
	if tab == "pen" or tab == "suit" or tab == "phone" then
		local items = tab == "pen" and Config.Pens or (tab == "suit" and Config.Suits or Config.Phones)
		local _, ownedIndex = Config.findById(items, profile[tab])
		for index, item in items do
			local detail
			if tab == "pen" then
				detail = string.format("Base sale %s  ·  %s", Format.cash(item.value), item.blurb)
			elseif tab == "suit" then
				detail = string.format("+%.1f starting certainty  ·  %d%% sweet spot  ·  x%.2f cash", item.startBonus, item.sweetSpot * 100, item.cashMult)
			else
				detail = item.income > 0 and string.format("Cold calls earn %s/s while you play (and half offline)", Format.cash(item.income)) or "Silence."
			end
			local state = index <= (ownedIndex or 0) and "owned" or "buy"
			table.insert(rows, {
				title = item.name,
				detail = detail,
				cost = item.cost,
				state = state,
				color = item.color,
				action = function()
					buy(tab, item.id)
				end,
			})
		end
	elseif tab == "broker" then
		for _, broker in Config.Brokers do
			local owned = profile.brokers[broker.id] or 0
			table.insert(rows, {
				title = string.format("%s  (x%d)", broker.name, owned),
				detail = string.format("+%s/s each  ·  %s", Format.cash(broker.income), broker.blurb),
				cost = Config.brokerCost(broker, owned),
				state = "buy",
				buyText = "HIRE",
				action = function()
					buy("broker", broker.id)
				end,
			})
		end
	elseif tab == "zone" then
		for index, zone in Config.Zones do
			local previous = Config.Zones[index - 1]
			local state = profile.zones[zone.id] and "owned"
				or ((previous and not profile.zones[previous.id]) and "locked" or "buy")
			table.insert(rows, {
				title = zone.name,
				detail = string.format("%s  ·  customers pay x%.1f", zone.subtitle, zone.budgetMult),
				cost = zone.cost,
				state = state,
				buyText = "UNLOCK",
				action = function()
					buy("zone", zone.id)
				end,
			})
		end
	end
	return rows
end

local lastSignature

local function render(force)
	local profile = Store.profile()
	if not profile or not list then
		return
	end
	local rows = rowsFor(currentTab, profile)
	-- Passive income syncs every second; only rebuild when something visible changed.
	local signature = currentTab
	for _, row in rows do
		signature ..= "|" .. row.title .. row.state .. tostring(profile.cash >= row.cost)
	end
	if signature == lastSignature and force ~= true then
		return
	end
	lastSignature = signature

	for _, child in list:GetChildren() do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end
	for id, button in tabButtons do
		button.BackgroundColor3 = id == currentTab and Colors.panelLight or Colors.panel
	end

	for order, row in rows do
		local affordable = profile.cash >= row.cost
		local frame = Theme.create("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -8, 0, 64),
			BackgroundColor3 = Colors.panel,
			Parent = list,
		}, {
			Theme.corner(10),
			Theme.stroke(row.state == "owned" and Colors.money or Colors.stroke, 1),
		})
		if row.color then
			Theme.create("Frame", {
				Position = UDim2.fromOffset(10, 12),
				Size = UDim2.fromOffset(40, 40),
				BackgroundColor3 = row.color,
				Parent = frame,
			}, { Theme.corner(20), Theme.stroke(Color3.new(1, 1, 1), 1, 0.6) })
		end
		local textX = row.color and 60 or 14
		Theme.label({
			Position = UDim2.fromOffset(textX, 6),
			Size = UDim2.new(1, -textX - 150, 0, 26),
			Font = Theme.FontBlack,
			Text = row.title,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})
		Theme.label({
			Position = UDim2.fromOffset(textX, 34),
			Size = UDim2.new(1, -textX - 150, 0, 22),
			Font = Theme.Font,
			Text = row.detail,
			TextColor3 = Colors.muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = frame,
		})

		local buttonText, buttonColor
		if row.state == "owned" then
			buttonText, buttonColor = "OWNED", Colors.panelLight
		elseif row.state == "locked" then
			buttonText, buttonColor = "LOCKED", Colors.panelLight
		else
			buttonText = (row.buyText or "BUY") .. "\n" .. (row.cost == 0 and "FREE" or Format.cash(row.cost))
			buttonColor = affordable and Color3.fromRGB(40, 150, 80) or Color3.fromRGB(90, 45, 45)
		end
		local button = Theme.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(130, 48),
			BackgroundColor3 = buttonColor,
			Font = Theme.FontBlack,
			Text = buttonText,
			Parent = frame,
		}, function()
			if row.state == "buy" then
				row.action()
			end
		end)
		Theme.corner(10).Parent = button
	end
end

local function buildShop(screen)
	shopModal = Modal.new(screen, "PEN STREET SUPPLY CO.", Colors.money, Vector2.new(720, 500))
	local content = shopModal.content

	local tabs = Theme.create("Frame", {
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundTransparency = 1,
		Parent = content,
	}, {
		Theme.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			Padding = UDim.new(0, 8),
		}),
	})
	for _, tab in TABS do
		local button = Theme.button({
			Size = UDim2.new(1 / #TABS, -7, 1, 0),
			BackgroundColor3 = Colors.panel,
			Font = Theme.FontBlack,
			Text = tab.name,
			TextColor3 = tab.color,
			Parent = tabs,
		}, function()
			currentTab = tab.id
			render(true)
		end)
		Theme.corner(10).Parent = button
		tabButtons[tab.id] = button
	end

	list = Theme.create("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 50),
		Size = UDim2.new(1, 0, 1, -50),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Colors.stroke,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = content,
	}, {
		Theme.create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	shopModal.onOpen = function()
		render(true)
	end
end

local ipoInfo, ipoButton
local function renderIPO()
	local data = Store.data
	if not data or not ipoInfo then
		return
	end
	local profile = data.profile
	local hasYacht = profile.zones[Config.IPO.requiresZone] == true
	local hasCash = profile.cash >= Config.IPO.cashRequired
	ipoInfo.Text = string.format(
		"Take Stratton Oakpen public.\n\nYou LOSE: cash, pens, suits, phones, brokers and zones.\nYou KEEP: a permanent x%.1f multiplier on everything (now x%.1f).\n\n%s  Unlock the Yacht\n%s  Have %s cash (%s)",
		data.nextIpoMult,
		data.ipoMult,
		hasYacht and "[OK]" or "[  ]",
		hasCash and "[OK]" or "[  ]",
		Format.cash(Config.IPO.cashRequired),
		Format.cash(profile.cash)
	)
	ipoButton.BackgroundColor3 = (hasYacht and hasCash) and Color3.fromRGB(140, 70, 220) or Colors.panelLight
end

local function buildIPO(screen)
	ipoModal = Modal.new(screen, "RING THE BELL: IPO", Colors.purple, Vector2.new(560, 420))
	ipoInfo = Theme.label({
		Size = UDim2.new(1, 0, 1, -80),
		Font = Theme.FontBold,
		TextScaled = false,
		TextSize = 19,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Parent = ipoModal.content,
	})
	ipoButton = Theme.button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.new(0.7, 0, 0, 60),
		Font = Theme.FontBlack,
		Text = "GO PUBLIC",
		Parent = ipoModal.content,
	}, function()
		local ok, message = Remotes.IPO:InvokeServer()
		Notifier.show(message, ok and "big" or "error")
		if ok then
			ipoModal:close()
		end
	end)
	Theme.corner(12).Parent = ipoButton
	ipoModal.onOpen = renderIPO
end

local HELP_TEXT = [[<b><font color="#FFC846">1. Find a customer.</font></b> Walk up to anyone and press <b>E</b> to pitch.

<b><font color="#FFC846">2. Build certainty.</font></b> Every buyer needs to be sure about three things: the <font color="#6EBEFF">PEN</font>, <font color="#FFAA46">YOU</font> and your <font color="#BE82FF">FIRM</font>. Pick a line, then stop the tonality needle in the green zone. Better timing = bigger effect.

<b><font color="#FFC846">3. Read the room.</font></b> Customers like and hate certain kinds of lines. Hedge fund bros love pressure; duchesses do not. The Undercover FBI Agent only trusts honesty.

<b><font color="#FFC846">4. Close.</font></b> Hit CLOSE whenever you like. Higher certainty = better odds and a bigger sale. Max all three bars for a PERFECT CLOSE.

<b><font color="#FFC846">5. Grow.</font></b> Buy better pens and suits, hire brokers, unlock Pen Street, the Trading Floor and the Yacht. Then IPO for a permanent multiplier.

<b><font color="#FFC846">Secrets.</font></b> Sometimes a mysterious napkin line appears. Use it. Hum (H) with other players for a crowd boost. Be on the Trading Floor when the Wolf gives his speech.]]

local function buildHelp(screen)
	helpModal = Modal.new(screen, "HOW TO SELL A PEN", Colors.blue, Vector2.new(640, 520))
	local scroll = Theme.create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = helpModal.content,
	})
	Theme.label({
		Size = UDim2.new(1, -12, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Font = Theme.Font,
		TextScaled = false,
		TextSize = 18,
		TextWrapped = true,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = HELP_TEXT,
		Parent = scroll,
	})
end

function Shop.mount(screen)
	buildShop(screen)
	buildIPO(screen)
	buildHelp(screen)
	Store.Changed:Connect(function()
		if shopModal.frame.Visible then
			render()
		end
		if ipoModal.frame.Visible then
			renderIPO()
		end
	end)
end

function Shop.toggleShop(tab)
	if tab then
		currentTab = tab
	end
	shopModal:toggle()
end

function Shop.openIPO()
	ipoModal:toggle()
end

function Shop.openHelp()
	helpModal:toggle()
end

return Shop
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Colors, fonts and tiny helpers for building UI in code.

local TweenService = game:GetService("TweenService")

local Theme = {}

Theme.Colors = {
	bg = Color3.fromRGB(12, 16, 14),
	panel = Color3.fromRGB(20, 27, 24),
	panelLight = Color3.fromRGB(30, 40, 35),
	stroke = Color3.fromRGB(60, 80, 68),
	text = Color3.fromRGB(235, 240, 232),
	muted = Color3.fromRGB(150, 165, 155),
	money = Color3.fromRGB(90, 235, 130),
	gold = Color3.fromRGB(255, 200, 70),
	red = Color3.fromRGB(240, 70, 70),
	blue = Color3.fromRGB(90, 170, 255),
	purple = Color3.fromRGB(190, 120, 255),
	pen = Color3.fromRGB(110, 190, 255),
	you = Color3.fromRGB(255, 170, 70),
	firm = Color3.fromRGB(190, 130, 255),
}

Theme.TagColors = {
	rapport = Color3.fromRGB(255, 150, 180),
	question = Color3.fromRGB(110, 200, 255),
	product = Color3.fromRGB(120, 230, 150),
	urgency = Color3.fromRGB(255, 170, 60),
	authority = Color3.fromRGB(190, 140, 255),
	hype = Color3.fromRGB(255, 90, 200),
	pressure = Color3.fromRGB(255, 80, 80),
	honest = Color3.fromRGB(220, 220, 220),
	napkin = Color3.fromRGB(255, 215, 60),
}

Theme.Font = Enum.Font.GothamMedium
Theme.FontBold = Enum.Font.GothamBold
Theme.FontBlack = Enum.Font.GothamBlack
Theme.FontMono = Enum.Font.Code

-- create("Frame", { Size = ..., Parent = ... }, { children })
function Theme.create(className, props, children)
	local instance = Instance.new(className)
	local parent
	for key, value in props or {} do
		if key == "Parent" then
			parent = value
		else
			instance[key] = value
		end
	end
	for _, child in children or {} do
		child.Parent = instance
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function Theme.corner(radius)
	return Theme.create("UICorner", { CornerRadius = UDim.new(0, radius or 10) })
end

function Theme.stroke(color, thickness, transparency)
	return Theme.create("UIStroke", {
		Color = color or Theme.Colors.stroke,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function Theme.padding(all)
	local p = UDim.new(0, all)
	return Theme.create("UIPadding", { PaddingTop = p, PaddingBottom = p, PaddingLeft = p, PaddingRight = p })
end

function Theme.gradient(a, b, rotation)
	return Theme.create("UIGradient", {
		Color = ColorSequence.new(a, b),
		Rotation = rotation or 90,
	})
end

function Theme.label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Theme.FontBold,
		TextColor3 = Theme.Colors.text,
		TextScaled = true,
		Text = "",
	}
	for key, value in props do
		defaults[key] = value
	end
	local children = defaults.Children
	defaults.Children = nil
	return Theme.create("TextLabel", defaults, children)
end

function Theme.button(props, onClick)
	local defaults = {
		AutoButtonColor = false,
		BackgroundColor3 = Theme.Colors.panelLight,
		Font = Theme.FontBold,
		TextColor3 = Theme.Colors.text,
		TextScaled = true,
		Text = "",
	}
	for key, value in props do
		defaults[key] = value
	end
	local children = defaults.Children
	defaults.Children = nil
	local button = Theme.create("TextButton", defaults, children)
	local scale = Theme.create("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1.05 })
	end)
	button.MouseLeave:Connect(function()
		Theme.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		Theme.tween(scale, 0.06, { Scale = 0.95 })
	end)
	button.MouseButton1Up:Connect(function()
		Theme.tween(scale, 0.1, { Scale = 1.05 })
	end)
	if onClick then
		button.Activated:Connect(onClick)
	end
	return button
end

function Theme.tween(instance, duration, goal, style, direction)
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(duration, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

-- Pop in from small.
function Theme.pop(instance, duration)
	local scale = instance:FindFirstChildOfClass("UIScale") or Theme.create("UIScale", { Parent = instance })
	scale.Scale = 0.6
	Theme.tween(scale, duration or 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- Client-side world polish: gates that open for you once unlocked, the
-- customer prompt, zone title cards, stock tickers and speech confetti.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.UI.Theme)
local Hud = require(script.Parent.UI.Hud)
local Store = require(script.Parent.Store)

local Colors = Theme.Colors
local player = Players.LocalPlayer
local map = Workspace:WaitForChild("Map")

local World = {}

-- Gates ----------------------------------------------------------------------

local gateSigns = {}

local function signOn(gate, face)
	local gui = Theme.create("SurfaceGui", {
		Face = face,
		SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
		PixelsPerStud = 20,
		LightInfluence = 0,
		Brightness = 1.5,
		Parent = gate,
	})
	local label = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.8, 0.35),
		Font = Theme.FontBlack,
		TextColor3 = Colors.gold,
		TextStrokeTransparency = 0.2,
		Parent = gui,
	})
	return gui, label
end

local function setupGates()
	local gates = map:WaitForChild("Gates", 10)
	if not gates then
		return
	end
	for _, zone in Config.Zones do
		local gate = zone.gate and gates:WaitForChild(zone.gate, 10)
		if gate then
			local text = string.format("LOCKED\n%s\n%s", string.upper(zone.name), Format.cash(zone.cost))
			local signs = {}
			for _, face in { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right } do
				local gui, label = signOn(gate, face)
				label.Text = text
				table.insert(signs, gui)
			end
			gateSigns[zone.id] = { gate = gate, signs = signs, transparency = gate.Transparency }
		end
	end
end

local function refreshGates()
	local profile = Store.profile()
	if not profile then
		return
	end
	for zoneId, entry in gateSigns do
		local open = profile.zones[zoneId] == true
		entry.gate.CanCollide = not open
		entry.gate.Transparency = open and 1 or entry.transparency
		for _, sign in entry.signs do
			sign.Enabled = not open
		end
		local prompt = entry.gate:FindFirstChild("UnlockPrompt")
		if prompt then
			prompt.Enabled = not open
		end
	end
end

-- Customer prompt ------------------------------------------------------------------

local function promptGui(prompt)
	local profile = Store.profile()
	local zoneId = prompt:GetAttribute("Zone")
	local locked = profile and zoneId and not profile.zones[zoneId]
	local gui = Theme.create("BillboardGui", {
		Name = "PromptUI",
		Size = UDim2.fromOffset(230, 64),
		StudsOffset = Vector3.new(0, 3.2, 0),
		AlwaysOnTop = true,
		Adornee = prompt.Parent,
		Parent = player:WaitForChild("PlayerGui"),
	})
	local frame = Theme.create("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Colors.bg,
		BackgroundTransparency = 0.1,
		Parent = gui,
	}, { Theme.corner(14), Theme.stroke(locked and Colors.red or Colors.gold, 2) })
	local key = Theme.create("Frame", {
		Position = UDim2.fromOffset(8, 8),
		Size = UDim2.fromOffset(48, 48),
		BackgroundColor3 = locked and Colors.red or Colors.gold,
		Parent = frame,
	}, { Theme.corner(10) })
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FontBlack,
		Text = locked and "!" or "E",
		TextColor3 = Colors.bg,
		Parent = key,
	})
	Theme.label({
		Position = UDim2.fromOffset(64, 8),
		Size = UDim2.new(1, -72, 0, 26),
		Font = Theme.FontBlack,
		Text = locked and "ZONE LOCKED" or "SELL ME THIS PEN",
		TextColor3 = locked and Colors.red or Colors.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	Theme.label({
		Position = UDim2.fromOffset(64, 36),
		Size = UDim2.new(1, -72, 0, 18),
		Font = Theme.Font,
		Text = prompt.ObjectText,
		TextColor3 = Colors.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	Theme.pop(frame, 0.25)

	-- Tap to pitch on touch screens.
	local button = Theme.create("TextButton", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Text = "",
		Parent = frame,
	})
	gui.Active = true
	button.Activated:Connect(function()
		prompt:InputHoldBegin()
		task.wait()
		prompt:InputHoldEnd()
	end)
	return gui
end

local function setupPrompts()
	local shown = {}
	ProximityPromptService.PromptShown:Connect(function(prompt)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		if Store.inPitch then
			return
		end
		shown[prompt] = promptGui(prompt)
	end)
	ProximityPromptService.PromptHidden:Connect(function(prompt)
		local gui = shown[prompt]
		if gui then
			gui:Destroy()
			shown[prompt] = nil
		end
	end)
	-- Hide every prompt while a pitch is on screen.
	RunService.Heartbeat:Connect(function()
		if Store.inPitch then
			for prompt, gui in shown do
				gui:Destroy()
				shown[prompt] = nil
			end
		end
	end)
end

-- Zones --------------------------------------------------------------------------

local function zoneAt(position)
	for _, zone in Config.Zones do
		local a = zone.area
		if position.X >= a.minX - 8 and position.X <= a.maxX + 8 and position.Z >= a.minZ - 8 and position.Z <= a.maxZ + 8 and math.abs(position.Y - a.y) < 25 then
			return zone
		end
	end
	return nil
end

local function trackZones()
	local current
	while true do
		task.wait(0.5)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local zone = zoneAt(root.Position)
			if zone and zone ~= current then
				Hud.zoneCard(zone)
			end
			if zone then
				current = zone
			end
		end
	end
end

-- Tickers ------------------------------------------------------------------------

local SYMBOLS = { "PEN", "INK", "BIC", "NIB", "QUIL", "GEL", "CLIK", "CAP", "STRT", "OAK", "WOLF", "NAPK" }

local function tickerText()
	local parts = {}
	for _, symbol in SYMBOLS do
		local change = (math.random() - 0.35) * 12
		local color = change >= 0 and "#5AEB82" or "#F04646"
		table.insert(parts, string.format('<font color="#FFFFFF">%s</font> <font color="%s">%s%.2f%%</font>', symbol, color, change >= 0 and "▲" or "▼", math.abs(change)))
	end
	return table.concat(parts, "     ")
end

local function setupTickers()
	local tickers = {}
	for _, part in map:GetDescendants() do
		if part:IsA("BasePart") and part.Name == "TickerBoard" then
			local gui = Theme.create("SurfaceGui", {
				Face = Enum.NormalId.Front,
				SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud,
				PixelsPerStud = 24,
				LightInfluence = 0,
				Brightness = 2,
				ClipsDescendants = true,
				Parent = part,
			})
			Theme.create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Parent = gui })
			local label = Theme.label({
				Size = UDim2.new(4, 0, 1, 0),
				Font = Theme.FontMono,
				RichText = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				Text = tickerText(),
				Parent = gui,
			})
			table.insert(tickers, { label = label, offset = math.random() })
		end
	end
	RunService.RenderStepped:Connect(function(dt)
		for _, ticker in tickers do
			ticker.offset += dt * 0.025
			if ticker.offset >= 1 then
				ticker.offset = 0
				ticker.label.Text = tickerText()
			end
			ticker.label.Position = UDim2.fromScale(1 - ticker.offset * 5, 0)
		end
	end)
end

-- Speech confetti ------------------------------------------------------------------

local function setupSpeech()
	local function apply()
		local active = Workspace:GetAttribute("SpeechActive") == true
		for _, emitter in map:GetDescendants() do
			if emitter:IsA("ParticleEmitter") and emitter.Name == "Confetti" then
				emitter.Enabled = active
			end
		end
		if active then
			local line = Workspace:GetAttribute("SpeechLine")
			if line then
				Hud.zoneCard({ name = "THE WOLF SPEAKS", subtitle = '"' .. line .. '"' })
			end
		end
	end
	Workspace:GetAttributeChangedSignal("SpeechActive"):Connect(apply)
	apply()
end

function World.start()
	task.spawn(function()
		setupGates()
		refreshGates()
	end)
	Store.Changed:Connect(refreshGates)
	setupPrompts()
	setupTickers()
	setupSpeech()
	task.spawn(trackZones)
end

return World
