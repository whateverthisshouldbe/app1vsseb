      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Every tunable number in the game lives here. The map generator
-- (tools/build_map.py) uses the same zone rectangles, so keep them in sync.

local Config = {}

Config.StartingCash = 50
Config.AutosaveInterval = 90
Config.OfflineEarningsRate = 0.5 -- fraction of passive income paid while offline
Config.OfflineEarningsCap = 3 * 60 * 60 -- seconds
Config.DailyBonusCooldown = 20 * 60 * 60

-- Pens: the thing you sell. Owning a better pen raises every sale.
Config.Pens = {
	{ id = "bic", name = "Bic Stick", cost = 0, value = 15, color = Color3.fromRGB(40, 90, 200), blurb = "It's a pen. It... writes." },
	{ id = "click", name = "Clicky Pen", cost = 100, value = 45, color = Color3.fromRGB(220, 60, 60), blurb = "Click click. Satisfying." },
	{ id = "gel", name = "Gel Pen", cost = 900, value = 140, color = Color3.fromRGB(120, 220, 120), blurb = "Smooth like your pitch." },
	{ id = "fountain", name = "Fountain Pen", cost = 6_000, value = 450, color = Color3.fromRGB(20, 20, 30), blurb = "Old money energy." },
	{ id = "gold", name = "Gold Pen", cost = 40_000, value = 1_600, color = Color3.fromRGB(255, 200, 60), blurb = "Heavy. Shiny. Unnecessary." },
	{ id = "montblank", name = "Mont Blank", cost = 250_000, value = 7_000, color = Color3.fromRGB(245, 245, 245), blurb = "Definitely not a knockoff." },
	{ id = "diamond", name = "Diamond Pen", cost = 1_500_000, value = 28_000, color = Color3.fromRGB(150, 230, 255), blurb = "Writes in pure flex." },
	{ id = "wolf", name = "The Wolf's Pen", cost = 10_000_000, value = 120_000, color = Color3.fromRGB(255, 120, 0), blurb = "The pen. THE pen." },
}

-- Suits: charisma. Start each pitch with higher certainty and a wider
-- sweet spot on the tonality bar.
Config.Suits = {
	{ id = "thrift", name = "Thrift Store Suit", cost = 0, startBonus = 0, sweetSpot = 0.16, cashMult = 1, color = Color3.fromRGB(110, 95, 80) },
	{ id = "rack", name = "Off-the-Rack Suit", cost = 500, startBonus = 0.5, sweetSpot = 0.2, cashMult = 1, color = Color3.fromRGB(70, 70, 80) },
	{ id = "tailored", name = "Tailored Suit", cost = 8_000, startBonus = 1, sweetSpot = 0.24, cashMult = 1.05, color = Color3.fromRGB(30, 35, 60) },
	{ id = "silk", name = "Italian Silk Suit", cost = 80_000, startBonus = 1.5, sweetSpot = 0.28, cashMult = 1.1, color = Color3.fromRGB(25, 25, 28) },
	{ id = "wolfsuit", name = "The Wolf Suit", cost = 1_200_000, startBonus = 2, sweetSpot = 0.34, cashMult = 1.25, color = Color3.fromRGB(15, 15, 15) },
}

-- Phones: passive cold-calling income. You own one at a time (the best one).
Config.Phones = {
	{ id = "none", name = "No Phone", cost = 0, income = 0 },
	{ id = "rotary", name = "Rotary Phone", cost = 300, income = 2 },
	{ id = "desk", name = "Desk Phone", cost = 3_000, income = 12 },
	{ id = "headset", name = "Headset", cost = 25_000, income = 60 },
	{ id = "brick", name = "Brick Cellphone", cost = 200_000, income = 300 },
	{ id = "sat", name = "Satellite Phone", cost = 2_000_000, income = 1_500 },
}

-- Brokers: stackable hires. Every hire costs a bit more than the last.
Config.BrokerCostGrowth = 1.18
Config.Brokers = {
	{ id = "diner", name = "Buddy From The Diner", cost = 1_000, income = 5, blurb = "Quit his job on the spot." },
	{ id = "rookie", name = "Rookie Broker", cost = 12_000, income = 40, blurb = "Headset on. No fear." },
	{ id = "senior", name = "Senior Broker", cost = 150_000, income = 350, blurb = "Has a boat. Wants a bigger boat." },
	{ id = "partner", name = "Founding Partner", cost = 2_000_000, income = 3_000, blurb = "Was there in the garage." },
}

-- Zones. `area` is the rectangle customers wander in (x/z), at height y.
Config.Zones = {
	{
		id = "strip",
		name = "The Strip Mall",
		subtitle = "Long Island Investor Center",
		cost = 0,
		budgetMult = 1,
		customers = 7,
		archetypes = { "tourist", "plumber", "dentist", "mom" },
		area = { minX = -375, maxX = -235, minZ = -55, maxZ = 55, y = 0 },
		gate = nil,
	},
	{
		id = "street",
		name = "Pen Street",
		subtitle = "The financial district",
		cost = 2_500,
		budgetMult = 2.2,
		customers = 9,
		archetypes = { "tourist", "accountant", "shoes", "intern", "fbi" },
		area = { minX = -95, maxX = 190, minZ = -30, maxZ = 30, y = 0 },
		gate = "Gate_PenStreet",
	},
	{
		id = "floor",
		name = "The Trading Floor",
		subtitle = "Stratton Oakpen HQ",
		cost = 60_000,
		budgetMult = 5,
		customers = 9,
		archetypes = { "bro", "accountant", "shoes", "swiss", "fbi" },
		area = { minX = 226, maxX = 338, minZ = -34, maxZ = 34, y = 0 },
		gate = "Gate_TradingFloor",
	},
	{
		id = "yacht",
		name = "The Yacht",
		subtitle = "Moored in the harbor",
		cost = 1_500_000,
		budgetMult = 14,
		customers = 7,
		archetypes = { "duchess", "oil", "swiss", "bro", "fbi" },
		area = { minX = 317, maxX = 343, minZ = 202, maxZ = 226, y = 5.4 },
		gate = "Gate_Yacht",
	},
}

-- IPO = rebirth. Reset everything, keep a permanent multiplier.
Config.IPO = {
	cashRequired = 10_000_000,
	requiresZone = "yacht",
	multPerIPO = 0.5,
}

-- Pitch minigame (Jordan Belfort's "Straight Line": the buyer must be
-- certain about the product, about you, and about your firm).
Config.Pitch = {
	meterMax = 10,
	startMeter = 2.5,
	startJitter = 1.5,
	patience = 5,
	minTurnTime = 0.35, -- seconds between accepted actions
	perfectCloseBonus = 1.5,
	rejectCooldown = 20, -- seconds before that customer will hear you out again
	napkinChance = 0.12,
}

-- The Wolf Speech: a server-wide boost that fires on a timer.
Config.Speech = {
	interval = 7 * 60,
	warning = 20,
	duration = 60,
	globalMult = 2,
	floorMult = 3, -- replaces globalMult for players standing on the trading floor
}

Config.Hum = {
	duration = 20,
	cooldown = 45,
	mult = 1.1,
	crowdMult = 1.25, -- when 3+ players hum together
	crowdSize = 3,
}

function Config.getZone(id)
	for _, zone in Config.Zones do
		if zone.id == id then
			return zone
		end
	end
	return nil
end

function Config.findById(list, id)
	for index, item in list do
		if item.id == id then
			return item, index
		end
	end
	return nil, nil
end

function Config.brokerCost(broker, owned)
	return math.floor(broker.cost * Config.BrokerCostGrowth ^ owned)
end

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[-- Number formatting shared by server messages and client UI.

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx" }

function Format.commas(n)
	n = math.floor(n)
	local s = tostring(math.abs(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return (n < 0 and "-" or "") .. out
end

-- 1234 -> "1,234", 1234567 -> "1.23M"
function Format.short(n)
	n = math.floor(n)
	if math.abs(n) < 100_000 then
		return Format.commas(n)
	end
	local tier = 1
	local value = n
	while math.abs(value) >= 1000 and tier < #SUFFIXES do
		value /= 1000
		tier += 1
	end
	local digits = math.abs(value) >= 100 and 0 or (math.abs(value) >= 10 and 1 or 2)
	return string.format("%." .. digits .. "f%s", value, SUFFIXES[tier])
end

function Format.cash(n)
	return "$" .. Format.short(n)
end

function Format.time(seconds)
	seconds = math.max(0, math.floor(seconds))
	local h = seconds // 3600
	local m = (seconds % 3600) // 60
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	end
	return string.format("%d:%02d", m, s)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">PitchData</string>
          <string name="Source"><![CDATA[-- Pitch content: who you are selling to, and what you can say.
--
-- Every line moves the three Straight Line certainty meters:
--   pen  = certainty about the product
--   you  = certainty about the salesperson
--   firm = certainty about the company behind it
-- Customer archetypes like or dislike line tags, which scales the effect.

local PitchData = {}

PitchData.Tags = {
	rapport = "Rapport",
	question = "Qualify",
	product = "Product",
	urgency = "Urgency",
	authority = "Authority",
	hype = "Hype",
	pressure = "Pressure",
	honest = "Honest",
	napkin = "???",
}

-- likes: x1.6 on gains. dislikes: gains become losses.
PitchData.Archetypes = {
	tourist = {
		name = "Lost Tourist",
		budget = 0.8,
		likes = { "rapport", "hype" },
		dislikes = { "pressure", "authority" },
		skin = Color3.fromRGB(255, 205, 170),
		shirt = Color3.fromRGB(255, 120, 170),
		pants = Color3.fromRGB(90, 150, 220),
		greeting = { "Excuse me, which way to the big bull statue?", "I only came here for a hot dog.", "Is this the line for the ferry?" },
	},
	plumber = {
		name = "Tired Plumber",
		budget = 0.9,
		likes = { "question", "honest" },
		dislikes = { "hype" },
		skin = Color3.fromRGB(200, 150, 110),
		shirt = Color3.fromRGB(60, 90, 160),
		pants = Color3.fromRGB(50, 60, 80),
		greeting = { "Make it quick, pal. I got a leak in Queens.", "A pen? I use a carpenter's pencil." },
	},
	dentist = {
		name = "Bored Dentist",
		budget = 1.1,
		likes = { "product", "authority" },
		dislikes = { "pressure" },
		skin = Color3.fromRGB(240, 200, 160),
		shirt = Color3.fromRGB(235, 245, 250),
		pants = Color3.fromRGB(90, 110, 130),
		greeting = { "I have a root canal at three.", "My accountant says I should diversify." },
	},
	mom = {
		name = "Busy Soccer Mom",
		budget = 1,
		likes = { "rapport", "urgency" },
		dislikes = { "pressure", "hype" },
		skin = Color3.fromRGB(230, 180, 140),
		shirt = Color3.fromRGB(120, 200, 180),
		pants = Color3.fromRGB(60, 60, 90),
		greeting = { "I have exactly four minutes.", "Is this going to take long? The minivan is double parked." },
	},
	accountant = {
		name = "Skeptical Accountant",
		budget = 1.3,
		likes = { "question", "product", "honest" },
		dislikes = { "hype", "pressure" },
		skin = Color3.fromRGB(250, 220, 190),
		shirt = Color3.fromRGB(180, 180, 170),
		pants = Color3.fromRGB(70, 70, 70),
		greeting = { "Show me the numbers.", "I've heard every pitch in the book, kid." },
	},
	shoes = {
		name = "Eccentric Shoe Designer",
		budget = 1.5,
		likes = { "hype", "urgency" },
		dislikes = { "honest" },
		skin = Color3.fromRGB(215, 165, 125),
		shirt = Color3.fromRGB(160, 60, 200),
		pants = Color3.fromRGB(30, 30, 30),
		greeting = { "Does it come in platform?", "I'm about to go public. Impress me." },
	},
	intern = {
		name = "Desperate Intern",
		budget = 0.7,
		likes = { "rapport", "authority" },
		dislikes = {},
		skin = Color3.fromRGB(255, 225, 200),
		shirt = Color3.fromRGB(240, 240, 240),
		pants = Color3.fromRGB(40, 40, 60),
		greeting = { "I've lost six pens today. SIX.", "My boss is going to kill me." },
	},
	bro = {
		name = "Hedge Fund Bro",
		budget = 2,
		likes = { "hype", "pressure", "urgency" },
		dislikes = { "honest", "question" },
		skin = Color3.fromRGB(245, 195, 150),
		shirt = Color3.fromRGB(80, 140, 230),
		pants = Color3.fromRGB(25, 25, 35),
		greeting = { "Bro. BRO. Pitch me.", "I closed three deals before breakfast, bro." },
	},
	swiss = {
		name = "Swiss Banker",
		budget = 2.6,
		likes = { "authority", "product" },
		dislikes = { "hype", "pressure" },
		skin = Color3.fromRGB(250, 225, 205),
		shirt = Color3.fromRGB(35, 35, 45),
		pants = Color3.fromRGB(35, 35, 45),
		greeting = { "Discretion is everything.", "We do not ask questions. We also do not buy pens. Usually." },
	},
	duchess = {
		name = "British Duchess",
		budget = 4,
		likes = { "rapport", "authority" },
		dislikes = { "pressure", "urgency" },
		skin = Color3.fromRGB(255, 225, 210),
		shirt = Color3.fromRGB(200, 170, 230),
		pants = Color3.fromRGB(200, 170, 230),
		greeting = { "Darling, I've never held a pen myself.", "Is this vessel yours? How quaint." },
	},
	oil = {
		name = "Oil Tycoon",
		budget = 5,
		likes = { "hype", "urgency", "authority" },
		dislikes = { "question" },
		skin = Color3.fromRGB(215, 160, 120),
		shirt = Color3.fromRGB(240, 230, 210),
		pants = Color3.fromRGB(120, 90, 60),
		greeting = { "I buy things. Big things. Is this big?", "Name your price, boy." },
	},
	fbi = {
		name = "Undercover FBI Agent",
		budget = 3,
		-- Only honesty works on him. Hard sells backfire hard.
		likes = { "honest", "question" },
		dislikes = { "pressure", "hype", "urgency" },
		special = "fbi",
		skin = Color3.fromRGB(235, 190, 150),
		shirt = Color3.fromRGB(60, 70, 60),
		pants = Color3.fromRGB(60, 70, 60),
		greeting = { "Just a regular guy. Buying regular pens.", "Nice firm you got here. Real nice. Be a shame if..." },
	},
}

-- Effects are { pen, you, firm }.
PitchData.Lines = {
	-- Rapport
	{ tag = "rapport", text = "Nice watch. You look like someone who signs important things.", fx = { 0, 2, 0 } },
	{ tag = "rapport", text = "Before we talk pens: how's your day actually going?", fx = { 0, 2, 1 } },
	{ tag = "rapport", text = "I'll be straight with you. I like you already.", fx = { 0, 2, 0 } },
	{ tag = "rapport", text = "My grandfather sold pens. He'd have loved you.", fx = { 1, 1, 0 } },

	-- Qualify (Belfort's real answer: ask questions first)
	{ tag = "question", text = "When was the last time you needed a pen and didn't have one?", fx = { 2, 1, 0 } },
	{ tag = "question", text = "What do you usually write with? And what do you hate about it?", fx = { 2, 1, 0 } },
	{ tag = "question", text = "How many important contracts will you sign this year?", fx = { 2, 0, 1 } },
	{ tag = "question", text = "What would it cost you to miss one signature?", fx = { 2, 1, 0 } },

	-- Product
	{ tag = "product", text = "It writes upside down, underwater, and in zero gravity.", fx = { 3, 0, 0 } },
	{ tag = "product", text = "Feel that weight. That's a pen that means business.", fx = { 2, 1, 0 } },
	{ tag = "product", text = "Lifetime ink warranty. It will outlive your stapler.", fx = { 2, 0, 1 } },
	{ tag = "product", text = "It's a pen. It... writes?", fx = { -1, -1, 0 }, bad = true },
	{ tag = "product", text = "It's blue. Like the ocean. Or a very sad smurf.", fx = { -1, 0, 0 }, bad = true },

	-- Urgency (supply and demand)
	{ tag = "urgency", text = "I've got three left, and the guy behind you wants all of them.", fx = { 1, 0, 1 } },
	{ tag = "urgency", text = "Price goes up at the closing bell. That's in four minutes.", fx = { 2, 0, 1 } },
	{ tag = "urgency", text = "Limited run. When they're gone, they're gone.", fx = { 2, 0, 0 } },

	-- Authority
	{ tag = "authority", text = "Our firm has moved more pens than anyone on the East Coast.", fx = { 0, 0, 3 } },
	{ tag = "authority", text = "Every CEO on this street signs with one of ours.", fx = { 1, 0, 2 } },
	{ tag = "authority", text = "We're regulated, audited, and frankly, legendary.", fx = { 0, 1, 2 } },

	-- Hype
	{ tag = "hype", text = "This isn't a pen. It's a lifestyle.", fx = { 1, 1, 1 } },
	{ tag = "hype", text = "You're not buying a pen. You're buying the person who owns this pen.", fx = { 1, 2, 0 } },
	{ tag = "hype", text = "Money never sleeps, and neither does this ink.", fx = { 2, 1, 0 } },

	-- Pressure
	{ tag = "pressure", text = "Pick up the pen. PICK. UP. THE. PEN.", fx = { 2, -1, 0 } },
	{ tag = "pressure", text = "I'm not leaving until you say yes.", fx = { 1, 1, -1 } },
	{ tag = "pressure", text = "Yes or yes? Your call.", fx = { 1, 0, 1 } },

	-- Honest
	{ tag = "honest", text = "Honestly? It's a solid pen at a fair price. That's it.", fx = { 1, 1, 1 } },
	{ tag = "honest", text = "If you don't need it, don't buy it. But I think you do.", fx = { 1, 2, 0 } },
}

-- The legendary line from the film's final scene.
PitchData.Napkin = {
	tag = "napkin",
	text = "Do me a favor. Write your name on this napkin for me.",
	fx = { 4, 3, 3 },
	napkin = true,
}

PitchData.CloseSuccess = {
	"Deal. Where do I sign? Oh wait, with THIS.",
	"You know what? I'll take it.",
	"Fine! FINE. Give me the pen.",
	"I don't know what just happened, but I'm buying.",
	"Sold. Tell your boss you're a monster.",
}

PitchData.CloseFail = {
	"Fugazi. It's all fugazi.",
	"Nice try, kid. Not today.",
	"I'm gonna need a minute...",
	"You're pushing too hard, buddy.",
}

PitchData.WalkAway = {
	"I'm late for lunch. Bye.",
	"I'll think about it. (He will not.)",
	"Pens are a scam anyway.",
	"Call my assistant. Actually, don't.",
}

PitchData.Reactions = {
	good = { "Go on...", "Huh. Interesting.", "Okay, okay, I'm listening.", "Now we're talking!" },
	great = { "OH, now I get it.", "Say that again!", "You're good, kid." },
	bad = { "...what?", "That's the worst thing I've heard today.", "Are you new?", "Wow. No." },
}

PitchData.FBI = {
	busted = "FBI! Hard-selling a federal agent? That's a fine, pal.",
	honest = "An honest broker? On THIS street? I'll buy three.",
}

return PitchData
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="20">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="21">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">CustomerService</string>
          <string name="Source"><![CDATA[-- Spawns the customers that wander each zone, and gives each of them a
-- "Sell Me This Pen" prompt. PitchService takes over when one is pitched.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local PitchData = require(ReplicatedStorage.Shared.PitchData)

local CustomerService = {}

local customers = {} -- [Model] = state
local folder
local promptCallback

local rng = Random.new()

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

local function randomPoint(area)
	return Vector3.new(rng:NextNumber(area.minX, area.maxX), area.y + 3, rng:NextNumber(area.minZ, area.maxZ))
end

local function makeSpeechBubble(head)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Speech"
	gui.Size = UDim2.fromOffset(260, 70)
	gui.StudsOffset = Vector3.new(0, 4.2, 0)
	gui.MaxDistance = 60
	gui.Enabled = false

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(20, 20, 20)
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = frame
	gui.Parent = head
end

local function makeNameTag(head, archetype)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(180, 40)
	gui.StudsOffset = Vector3.new(0, 2.3, 0)
	gui.MaxDistance = 45

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.Text = archetype.name
	label.TextColor3 = archetype.special == "fbi" and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(255, 235, 170)
	label.TextStrokeTransparency = 0.4
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = head
end

local function addTie(model, color)
	local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
	if not torso then
		return
	end
	local tie = Instance.new("Part")
	tie.Name = "Tie"
	tie.Size = Vector3.new(0.35, 1.1, 0.1)
	tie.Color = color
	tie.Material = Enum.Material.Fabric
	tie.CanCollide = false
	tie.CanQuery = false
	tie.Massless = true
	tie.CFrame = torso.CFrame * CFrame.new(0, 0.05, -torso.Size.Z / 2 - 0.04)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = torso
	weld.Part1 = tie
	weld.Parent = tie
	tie.Parent = model
end

local TIE_COLORS = {
	Color3.fromRGB(200, 30, 40),
	Color3.fromRGB(230, 180, 40),
	Color3.fromRGB(40, 60, 160),
	Color3.fromRGB(20, 20, 20),
}

local function buildCustomer(archetypeKey, zone)
	local archetype = PitchData.Archetypes[archetypeKey]
	local description = Instance.new("HumanoidDescription")
	description.HeadColor = archetype.skin
	description.LeftArmColor = archetype.shirt
	description.RightArmColor = archetype.shirt
	description.TorsoColor = archetype.shirt
	description.LeftLegColor = archetype.pants
	description.RightLegColor = archetype.pants
	description.HeightScale = rng:NextNumber(0.92, 1.08)
	description.WidthScale = rng:NextNumber(0.9, 1.15)

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[CustomerService] could not build customer:", model)
		return nil
	end

	model.Name = archetype.name
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = rng:NextNumber(6, 10)
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge

	local head = model:WaitForChild("Head")
	-- Hands are the arm color by default; keep them skin colored.
	for _, name in { "LeftHand", "RightHand" } do
		local hand = model:FindFirstChild(name)
		if hand then
			hand.Color = archetype.skin
		end
	end
	if archetypeKey ~= "tourist" and archetypeKey ~= "plumber" and archetypeKey ~= "mom" then
		addTie(model, pick(TIE_COLORS))
	end
	makeNameTag(head, archetype)
	makeSpeechBubble(head)

	local root = model:WaitForChild("HumanoidRootPart")
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PitchPrompt"
	prompt.ActionText = "Sell Me This Pen"
	prompt.ObjectText = archetype.name
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Zone", zone.id)
	prompt.Parent = root

	model:SetAttribute("Zone", zone.id)
	model:SetAttribute("Archetype", archetypeKey)
	model:PivotTo(CFrame.new(randomPoint(zone.area)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model.Parent = folder
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local state = {
		model = model,
		humanoid = humanoid,
		root = root,
		prompt = prompt,
		zone = zone,
		archetypeKey = archetypeKey,
		busy = false,
		cooldowns = {}, -- [Player] = os.clock() until they'll listen again
	}
	customers[model] = state

	prompt.Triggered:Connect(function(player)
		if promptCallback then
			promptCallback(player, state)
		end
	end)

	-- Wander.
	task.spawn(function()
		while model.Parent do
			if not state.busy then
				humanoid:MoveTo(randomPoint(zone.area))
				local finished = false
				local connection = humanoid.MoveToFinished:Once(function()
					finished = true
				end)
				local started = os.clock()
				while not finished and not state.busy and os.clock() - started < 9 and model.Parent do
					task.wait(0.25)
				end
				connection:Disconnect()
				if not state.busy then
					humanoid:MoveTo(root.Position)
					task.wait(rng:NextNumber(1.5, 6))
				end
			else
				task.wait(0.5)
			end
			-- Fell off the map somehow: put them back.
			if root.Position.Y < zone.area.y - 30 then
				model:PivotTo(CFrame.new(randomPoint(zone.area)))
			end
		end
	end)

	return state
end

local function spawnFor(zone)
	local archetypeKey = pick(zone.archetypes)
	-- FBI agents are rare.
	if archetypeKey == "fbi" and rng:NextNumber() > 0.35 then
		repeat
			archetypeKey = pick(zone.archetypes)
		until archetypeKey ~= "fbi"
	end
	return buildCustomer(archetypeKey, zone)
end

function CustomerService.say(state, text, duration)
	local head = state.model:FindFirstChild("Head")
	local bubble = head and head:FindFirstChild("Speech")
	if not bubble then
		return
	end
	bubble.Frame.Text.Text = text
	bubble.Enabled = true
	local token = {}
	state.speechToken = token
	task.delay(duration or 3.5, function()
		if state.speechToken == token and bubble.Parent then
			bubble.Enabled = false
		end
	end)
end

function CustomerService.setBusy(state, busy, facePlayer)
	state.busy = busy
	state.prompt.Enabled = not busy
	if busy then
		state.humanoid:MoveTo(state.root.Position)
		local character = facePlayer and facePlayer.Character
		local other = character and character:FindFirstChild("HumanoidRootPart")
		if other then
			local look = Vector3.new(other.Position.X, state.root.Position.Y, other.Position.Z)
			if (look - state.root.Position).Magnitude > 0.1 then
				state.root.CFrame = CFrame.lookAt(state.root.Position, look)
			end
		end
	end
end

-- The customer bought (or got arrested): they leave and someone new shows up.
function CustomerService.replace(state, delaySeconds)
	state.busy = true
	state.prompt.Enabled = false
	customers[state.model] = nil
	task.delay(delaySeconds or 3, function()
		if state.model.Parent then
			state.model:Destroy()
		end
		task.wait(rng:NextNumber(2, 5))
		spawnFor(state.zone)
	end)
end

function CustomerService.start(onPrompt)
	promptCallback = onPrompt

	folder = Instance.new("Folder")
	folder.Name = "Customers"
	folder.Parent = Workspace

	for _, zone in Config.Zones do
		for _ = 1, zone.customers do
			task.spawn(spawnFor, zone)
			task.wait(0.05)
		end
	end
end

return CustomerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads, holds and saves every player's profile.
-- Works without DataStore access (e.g. an unpublished place in Studio):
-- progress then simply isn't saved.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local STORE_NAME = "SellMeThisPen_v1"
local LEADERBOARD_NAME = "SellMeThisPen_NetWorth_v1"

local store
local leaderboardStore
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(STORE_NAME)
		leaderboardStore = DataStoreService:GetOrderedDataStore(LEADERBOARD_NAME)
	end)
	if not ok then
		warn("[DataService] DataStores unavailable, progress won't save:", err)
	end
end

local profiles = {} -- [Player] = profile
local loaded = {} -- [Player] = true once the load attempt finished
local changedCallbacks = {}

local function defaultProfile()
	return {
		cash = Config.StartingCash,
		lifetime = 0, -- lifetime earnings, never reset (leaderboard)
		pensSold = 0,
		ipos = 0,
		pen = "bic",
		suit = "thrift",
		phone = "none",
		brokers = {},
		zones = { strip = true },
		perfectCloses = 0,
		napkins = 0,
		lastOnline = 0,
		lastDaily = 0,
	}
end

-- Fill in fields added in later versions of the game.
local function reconcile(data)
	local template = defaultProfile()
	for key, value in template do
		if data[key] == nil then
			data[key] = value
		end
	end
	return data
end

local function withRetries(fn)
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[DataService] attempt %d failed: %s", attempt, tostring(result)))
		-- No API access (e.g. Studio without "Enable Studio Access to API Services"): don't bother retrying.
		local message = tostring(result)
		if message:find("403") or message:find("Studio") or message:find("publish") then
			return false, nil
		end
		task.wait(attempt * 1.5)
	end
	return false, nil
end

function DataService.onChanged(callback)
	table.insert(changedCallbacks, callback)
end

function DataService.get(player)
	return profiles[player]
end

function DataService.isLoaded(player)
	return loaded[player] == true
end

-- Call after mutating a profile so clients and leaderstats refresh.
function DataService.changed(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, profile)
	end
end

function DataService.addCash(player, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.cash += amount
	if amount > 0 then
		profile.lifetime += amount
	end
	DataService.changed(player)
end

function DataService.load(player)
	local key = "player_" .. player.UserId
	local data
	if store then
		local ok, result = withRetries(function()
			return store:GetAsync(key)
		end)
		if ok then
			data = result
		else
			-- Don't let a failed load overwrite the real save later.
			player:SetAttribute("SaveDisabled", true)
			warn("[DataService] could not load", player.Name, "- saving disabled this session")
		end
	end
	if not player.Parent then
		return nil
	end
	local profile = reconcile(type(data) == "table" and data or defaultProfile())
	profiles[player] = profile
	loaded[player] = true
	return profile
end

function DataService.save(player)
	local profile = profiles[player]
	if not store or not profile or player:GetAttribute("SaveDisabled") then
		return
	end
	profile.lastOnline = os.time()
	local key = "player_" .. player.UserId
	withRetries(function()
		store:SetAsync(key, profile)
	end)
	if leaderboardStore then
		pcall(function()
			leaderboardStore:SetAsync(key, math.floor(profile.lifetime))
		end)
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
end

function DataService.getTopEarners(count)
	if not leaderboardStore then
		return {}
	end
	local ok, pages = pcall(function()
		return leaderboardStore:GetSortedAsync(false, count)
	end)
	if not ok then
		return {}
	end
	local results = {}
	for rank, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "%d+"))
		local name = "???"
		if userId then
			local nameOk, fetched = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			if nameOk then
				name = fetched
			end
		end
		table.insert(results, { rank = rank, name = name, value = entry.value })
	end
	return results
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait()
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- Money: multipliers, passive income, the shop, IPOs, leaderstats,
-- player titles and the pen every player carries.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)

local Remotes = ReplicatedStorage.Remotes

local EconomyService = {}

EconomyService.Ranks = {
	{ min = 0, title = "Pen Pusher", color = Color3.fromRGB(200, 200, 200) },
	{ min = 1_000, title = "Cold Caller", color = Color3.fromRGB(140, 220, 140) },
	{ min = 25_000, title = "Stockbroker", color = Color3.fromRGB(110, 190, 255) },
	{ min = 500_000, title = "Big Swinging Pen", color = Color3.fromRGB(200, 140, 255) },
	{ min = 10_000_000, title = "The Wolf", color = Color3.fromRGB(255, 200, 60) },
	{ min = 1_000_000_000, title = "Wolf of Pen Street", color = Color3.fromRGB(255, 110, 40) },
}

function EconomyService.notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function EconomyService.notifyAll(text, kind)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

function EconomyService.getRank(lifetime)
	local best = EconomyService.Ranks[1]
	for _, rank in EconomyService.Ranks do
		if lifetime >= rank.min then
			best = rank
		end
	end
	return best
end

function EconomyService.ipoMult(profile)
	return 1 + profile.ipos * Config.IPO.multPerIPO
end

function EconomyService.passiveIncome(profile)
	local income = 0
	local phone = Config.findById(Config.Phones, profile.phone)
	if phone then
		income += phone.income
	end
	for _, broker in Config.Brokers do
		income += (profile.brokers[broker.id] or 0) * broker.income
	end
	return income * EconomyService.ipoMult(profile)
end

local function isOnTradingFloor(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local area = Config.getZone("floor").area
	local p = root.Position
	return p.X >= area.minX - 10 and p.X <= area.maxX + 10 and p.Z >= area.minZ - 10 and p.Z <= area.maxZ + 10
end

-- Everything that boosts a single sale, as one number plus a breakdown.
function EconomyService.saleMult(player, profile)
	local mult = EconomyService.ipoMult(profile)
	local suit = Config.findById(Config.Suits, profile.suit)
	if suit then
		mult *= suit.cashMult
	end
	if Workspace:GetAttribute("SpeechActive") then
		mult *= isOnTradingFloor(player) and Config.Speech.floorMult or Config.Speech.globalMult
	end
	if (player:GetAttribute("HumUntil") or 0) > os.clock() then
		local humming = 0
		for _, other in Players:GetPlayers() do
			if (other:GetAttribute("HumUntil") or 0) > os.clock() then
				humming += 1
			end
		end
		mult *= humming >= Config.Hum.crowdSize and Config.Hum.crowdMult or Config.Hum.mult
	end
	return mult
end

local function sync(player, profile)
	Remotes.DataSync:FireClient(player, {
		profile = profile,
		income = EconomyService.passiveIncome(profile),
		ipoMult = EconomyService.ipoMult(profile),
		nextIpoMult = 1 + (profile.ipos + 1) * Config.IPO.multPerIPO,
	})

	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Cash.Value = Format.cash(profile.cash)
		stats["Pens Sold"].Value = profile.pensSold
		stats.IPOs.Value = profile.ipos
	end

	local rank = EconomyService.getRank(profile.lifetime)
	if player:GetAttribute("Rank") ~= rank.title then
		player:SetAttribute("Rank", rank.title)
		EconomyService.updateTitle(player)
	end
end

local function createLeaderstats(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local sold = Instance.new("IntValue")
	sold.Name = "Pens Sold"
	sold.Parent = stats
	local ipos = Instance.new("IntValue")
	ipos.Name = "IPOs"
	ipos.Parent = stats
	stats.Parent = player
end

-- Overhead title: rank + IPO count.
function EconomyService.updateTitle(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local profile = DataService.get(player)
	if not head or not profile then
		return
	end
	local rank = EconomyService.getRank(profile.lifetime)
	local gui = head:FindFirstChild("RankTitle")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "RankTitle"
		gui.Size = UDim2.fromOffset(200, 50)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 80
		gui.AlwaysOnTop = false
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextStrokeTransparency = 0.3
		label.Parent = gui
		gui.Parent = head
	end
	local text = rank.title
	if profile.ipos > 0 then
		text ..= string.format("  ·  IPO x%d", profile.ipos)
	end
	gui.Label.Text = text
	gui.Label.TextColor3 = rank.color
end

-- Every player holds their current pen.
function EconomyService.givePen(player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local pen = Config.findById(Config.Pens, profile.pen)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	for _, container in { backpack, player.Character } do
		if container then
			local old = container:FindFirstChild("SalesPen")
			if old then
				old:Destroy()
			end
		end
	end

	local tool = Instance.new("Tool")
	tool.Name = "SalesPen"
	tool.ToolTip = pen.name
	tool.CanBeDropped = false
	tool.GripPos = Vector3.new(0, -0.1, 0)
	tool.GripForward = Vector3.new(0, 0, -1)
	tool.GripUp = Vector3.new(0, 1, 0)
	tool:SetAttribute("PenName", pen.name)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.18, 1.4, 0.18)
	handle.Color = pen.color
	handle.Material = pen.id == "diamond" and Enum.Material.Glass or Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Cylinder
	mesh.Parent = handle
	handle.Parent = tool

	local cap = Instance.new("Part")
	cap.Name = "Cap"
	cap.Size = Vector3.new(0.22, 0.4, 0.22)
	cap.Color = pen.id == "gold" and Color3.fromRGB(255, 230, 140) or Color3.fromRGB(230, 200, 90)
	cap.Material = Enum.Material.Metal
	cap.CanCollide = false
	cap.Massless = true
	cap.CFrame = handle.CFrame * CFrame.new(0, 0.55, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = cap
	weld.Parent = cap
	cap.Parent = tool

	if pen.id == "wolf" or pen.id == "diamond" then
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = pen.color
		sparkle.Parent = handle
	end

	tool.Parent = backpack
end

local CATEGORY_LISTS = {
	pen = Config.Pens,
	suit = Config.Suits,
	phone = Config.Phones,
}

function EconomyService.purchase(player, category, id)
	local profile = DataService.get(player)
	if not profile or type(category) ~= "string" or type(id) ~= "string" then
		return false, "Not ready yet."
	end

	if CATEGORY_LISTS[category] then
		local list = CATEGORY_LISTS[category]
		local item, index = Config.findById(list, id)
		local _, currentIndex = Config.findById(list, profile[category])
		if not item then
			return false, "Unknown item."
		end
		if index <= (currentIndex or 0) then
			return false, "You already own something better."
		end
		if profile.cash < item.cost then
			return false, "Not enough cash. Go sell some pens!"
		end
		profile.cash -= item.cost
		profile[category] = id
		DataService.changed(player)
		if category == "pen" then
			EconomyService.givePen(player)
		end
		return true, "Bought " .. item.name .. "!"
	elseif category == "broker" then
		local broker = Config.findById(Config.Brokers, id)
		if not broker then
			return false, "Unknown broker."
		end
		local owned = profile.brokers[id] or 0
		local cost = Config.brokerCost(broker, owned)
		if profile.cash < cost then
			return false, "Not enough cash to hire."
		end
		profile.cash -= cost
		profile.brokers[id] = owned + 1
		DataService.changed(player)
		return true, "Hired " .. broker.name .. "!"
	elseif category == "zone" then
		local zone = Config.getZone(id)
		if not zone then
			return false, "Unknown zone."
		end
		if profile.zones[id] then
			return false, "Already unlocked."
		end
		for index, other in Config.Zones do
			if other.id == id and index > 1 and not profile.zones[Config.Zones[index - 1].id] then
				return false, "Unlock " .. Config.Zones[index - 1].name .. " first."
			end
		end
		if profile.cash < zone.cost then
			return false, "You need " .. Format.cash(zone.cost) .. " to unlock " .. zone.name .. "."
		end
		profile.cash -= zone.cost
		profile.zones[id] = true
		DataService.changed(player)
		EconomyService.notifyAll(player.DisplayName .. " just unlocked " .. zone.name .. "!", "big")
		return true, "Welcome to " .. zone.name .. "!"
	end
	return false, "Unknown category."
end

local function ipo(player)
	local profile = DataService.get(player)
	if not profile then
		return false, "Not ready yet."
	end
	if not profile.zones[Config.IPO.requiresZone] then
		return false, "Unlock the Yacht before going public."
	end
	if profile.cash < Config.IPO.cashRequired then
		return false, "You need " .. Format.cash(Config.IPO.cashRequired) .. " to IPO."
	end
	profile.ipos += 1
	profile.cash = Config.StartingCash
	profile.pen = "bic"
	profile.suit = "thrift"
	profile.phone = "none"
	profile.brokers = {}
	profile.zones = { strip = true }
	DataService.changed(player)
	EconomyService.givePen(player)
	EconomyService.updateTitle(player)

	-- Back to the strip mall where it all began.
	local spawn = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Spawn", true)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if spawn and root then
		root.CFrame = spawn.CFrame + Vector3.new(0, 4, 0)
	end
	EconomyService.notifyAll(
		string.format("%s just took the firm public! (IPO #%d)", player.DisplayName, profile.ipos),
		"big"
	)
	return true, string.format("IPO complete! Permanent x%.1f multiplier.", EconomyService.ipoMult(profile))
end

function EconomyService.onPlayerLoaded(player, profile)
	createLeaderstats(player)

	-- Offline earnings from phones and brokers.
	if profile.lastOnline > 0 then
		local away = math.clamp(os.time() - profile.lastOnline, 0, Config.OfflineEarningsCap)
		local earned = math.floor(EconomyService.passiveIncome(profile) * away * Config.OfflineEarningsRate)
		if earned > 0 then
			DataService.addCash(player, earned)
			task.delay(3, EconomyService.notify, player, "Your brokers made " .. Format.cash(earned) .. " while you were away.", "big")
		end
	end

	-- Daily bonus.
	if os.time() - profile.lastDaily >= Config.DailyBonusCooldown then
		profile.lastDaily = os.time()
		local bonus = math.max(250, math.floor(EconomyService.passiveIncome(profile) * 300))
		DataService.addCash(player, bonus)
		task.delay(5, EconomyService.notify, player, "Daily bonus: " .. Format.cash(bonus) .. ". Rise and grind.", "big")
	end

	sync(player, profile)

	local function onCharacter(character)
		character:WaitForChild("Head")
		task.wait(0.2)
		EconomyService.givePen(player)
		EconomyService.updateTitle(player)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

function EconomyService.start()
	DataService.onChanged(sync)

	Remotes.Purchase.OnServerInvoke = function(player, category, id)
		local ok, message = EconomyService.purchase(player, category, id)
		return ok, message
	end
	Remotes.IPO.OnServerInvoke = ipo
	-- The client asks for a snapshot once its UI is listening.
	Remotes.DataSync.OnServerEvent:Connect(function(player)
		local profile = DataService.get(player)
		if profile then
			sync(player, profile)
		end
	end)

	-- Passive income tick.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local profile = DataService.get(player)
				if profile then
					local income = EconomyService.passiveIncome(profile)
					if income > 0 then
						DataService.addCash(player, income)
					end
				end
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="25">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point.

local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PitchService = require(script.Parent.PitchService)
local WorldService = require(script.Parent.WorldService)

DataService.start()
EconomyService.start()
PitchService.start()
WorldService.start()

local function onPlayerAdded(player)
	local profile = DataService.load(player)
	if profile then
		EconomyService.onPlayerLoaded(player, profile)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	DataService.release(player)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">PitchService</string>
          <string name="Source"><![CDATA[-- The pitch minigame. Server-authoritative: the client only picks one of
-- the offered lines (plus how well it hit the tonality bar) or tries to close.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PitchData = require(ReplicatedStorage.Shared.PitchData)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local CustomerService = require(script.Parent.CustomerService)

local Remotes = ReplicatedStorage.Remotes

local PitchService = {}

local sessions = {} -- [Player] = session
local rng = Random.new()

local METERS = { "pen", "you", "firm" }
local MAX = Config.Pitch.meterMax

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

local function contains(list, value)
	return table.find(list, value) ~= nil
end

local function closeChance(meters)
	local minimum = math.min(meters.pen, meters.you, meters.firm) / MAX
	local average = (meters.pen + meters.you + meters.firm) / (3 * MAX)
	if minimum >= 1 then
		return 1
	end
	return math.clamp(0.08 + 0.9 * (0.6 * minimum + 0.4 * average), 0.05, 0.97)
end

local function drawOptions(session)
	local options = {}
	local usedTags = {}
	local badCount = 0
	local attempts = 0
	while #options < 3 and attempts < 100 do
		attempts += 1
		local line = pick(PitchData.Lines)
		if not usedTags[line.tag] and not (line.bad and badCount >= 1) then
			usedTags[line.tag] = true
			if line.bad then
				badCount += 1
			end
			table.insert(options, line)
		end
	end
	if not session.napkinUsed and rng:NextNumber() < Config.Pitch.napkinChance then
		options[rng:NextInteger(1, #options)] = PitchData.Napkin
	end
	-- Shuffle so the napkin isn't always in the same slot.
	for i = #options, 2, -1 do
		local j = rng:NextInteger(1, i)
		options[i], options[j] = options[j], options[i]
	end
	session.options = options
end

local function payoutFor(session, profile, player)
	local pen = Config.findById(Config.Pens, profile.pen)
	local archetype = PitchData.Archetypes[session.archetypeKey]
	local m = session.meters
	local average = (m.pen + m.you + m.firm) / (3 * MAX)
	local quality = 0.5 + 1.5 * average
	local perfect = m.pen >= MAX and m.you >= MAX and m.firm >= MAX
	local amount = pen.value * session.zone.budgetMult * archetype.budget * quality
	if perfect then
		amount *= Config.Pitch.perfectCloseBonus
	end
	amount *= EconomyService.saleMult(player, profile)
	return math.max(1, math.floor(amount)), perfect
end

local function snapshot(session)
	local options = {}
	for _, line in session.options do
		table.insert(options, { text = line.text, tag = line.tag, napkin = line.napkin == true })
	end
	return {
		meters = session.meters,
		patience = session.patience,
		maxPatience = session.maxPatience,
		options = options,
		closeChance = closeChance(session.meters),
	}
end

local function finish(player, result, amount, line, extra)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	local customer = session.customer

	Remotes.PitchEnd:FireClient(player, {
		result = result,
		amount = amount or 0,
		line = line,
		perfect = extra and extra.perfect or false,
		napkin = extra and extra.napkin or false,
	})

	if result == "sold" or result == "busted" then
		if line then
			CustomerService.say(customer, line, 3)
		end
		CustomerService.replace(customer, 3.2)
	else
		if line then
			CustomerService.say(customer, line, 3)
		end
		customer.cooldowns[player] = os.clock() + Config.Pitch.rejectCooldown
		CustomerService.setBusy(customer, false)
	end
end

local function start(player, customer)
	local profile = DataService.get(player)
	if not profile or sessions[player] or customer.busy then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - customer.root.Position).Magnitude > 16 then
		return
	end
	if not profile.zones[customer.zone.id] then
		EconomyService.notify(player, "Unlock " .. customer.zone.name .. " to pitch here.", "error")
		return
	end
	local cooldown = customer.cooldowns[player]
	if cooldown and cooldown > os.clock() then
		CustomerService.say(customer, "I already said no, pal.", 2)
		return
	end

	local archetype = PitchData.Archetypes[customer.archetypeKey]
	local suit = Config.findById(Config.Suits, profile.suit)
	local meters = {}
	for _, key in METERS do
		local value = Config.Pitch.startMeter + suit.startBonus + rng:NextNumber(-1, 1) * Config.Pitch.startJitter
		meters[key] = math.clamp(math.floor(value * 2 + 0.5) / 2, 0, MAX)
	end

	local session = {
		player = player,
		customer = customer,
		zone = customer.zone,
		archetypeKey = customer.archetypeKey,
		meters = meters,
		patience = Config.Pitch.patience,
		maxPatience = Config.Pitch.patience,
		lastAction = os.clock(),
		usedTags = {},
		napkinUsed = false,
	}
	drawOptions(session)
	sessions[player] = session
	CustomerService.setBusy(customer, true, player)
	local greeting = pick(archetype.greeting)
	CustomerService.say(customer, greeting, 4)

	local pen = Config.findById(Config.Pens, profile.pen)
	local data = snapshot(session)
	data.customer = {
		name = archetype.name,
		key = customer.archetypeKey,
		greeting = greeting,
		likes = archetype.likes,
		dislikes = archetype.dislikes,
		budget = archetype.budget * customer.zone.budgetMult,
		zone = customer.zone.name,
	}
	data.pen = pen.name
	data.estimate = math.floor(pen.value * customer.zone.budgetMult * archetype.budget * EconomyService.saleMult(player, profile))
	data.sweetSpot = suit.sweetSpot
	data.tags = PitchData.Tags
	data.model = customer.model
	Remotes.PitchStart:FireClient(player, data)
end

local function applyLine(session, line, tonality)
	local archetype = PitchData.Archetypes[session.archetypeKey]
	local liked = contains(archetype.likes, line.tag)
	local disliked = contains(archetype.dislikes, line.tag)
	local tonalityMult = 0.4 + 1.1 * tonality
	local total = 0
	local deltas = {}
	for index, key in METERS do
		local delta = line.fx[index]
		if delta > 0 then
			if line.napkin then
				delta *= math.max(1, tonalityMult)
			elseif disliked then
				delta = -math.max(1, delta * 0.6)
			else
				delta *= tonalityMult * (liked and 1.6 or 1)
			end
		end
		delta = math.floor(delta * 2 + 0.5) / 2
		session.meters[key] = math.clamp(session.meters[key] + delta, 0, MAX)
		deltas[key] = delta
		total += delta
	end
	session.usedTags[line.tag] = true
	if line.napkin then
		session.napkinUsed = true
	end
	return deltas, total, liked, disliked
end

local function onAction(player, action)
	local session = sessions[player]
	if not session or type(action) ~= "table" then
		return
	end
	if os.clock() - session.lastAction < Config.Pitch.minTurnTime then
		return
	end
	session.lastAction = os.clock()
	local customer = session.customer
	local archetype = PitchData.Archetypes[session.archetypeKey]
	local profile = DataService.get(player)
	if not profile then
		return
	end

	if action.type == "leave" then
		finish(player, "left", 0, "Okay... bye then?")
		return
	end

	if action.type == "line" then
		if session.patience <= 0 then
			return
		end
		local line = session.options[tonumber(action.index) or 0]
		if not line then
			return
		end
		local tonality = math.clamp(tonumber(action.tonality) or 0, 0, 1)
		if tonality ~= tonality then -- NaN
			tonality = 0
		end
		local deltas, total, liked, disliked = applyLine(session, line, tonality)
		session.patience -= 1

		local reaction
		if line.napkin then
			reaction = "I... don't have a pen. Oh. OH. Supply and demand!"
		elseif total >= 4 then
			reaction = pick(PitchData.Reactions.great)
		elseif total > 0 then
			reaction = pick(PitchData.Reactions.good)
		else
			reaction = pick(PitchData.Reactions.bad)
		end
		CustomerService.say(customer, reaction, 3)
		drawOptions(session)

		local data = snapshot(session)
		data.deltas = deltas
		data.reaction = reaction
		data.liked = liked
		data.disliked = disliked
		data.napkin = line.napkin == true
		data.tonality = tonality
		if session.patience <= 0 then
			data.options = {}
			data.lastChance = true
			CustomerService.say(customer, "Last chance. Close me or I'm gone.", 4)
		end
		Remotes.PitchUpdate:FireClient(player, data)
		return
	end

	if action.type == "close" then
		local chance = closeChance(session.meters)
		if rng:NextNumber() <= chance then
			-- FBI: any hard-sell line and you're fined instead of paid.
			if archetype.special == "fbi" then
				local hardSold = session.usedTags.pressure or session.usedTags.hype or session.usedTags.urgency
				if hardSold then
					local fine = math.floor(math.min(profile.cash * 0.05, 50_000 * (profile.ipos + 1)))
					DataService.addCash(player, -fine)
					finish(player, "busted", -fine, PitchData.FBI.busted)
					return
				end
			end

			local amount, perfect = payoutFor(session, profile, player)
			if archetype.special == "fbi" then
				amount *= 3
			end
			profile.pensSold += 1
			if perfect then
				profile.perfectCloses += 1
			end
			if session.napkinUsed then
				profile.napkins += 1
			end
			DataService.addCash(player, amount)

			local line = archetype.special == "fbi" and PitchData.FBI.honest or pick(PitchData.CloseSuccess)
			finish(player, "sold", amount, line, { perfect = perfect, napkin = session.napkinUsed })
			if amount >= 1_000_000 then
				EconomyService.notifyAll(
					string.format("%s just sold a pen for %s!", player.DisplayName, Format.cash(amount)),
					"big"
				)
			end
			return
		end

		-- Failed close: lose patience, certainty drops a notch.
		if session.patience <= 0 then
			finish(player, "walked", 0, pick(PitchData.WalkAway))
			return
		end
		session.patience -= 1
		for _, key in METERS do
			session.meters[key] = math.max(0, session.meters[key] - 1)
		end
		local reaction = pick(PitchData.CloseFail)
		CustomerService.say(customer, reaction, 3)
		local data = snapshot(session)
		data.reaction = reaction
		data.closeFailed = true
		data.deltas = { pen = -1, you = -1, firm = -1 }
		if session.patience <= 0 then
			data.options = {}
			data.lastChance = true
		end
		Remotes.PitchUpdate:FireClient(player, data)
	end
end

function PitchService.start()
	CustomerService.start(start)
	Remotes.PitchAction.OnServerEvent:Connect(onAction)

	Players.PlayerRemoving:Connect(function(player)
		local session = sessions[player]
		if session then
			sessions[player] = nil
			CustomerService.setBusy(session.customer, false)
		end
	end)

	-- Walking away or dying ends the pitch.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player, session in sessions do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local gone = not root
					or not humanoid
					or humanoid.Health <= 0
					or not session.customer.model.Parent
					or (root.Position - session.customer.root.Position).Magnitude > 28
				if gone then
					finish(player, "left", 0, "Hey! Where are you going?")
				end
			end
		end
	end)
end

return PitchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[-- The living world: harbor water, zone gates, the Wolf Speech event,
-- the chest-thump hum and the global leaderboard board.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local Remotes = ReplicatedStorage.Remotes

local WorldService = {}

local map = Workspace:WaitForChild("Map")

local function fillWater()
	local terrain = Workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(25, 70, 90)
	terrain.WaterTransparency = 0.35
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
	-- East river + harbor + the sound around Long Island, in chunks.
	for x = -760, 760, 190 do
		for z = -560, 760, 190 do
			terrain:FillBlock(CFrame.new(x, -18, z), Vector3.new(190, 30, 190), Enum.Material.Water)
			terrain:FillBlock(CFrame.new(x, -36, z), Vector3.new(190, 6, 190), Enum.Material.Sand)
		end
		task.wait()
	end
end

local function setupGates()
	local gates = map:FindFirstChild("Gates")
	if not gates then
		return
	end
	for _, zone in Config.Zones do
		local gate = zone.gate and gates:FindFirstChild(zone.gate)
		if gate then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "UnlockPrompt"
			prompt.ActionText = "Unlock (" .. Format.cash(zone.cost) .. ")"
			prompt.ObjectText = zone.name
			prompt.HoldDuration = 0.6
			prompt.MaxActivationDistance = 14
			prompt.RequiresLineOfSight = false
			prompt:SetAttribute("Zone", zone.id)
			prompt.Parent = gate
			prompt.Triggered:Connect(function(player)
				local ok, message = EconomyService.purchase(player, "zone", zone.id)
				EconomyService.notify(player, message, ok and "success" or "error")
			end)
		end
	end
end

-- The Wolf Speech ---------------------------------------------------------

local function setStage(active)
	local stage = map:FindFirstChild("SpeechStage", true)
	if not stage then
		return
	end
	for _, descendant in stage:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name == "StageLight" then
			descendant.Color = active and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 190, 60)
		elseif descendant:IsA("SpotLight") or descendant:IsA("PointLight") then
			descendant.Brightness = active and 6 or 2
		end
	end
end

local SPEECH_LINES = {
	"Let me tell you something. There's no nobility in poverty!",
	"I'm not leaving! The show goes on!",
	"Pick up the phone and start dialing!",
	"The only thing standing between you and your goal is the story you keep telling yourself!",
	"Are you behind a desk right now? Then SELL SOMETHING!",
}

local function runSpeechLoop()
	while true do
		local startsAt = os.time() + Config.Speech.interval
		Workspace:SetAttribute("SpeechAt", startsAt)
		task.wait(Config.Speech.interval - Config.Speech.warning)
		EconomyService.notifyAll(
			"The Wolf takes the stage in " .. Config.Speech.warning .. "s! Get to the Trading Floor for x"
				.. Config.Speech.floorMult .. " sales!",
			"event"
		)
		task.wait(Config.Speech.warning)

		Workspace:SetAttribute("SpeechActive", true)
		Workspace:SetAttribute("SpeechEndsAt", os.time() + Config.Speech.duration)
		Workspace:SetAttribute("SpeechLine", SPEECH_LINES[math.random(1, #SPEECH_LINES)])
		setStage(true)
		task.wait(Config.Speech.duration)
		Workspace:SetAttribute("SpeechActive", false)
		setStage(false)
		EconomyService.notifyAll("The speech is over. Back to the phones!", "info")
	end
end

-- The hum -----------------------------------------------------------------

local humCooldowns = {}

local function showHum(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("HumBubble")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "HumBubble"
	gui.Size = UDim2.fromOffset(170, 40)
	gui.StudsOffset = Vector3.new(0, 4.4, 0)
	gui.MaxDistance = 90
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = "mm-MM-mm-MM"
	label.TextColor3 = Color3.fromRGB(255, 220, 90)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = head
	task.delay(Config.Hum.duration, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

local function onHum(player)
	local now = os.clock()
	if (humCooldowns[player] or 0) > now then
		return
	end
	humCooldowns[player] = now + Config.Hum.cooldown
	player:SetAttribute("HumUntil", now + Config.Hum.duration)
	player:SetAttribute("HumReadyAt", os.time() + Config.Hum.cooldown)
	showHum(player)

	local humming = 0
	for _, other in Players:GetPlayers() do
		if (other:GetAttribute("HumUntil") or 0) > now then
			humming += 1
		end
	end
	if humming >= Config.Hum.crowdSize then
		EconomyService.notifyAll(
			string.format("%d wolves are humming! Sales x%.2f for everyone humming.", humming, Config.Hum.crowdMult),
			"event"
		)
	else
		EconomyService.notify(player, string.format("You're humming. Sales x%.1f for %ds.", Config.Hum.mult, Config.Hum.duration), "success")
	end
end

-- Leaderboard -------------------------------------------------------------

local function buildBoard(part)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Brightness = 1.4

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(8, 14, 12)
	bg.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.Text = "RICHEST WOLVES (ALL-TIME)"
	title.TextColor3 = Color3.fromRGB(255, 205, 70)
	title.Parent = bg

	local list = Instance.new("Frame")
	list.Name = "List"
	list.Position = UDim2.fromScale(0.04, 0.16)
	list.Size = UDim2.fromScale(0.92, 0.82)
	list.BackgroundTransparency = 1
	list.Parent = bg
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = list

	gui.Parent = part
	return list
end

local function refreshBoard(list)
	local top = DataService.getTopEarners(10)
	if #top == 0 then
		-- No DataStores (Studio): show the players in this server instead.
		for _, player in Players:GetPlayers() do
			local profile = DataService.get(player)
			if profile then
				table.insert(top, { name = player.DisplayName, value = profile.lifetime })
			end
		end
		table.sort(top, function(a, b)
			return a.value > b.value
		end)
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(10, #top) do
		local entry = top[rank]
		local row = Instance.new("TextLabel")
		row.LayoutOrder = rank
		row.Size = UDim2.new(1, 0, 0.09, 0)
		row.BackgroundTransparency = rank % 2 == 0 and 1 or 0.85
		row.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
		row.Font = Enum.Font.Code
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = rank == 1 and Color3.fromRGB(255, 215, 80) or Color3.fromRGB(120, 255, 160)
		row.Text = string.format(" #%-2d %-18s %s", rank, string.sub(entry.name, 1, 18), Format.cash(entry.value))
		row.Parent = list
	end
end

function WorldService.start()
	task.spawn(fillWater)
	setupGates()
	setStage(false)
	task.spawn(runSpeechLoop)

	Remotes.Hum.OnServerEvent:Connect(onHum)
	Players.PlayerRemoving:Connect(function(player)
		humCooldowns[player] = nil
	end)

	local boardPart = map:FindFirstChild("LeaderboardBoard", true)
	if boardPart then
		local list = buildBoard(boardPart)
		task.spawn(function()
			task.wait(5)
			while true do
				refreshBoard(list)
				task.wait(60)
			end
		end)
	end
end

return WorldService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="28">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="29">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="30">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="32">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI and wires up keybinds.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Format = require(ReplicatedStorage.Shared.Format)
local Store = require(script.Parent.Store)
local Theme = require(script.Parent.UI.Theme)
local Notifier = require(script.Parent.UI.Notifier)
local Hud = require(script.Parent.UI.Hud)
local Shop = require(script.Parent.UI.Shop)
local PitchUI = require(script.Parent.UI.PitchUI)
local World = require(script.Parent.World)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local screen = Theme.create("ScreenGui", {
	Name = "SellMeThisPen",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local function hum()
	Remotes.Hum:FireServer()
end

Notifier.mount(screen)
Hud.mount(screen, {
	openShop = function()
		Shop.toggleShop()
	end,
	hum = hum,
	openIPO = Shop.openIPO,
	openHelp = Shop.openHelp,
})
Shop.mount(screen)
PitchUI.mount(screen)
World.start()

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or Store.inPitch then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		Shop.toggleShop()
	elseif input.KeyCode == Enum.KeyCode.H then
		hum()
	end
end)

-- Earnings popups whenever cash jumps.
Store.Changed:Connect(function(data, previous)
	if not previous then
		return
	end
	local delta = data.profile.cash - previous.profile.cash
	-- Passive ticks are small and constant; only celebrate real sales.
	if delta > data.income * 1.5 + 1 then
		Hud.floatText("+" .. Format.cash(delta), Theme.Colors.money)
	elseif delta < -1 and data.profile.pensSold == previous.profile.pensSold then
		Hud.floatText("-" .. Format.cash(-delta), Theme.Colors.red)
	end
end)

-- First time here? Show how to play.
task.spawn(function()
	repeat
		task.wait(0.5)
	until Store.profile()
	if Store.profile().pensSold == 0 then
		task.wait(2)
		Shop.openHelp()
		Notifier.show("Walk up to anyone in the parking lot and press E. Sell them a pen.", "big")
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[-- Client-side copy of the player's profile, kept fresh by DataSync.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Store = {
	data = nil, -- { profile, income, ipoMult, nextIpoMult }
	inPitch = false,
}

local changed = Instance.new("BindableEvent")
Store.Changed = changed.Event

local dataSync = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DataSync")
dataSync.OnClientEvent:Connect(function(data)
	local previous = Store.data
	Store.data = data
	changed:Fire(data, previous)
end)
dataSync:FireServer()

function Store.profile()
	return Store.data and Store.data.profile
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="34">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Always-on HUD: cash, income, multipliers, side buttons, the speech
-- countdown and zone title cards.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.Theme)
local Store = require(script.Parent.Parent.Store)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local Hud = {}

local cashLabel, incomeLabel, multLabel, soldLabel, speechLabel, humButton
local displayedCash = 0
local root

local function sideButton(text, subtitle, color, order, onClick)
	local button = Theme.button({
		LayoutOrder = order,
		Size = UDim2.fromOffset(92, 74),
		BackgroundColor3 = Colors.panel,
		Text = "",
	}, onClick)
	Theme.corner(14).Parent = button
	Theme.stroke(color, 2).Parent = button
	Theme.label({
		Size = UDim2.new(1, -8, 0.55, 0),
		Position = UDim2.new(0, 4, 0.1, 0),
		Font = Theme.FontBlack,
		Text = text,
		TextColor3 = color,
		Parent = button,
	})
	local sub = Theme.label({
		Name = "Sub",
		Size = UDim2.new(1, -8, 0.25, 0),
		Position = UDim2.new(0, 4, 0.65, 0),
		Font = Theme.Font,
		Text = subtitle,
		TextColor3 = Colors.muted,
		Parent = button,
	})
	return button, sub
end

function Hud.floatText(text, color)
	if not root then
		return
	end
	local label = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, math.random(-60, 60), 0, 118),
		Size = UDim2.fromOffset(300, 40),
		Font = Theme.FontBlack,
		Text = text,
		TextColor3 = color or Colors.money,
		TextStrokeTransparency = 0.3,
		Parent = root,
	})
	Theme.tween(label, 1.4, { Position = label.Position - UDim2.fromOffset(0, 70), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1.5, function()
		label:Destroy()
	end)
end

function Hud.zoneCard(zone)
	if not root then
		return
	end
	local card = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 0),
		Size = UDim2.fromOffset(560, 110),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local title = Theme.label({
		Size = UDim2.new(1, 0, 0.6, 0),
		Font = Theme.FontBlack,
		Text = string.upper(zone.name),
		TextColor3 = Colors.gold,
		TextStrokeTransparency = 0.2,
		TextTransparency = 1,
		Parent = card,
	})
	local subtitle = Theme.label({
		Position = UDim2.new(0, 0, 0.62, 0),
		Size = UDim2.new(1, 0, 0.3, 0),
		Font = Theme.FontBold,
		Text = zone.subtitle,
		TextColor3 = Colors.text,
		TextStrokeTransparency = 0.4,
		TextTransparency = 1,
		Parent = card,
	})
	Theme.tween(title, 0.5, { TextTransparency = 0 })
	Theme.tween(subtitle, 0.8, { TextTransparency = 0 })
	task.delay(2.8, function()
		Theme.tween(title, 0.6, { TextTransparency = 1, TextStrokeTransparency = 1 })
		Theme.tween(subtitle, 0.6, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.7)
		card:Destroy()
	end)
end

function Hud.mount(screen, actions)
	root = screen

	-- Cash panel ----------------------------------------------------------
	local panel = Theme.create("Frame", {
		Name = "CashPanel",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(360, 86),
		BackgroundColor3 = Colors.panel,
		BackgroundTransparency = 0.05,
		Parent = screen,
	}, {
		Theme.corner(16),
		Theme.stroke(Colors.money, 2),
		Theme.gradient(Color3.fromRGB(26, 40, 32), Color3.fromRGB(12, 18, 15)),
	})
	cashLabel = Theme.label({
		Position = UDim2.new(0, 12, 0, 6),
		Size = UDim2.new(1, -24, 0, 46),
		Font = Theme.FontBlack,
		Text = "$0",
		TextColor3 = Colors.money,
		Parent = panel,
	})
	incomeLabel = Theme.label({
		Position = UDim2.new(0, 12, 0, 54),
		Size = UDim2.new(0.5, -12, 0, 22),
		Font = Theme.FontBold,
		Text = "+$0/s",
		TextColor3 = Colors.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = panel,
	})
	multLabel = Theme.label({
		Position = UDim2.new(0.5, 0, 0, 54),
		Size = UDim2.new(0.5, -12, 0, 22),
		Font = Theme.FontBold,
		Text = "x1.0",
		TextColor3 = Colors.gold,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = panel,
	})

	soldLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 100),
		Size = UDim2.fromOffset(360, 20),
		Font = Theme.Font,
		Text = "",
		TextColor3 = Colors.muted,
		TextStrokeTransparency = 0.6,
		Parent = screen,
	})

	-- Side buttons ----------------------------------------------------------
	local side = Theme.create("Frame", {
		Name = "Side",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 12, 0.5, 0),
		Size = UDim2.fromOffset(92, 330),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Theme.create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local shop = sideButton("SHOP", "[B]", Colors.money, 1, actions.openShop)
	shop.Parent = side
	local hum, humSub = sideButton("HUM", "[H]", Colors.gold, 2, actions.hum)
	hum.Parent = side
	humButton = { button = hum, sub = humSub }
	local ipo = sideButton("IPO", "Rebirth", Colors.purple, 3, actions.openIPO)
	ipo.Parent = side
	local help = sideButton("HOW?", "Tutorial", Colors.blue, 4, actions.openHelp)
	help.Parent = side

	-- Speech countdown --------------------------------------------------------
	local speech = Theme.create("Frame", {
		Name = "Speech",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(460, 40),
		BackgroundColor3 = Colors.panel,
		BackgroundTransparency = 0.15,
		Parent = screen,
	}, {
		Theme.corner(20),
		Theme.stroke(Colors.purple, 1.5),
	})
	speechLabel = Theme.label({
		Position = UDim2.new(0, 14, 0.15, 0),
		Size = UDim2.new(1, -28, 0.7, 0),
		Font = Theme.FontBold,
		Text = "",
		TextColor3 = Colors.text,
		Parent = speech,
	})

	-- Live updates ------------------------------------------------------------
	RunService.RenderStepped:Connect(function(dt)
		local profile = Store.profile()
		if not profile then
			return
		end
		local target = profile.cash
		displayedCash += (target - displayedCash) * math.min(1, dt * 8)
		if math.abs(target - displayedCash) < 1 then
			displayedCash = target
		end
		cashLabel.Text = "$" .. Format.commas(displayedCash)

		local now = os.time()
		if Workspace:GetAttribute("SpeechActive") then
			local left = (Workspace:GetAttribute("SpeechEndsAt") or now) - now
			speechLabel.Text = string.format("THE WOLF IS SPEAKING  ·  x%d sales on the floor  ·  %s", Config.Speech.floorMult, Format.time(left))
			speechLabel.TextColor3 = Colors.gold
		else
			local at = Workspace:GetAttribute("SpeechAt")
			if at then
				speechLabel.Text = "Wolf Speech in " .. Format.time(at - now) .. "  ·  Trading Floor"
			else
				speechLabel.Text = "Sell pens. Get rich."
			end
			speechLabel.TextColor3 = Colors.text
		end

		local readyAt = player:GetAttribute("HumReadyAt") or 0
		if readyAt > now then
			humButton.sub.Text = Format.time(readyAt - now)
			humButton.button.BackgroundColor3 = Colors.bg
		else
			humButton.sub.Text = "[H] boost"
			humButton.button.BackgroundColor3 = Colors.panel
		end
	end)

	Store.Changed:Connect(function(data, previous)
		local profile = data.profile
		incomeLabel.Text = "+" .. Format.cash(data.income) .. "/s"
		multLabel.Text = string.format("x%.1f IPO", data.ipoMult)
		local pen = Config.findById(Config.Pens, profile.pen)
		soldLabel.Text = string.format("%s pens sold  ·  holding: %s", Format.commas(profile.pensSold), pen and pen.name or "?")
		if not previous then
			displayedCash = profile.cash
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[-- A centered window with a title bar and a close button.

local Theme = require(script.Parent.Theme)
local Colors = Theme.Colors

local Modal = {}
Modal.__index = Modal

local openModal

-- `maxSize` is the size on a big screen; on phones the window shrinks to fit.
function Modal.new(screen, title, accent, maxSize)
	local self = setmetatable({}, Modal)
	maxSize = maxSize or Vector2.new(640, 460)
	self.frame = Theme.create("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.94, 0.88),
		BackgroundColor3 = Colors.bg,
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	}, {
		Theme.corner(18),
		Theme.stroke(accent or Colors.money, 2.5),
		Theme.create("UISizeConstraint", { MaxSize = maxSize }),
	})

	local bar = Theme.create("Frame", {
		Size = UDim2.new(1, 0, 0, 56),
		BackgroundColor3 = Colors.panel,
		ZIndex = 10,
		Parent = self.frame,
	}, {
		Theme.corner(18),
		Theme.gradient(Colors.panelLight, Colors.panel),
	})
	Theme.label({
		Position = UDim2.new(0, 20, 0, 10),
		Size = UDim2.new(1, -90, 0, 36),
		Font = Theme.FontBlack,
		Text = title,
		TextColor3 = accent or Colors.money,
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 11,
		Parent = bar,
	})
	local close = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 8),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = Colors.red,
		Font = Theme.FontBlack,
		Text = "X",
		ZIndex = 11,
		Parent = bar,
	}, function()
		self:close()
	end)
	Theme.corner(10).Parent = close

	self.content = Theme.create("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 16, 0, 66),
		Size = UDim2.new(1, -32, 1, -80),
		BackgroundTransparency = 1,
		ZIndex = 10,
		Parent = self.frame,
	})
	return self
end

function Modal:open()
	if openModal and openModal ~= self then
		openModal:close()
	end
	openModal = self
	self.frame.Visible = true
	Theme.pop(self.frame, 0.3)
	if self.onOpen then
		self.onOpen()
	end
end

function Modal:close()
	self.frame.Visible = false
	if openModal == self then
		openModal = nil
	end
end

function Modal:toggle()
	if self.frame.Visible then
		self:close()
	else
		self:open()
	end
end

function Modal.closeAll()
	if openModal then
		openModal:close()
	end
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Notifier</string>
              <string name="Source"><![CDATA[-- Stacking toast notifications on the right side of the screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(script.Parent.Theme)

local Notifier = {}

local KIND_COLORS = {
	info = Theme.Colors.blue,
	success = Theme.Colors.money,
	error = Theme.Colors.red,
	big = Theme.Colors.gold,
	event = Theme.Colors.purple,
}

local container

function Notifier.mount(screen)
	container = Theme.create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 90),
		Size = UDim2.new(0, 340, 0.6, 0),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Theme.create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
		}),
		Theme.create("UISizeConstraint", { MaxSize = Vector2.new(340, math.huge) }),
	})

	ReplicatedStorage.Remotes.Notify.OnClientEvent:Connect(Notifier.show)
end

local order = 0
function Notifier.show(text, kind)
	if not container then
		return
	end
	order += 1
	local color = KIND_COLORS[kind] or KIND_COLORS.info
	local toast = Theme.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Colors.panel,
		BackgroundTransparency = 0.08,
		Parent = container,
	}, {
		Theme.corner(10),
		Theme.stroke(color, 2),
		Theme.padding(10),
		Theme.create("Frame", {
			Size = UDim2.new(0, 4, 1, 0),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}),
		Theme.create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Font = kind == "big" and Theme.FontBlack or Theme.FontBold,
			TextSize = kind == "big" and 19 or 17,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Colors.text,
			Text = text,
		}),
	})
	Theme.pop(toast, 0.3)

	-- Keep the stack short.
	local toasts = {}
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 5 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end

	task.delay(kind == "big" and 6 or 4, function()
		if toast.Parent then
			Theme.tween(toast, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

return Notifier
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">PitchUI</string>
              <string name="Source"><![CDATA[-- The pitch minigame screen.
--
-- Flow: pick a line (1/2/3) -> stop the tonality needle (Space/click) ->
-- the customer reacts and the certainty meters move. CLOSE (C) whenever
-- you dare. X or walking away ends the pitch.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Store = require(script.Parent.Parent.Store)

local Remotes = ReplicatedStorage.Remotes
local Colors = Theme.Colors
local player = Players.LocalPlayer

local PitchUI = {}

local METERS = {
	{ key = "pen", label = "PEN", color = Colors.pen },
	{ key = "you", label = "YOU", color = Colors.you },
	{ key = "firm", label = "FIRM", color = Colors.firm },
}

local screen
local ui = {}
local session -- current pitch data
local phase = "idle" -- idle | choose | tonality | waiting | ended
local chosenIndex
local needle = { pos = 0, dir = 1, speed = 1.3, center = 0.5 }
local revealedDislikes = {}
local cameraConnection

local function playDing(pitch)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	sound.Volume = 0.5
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
	task.delay(2, function()
		sound:Destroy()
	end)
end

-- Camera ---------------------------------------------------------------------

local function startCamera(model)
	local camera = Workspace.CurrentCamera
	local character = player.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")
	local head = model and model:FindFirstChild("Head")
	if not myRoot or not head then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	local t = 0
	cameraConnection = RunService.RenderStepped:Connect(function(dt)
		if not head.Parent or not myRoot.Parent then
			return
		end
		t += dt
		-- Over-the-shoulder, slowly drifting like a film dolly shot.
		local toCustomer = (head.Position - myRoot.Position) * Vector3.new(1, 0, 1)
		if toCustomer.Magnitude < 0.1 then
			return
		end
		local forward = toCustomer.Unit
		local right = forward:Cross(Vector3.yAxis)
		local drift = math.sin(t * 0.35) * 0.6
		local eye = myRoot.Position - forward * 5 + right * (2.4 + drift) + Vector3.new(0, 2.6, 0)
		local target = head.Position + Vector3.new(0, -0.3, 0)
		local goal = CFrame.lookAt(eye, target)
		camera.CFrame = camera.CFrame:Lerp(goal, math.min(1, dt * 4))
		camera.FieldOfView += (48 - camera.FieldOfView) * math.min(1, dt * 3)
	end)
end

local function stopCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
end

-- Building blocks --------------------------------------------------------------

local function meterRow(parent, info, order)
	local row = Theme.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0, 60, 1, 0),
		Font = Theme.FontBlack,
		Text = info.label,
		TextColor3 = info.color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local track = Theme.create("Frame", {
		Position = UDim2.new(0, 66, 0.15, 0),
		Size = UDim2.new(1, -130, 0.7, 0),
		BackgroundColor3 = Colors.bg,
		Parent = row,
	}, { Theme.corner(8), Theme.stroke(Colors.stroke, 1) })
	local fill = Theme.create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = info.color,
		Parent = track,
	}, { Theme.corner(8), Theme.gradient(info.color, info.color:Lerp(Color3.new(0, 0, 0), 0.35)) })
	-- Tick marks every 2 points.
	for i = 1, 4 do
		Theme.create("Frame", {
			Position = UDim2.new(i / 5, 0, 0, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			Parent = track,
		})
	end
	local value = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 56, 1, 0),
		Font = Theme.FontBlack,
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
	return { fill = fill, value = value, row = row, track = track }
end

local function deltaPopup(meter, delta)
	if delta == 0 then
		return
	end
	local label = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -90, 0.5, 0),
		Size = UDim2.fromOffset(60, 26),
		Font = Theme.FontBlack,
		Text = (delta > 0 and "+" or "") .. tostring(delta),
		TextColor3 = delta > 0 and Colors.money or Colors.red,
		TextStrokeTransparency = 0.3,
		ZIndex = 5,
		Parent = meter.row,
	})
	Theme.tween(label, 1, { Position = label.Position - UDim2.fromOffset(0, 26), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1.1, function()
		label:Destroy()
	end)
end

local function build()
	ui.root = Theme.create("Frame", {
		Name = "Pitch",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 20,
		Parent = screen,
	})

	-- Cinematic letterbox.
	ui.barTop = Theme.create("Frame", {
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = ui.root,
	})
	ui.barBottom = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.new(1, 0, 0, 0),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BorderSizePixel = 0,
		Parent = ui.root,
	})

	-- Customer card (top left).
	local card = Theme.create("Frame", {
		Position = UDim2.new(0, 16, 0, 70),
		Size = UDim2.fromOffset(360, 250),
		BackgroundColor3 = Colors.bg,
		BackgroundTransparency = 0.08,
		Parent = ui.root,
	}, { Theme.corner(14), Theme.stroke(Colors.gold, 2), Theme.padding(14) })
	ui.name = Theme.label({
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.FontBlack,
		TextColor3 = Colors.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	ui.zone = Theme.label({
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.Font,
		TextColor3 = Colors.muted,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	local meters = Theme.create("Frame", {
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, 0, 0, 110),
		BackgroundTransparency = 1,
		Parent = card,
	}, { Theme.create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }) })
	ui.meters = {}
	for order, info in METERS do
		ui.meters[info.key] = meterRow(meters, info, order)
	end
	ui.likes = Theme.label({
		Position = UDim2.fromOffset(0, 172),
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.FontBold,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	ui.hates = Theme.label({
		Position = UDim2.fromOffset(0, 194),
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.FontBold,
		RichText = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})
	ui.estimate = Theme.label({
		Position = UDim2.fromOffset(0, 216),
		Size = UDim2.new(1, 0, 0, 18),
		Font = Theme.FontBold,
		TextColor3 = Colors.money,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = card,
	})

	-- Patience (top right of the card).
	ui.patience = Theme.create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 4),
		Size = UDim2.fromOffset(110, 20),
		BackgroundTransparency = 1,
		Parent = card,
	}, {
		Theme.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 4),
		}),
	})

	-- Customer speech (center top).
	ui.speech = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 66),
		Size = UDim2.new(0.5, 0, 0, 40),
		Font = Theme.FontBlack,
		TextColor3 = Colors.text,
		TextStrokeTransparency = 0.3,
		Parent = ui.root,
	})

	-- Bottom area: options, tonality, actions.
	local bottom = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.new(0.9, 0, 0, 250),
		BackgroundTransparency = 1,
		Parent = ui.root,
	}, { Theme.create("UISizeConstraint", { MaxSize = Vector2.new(1000, 250) }) })
	ui.bottom = bottom

	ui.options = Theme.create("Frame", {
		Size = UDim2.new(1, -190, 1, 0),
		BackgroundTransparency = 1,
		Parent = bottom,
	}, { Theme.create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }) })

	-- Tonality bar (replaces options while active).
	ui.tonality = Theme.create("Frame", {
		Size = UDim2.new(1, -190, 0, 150),
		Position = UDim2.fromOffset(0, 50),
		BackgroundColor3 = Colors.bg,
		BackgroundTransparency = 0.1,
		Visible = false,
		Parent = bottom,
	}, { Theme.corner(14), Theme.stroke(Colors.gold, 2) })
	Theme.label({
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(1, -32, 0, 28),
		Font = Theme.FontBlack,
		Text = "TONALITY!  Stop the needle in the green  [SPACE / CLICK]",
		TextColor3 = Colors.gold,
		Parent = ui.tonality,
	})
	local track = Theme.create("Frame", {
		Position = UDim2.new(0, 16, 0, 56),
		Size = UDim2.new(1, -32, 0, 44),
		BackgroundColor3 = Color3.fromRGB(80, 30, 30),
		Parent = ui.tonality,
	}, { Theme.corner(10), Theme.gradient(Color3.fromRGB(120, 40, 40), Color3.fromRGB(60, 20, 20), 0) })
	ui.sweet = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromScale(0.2, 1),
		BackgroundColor3 = Color3.fromRGB(60, 220, 110),
		Parent = track,
	}, { Theme.corner(8) })
	ui.sweetCore = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.25, 1),
		BackgroundColor3 = Color3.fromRGB(180, 255, 190),
		Parent = ui.sweet,
	}, { Theme.corner(6) })
	ui.needle = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.new(0, 6, 1, 16),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 3,
		Parent = track,
	}, { Theme.corner(3), Theme.stroke(Color3.new(0, 0, 0), 1.5) })
	ui.tonalityHint = Theme.label({
		Position = UDim2.new(0, 16, 0, 108),
		Size = UDim2.new(1, -32, 0, 26),
		Font = Theme.FontBold,
		TextColor3 = Colors.muted,
		Parent = ui.tonality,
	})
	local tonalityClick = Theme.create("TextButton", {
		Size = UDim2.fromScale(1, 1),
