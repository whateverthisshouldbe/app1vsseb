	{ id = "v126", name = "Buck Barrels", rarity = "mythic", archetype = "oil" },
	{ id = "v127", name = "Sultan of Stationery", rarity = "mythic", archetype = "oil" },
	{ id = "v128", name = "Mama Montblank", rarity = "mythic", archetype = "duchess" },
	{ id = "v129", name = "Rick Royalty", rarity = "mythic", archetype = "rockstar" },
	{ id = "v130", name = "Satoshi Penamoto", rarity = "mythic", archetype = "crypto" },
	{ id = "v131", name = "Dame Diamond Nib", rarity = "mythic", archetype = "duchess" },
	{ id = "v132", name = "Archduke Autograph", rarity = "mythic", archetype = "prince" },
	-- legendary
	{ id = "v133", name = "Donnie Azpen", rarity = "legendary", archetype = "bro" },
	{ id = "v134", name = "Mark Hannapen", rarity = "legendary", archetype = "bro" },
	{ id = "v135", name = "Naomi Lapenglia", rarity = "legendary", archetype = "duchess" },
	{ id = "v136", name = "Brad Napkinson", rarity = "legendary", archetype = "bro" },
	{ id = "v137", name = "Aunt Emma Inkwell", rarity = "legendary", archetype = "duchess" },
	{ id = "v138", name = "Mad Max Jolfort", rarity = "legendary", archetype = "accountant" },
	{ id = "v139", name = "Jean-Jacques Pensaurel", rarity = "legendary", archetype = "swiss" },
	{ id = "v140", name = "Captain Ted Tidewater", rarity = "legendary", archetype = "oil" },
	{ id = "v141", name = "Chester Ming-Pen", rarity = "legendary", archetype = "bro" },
	{ id = "v142", name = "Nicky Koskopen", rarity = "legendary", archetype = "bro" },
	-- exotic
	{ id = "v143", name = "The Golden Bull", rarity = "exotic", archetype = "oil" },
	{ id = "v144", name = "Queen of the Quills", rarity = "exotic", archetype = "prince" },
	{ id = "v145", name = "Space Baron Zorp", rarity = "exotic", archetype = "crypto" },
	{ id = "v146", name = "The Invisible Hand", rarity = "exotic", archetype = "accountant" },
	{ id = "v147", name = "The Fountain Pen of Youth", rarity = "exotic", archetype = "duchess" },
	{ id = "v148", name = "Captain Compound Interest", rarity = "exotic", archetype = "accountant" },
	{ id = "v149", name = "The Pen Pharaoh", rarity = "exotic", archetype = "prince" },
	-- ultra
	{ id = "v150", name = "Beldan Jolfort", rarity = "ultra", archetype = "wolf" },
}

Visitors.byId = {}
Visitors.byRarity = {}
for index, visitor in ipairs(Visitors) do
	visitor.number = index
	Visitors.byId[visitor.id] = visitor
	Visitors.byRarity[visitor.rarity] = Visitors.byRarity[visitor.rarity] or {}
	table.insert(Visitors.byRarity[visitor.rarity], visitor)
end

return Visitors
]]></string>
