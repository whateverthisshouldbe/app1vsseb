  <Item class="ServerScriptService" referent="29">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="30">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">AnimationService</string>
          <string name="Source"><![CDATA[-- Walk styles for players (by suit) and customers (by personality), plus
-- relaying jump flips so everyone sees them.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Animations = require(ReplicatedStorage.Shared.Animations)
local DataService = require(script.Parent.DataService)

local Remotes = ReplicatedStorage.Remotes

local AnimationService = {}

local appliedPack = {} -- [Player] = pack name currently on their character

local function setAnim(animate, folderName, animName, assetId)
	local folder = animate:FindFirstChild(folderName)
	local anim = folder and folder:FindFirstChild(animName)
	if anim and anim:IsA("Animation") then
		anim.AnimationId = Animations.id(assetId)
	end
end

-- Swap the ids inside the character's default Animate script. It reloads
-- an animation as soon as its id changes.
function AnimationService.applyToCharacter(character, packName)
	local pack = Animations.Packs[packName]
	local animate = character and character:WaitForChild("Animate", 5)
	if not pack or not animate then
		return
	end
	setAnim(animate, "walk", "WalkAnim", pack.walk)
	setAnim(animate, "run", "RunAnim", pack.run)
	setAnim(animate, "jump", "JumpAnim", pack.jump)
	setAnim(animate, "fall", "FallAnim", pack.fall)
	setAnim(animate, "climb", "ClimbAnim", pack.climb)
	setAnim(animate, "idle", "Animation1", pack.idle[1])
	setAnim(animate, "idle", "Animation2", pack.idle[2])
end

function AnimationService.refresh(player)
	appliedPack[player] = nil
	AnimationService.refreshPlayer(player)
end

function AnimationService.refreshPlayer(player)
	local profile = DataService.get(player)
	local packName = profile and Animations.BySuit[profile.suit]
	if packName and player.Character and appliedPack[player] ~= packName then
		appliedPack[player] = packName
		AnimationService.applyToCharacter(player.Character, packName)
	end
end

-- Customers are server-side, so their Animate LocalScript never runs.
-- Drive idle/walk/run from the server instead (it replicates to everyone).
function AnimationService.animateNpc(humanoid, packName)
	local pack = Animations.Packs[packName] or Animations.Packs.Rthro
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local model = humanoid.Parent
	local animate = model and model:FindFirstChild("Animate")
	if animate then
		animate:Destroy()
	end

	local function load(assetId, priority)
		local animation = Instance.new("Animation")
		animation.AnimationId = Animations.id(assetId)
		local ok, track = pcall(function()
			return animator:LoadAnimation(animation)
		end)
		if not ok then
			return nil
		end
		track.Looped = true
		track.Priority = priority
		return track
	end

	local idle = load(pack.idle[1], Enum.AnimationPriority.Idle)
	local walk = load(pack.walk, Enum.AnimationPriority.Movement)
	local run = load(pack.run, Enum.AnimationPriority.Movement)
	if not idle or not walk then
		return
	end
	idle:Play()

	local current = idle
	local function switch(track, speed)
		if current ~= track then
			current:Stop(0.25)
			track:Play(0.25)
			current = track
		end
		if speed and track ~= idle then
			track:AdjustSpeed(math.clamp(speed / (track == run and 18 or 9), 0.6, 1.6))
		end
	end
	humanoid.Running:Connect(function(speed)
		if speed > 13 and run then
			switch(run, speed)
		elseif speed > 0.5 then
			switch(walk, speed)
		else
			switch(idle)
		end
	end)
end

function AnimationService.start()
	local function onPlayer(player)
		player.CharacterAdded:Connect(function()
			appliedPack[player] = nil
			-- Let the engine apply the avatar's own animations first, then ours.
			task.wait(1)
			AnimationService.refreshPlayer(player)
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		appliedPack[player] = nil
	end)
	-- Buying a suit (or rebirthing out of one) changes your walk.
	DataService.onChanged(function(player)
		AnimationService.refreshPlayer(player)
	end)

	-- Flips: the jumper animates locally; everyone else gets told.
	local lastFlip = {}
	Remotes.Flip.OnServerEvent:Connect(function(player, kind)
		if type(kind) ~= "string" or #kind > 12 then
			return
		end
		local now = os.clock()
		if (lastFlip[player] or 0) > now - 0.4 then
			return
		end
		lastFlip[player] = now
		for _, other in Players:GetPlayers() do
			if other ~= player then
				Remotes.Flip:FireClient(other, player, kind)
			end
		end
	end)
end

return AnimationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">CustomerService</string>
          <string name="Source"><![CDATA[-- Spawns the customers that wander each zone, and gives each of them a
-- "Sell Me This Pen" prompt. PitchService takes over when one is pitched.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Visitors = require(ReplicatedStorage.Shared.Visitors)
local Animations = require(ReplicatedStorage.Shared.Animations)
local AnimationService = require(script.Parent.AnimationService)
local OutfitService = require(script.Parent.OutfitService)

local Remotes = ReplicatedStorage.Remotes

local CustomerService = {}

local customers = {} -- [Model] = state
local folder
local promptCallback

local rng = Random.new()

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

local function randomPoint(area)
	return Vector3.new(rng:NextNumber(area.minX, area.maxX), area.y + 3, rng:NextNumber(area.minZ, area.maxZ))
end

-- A point on the rim of the area: where visitors walk in from and out to.
local function edgePoint(area)
	local side = rng:NextInteger(1, 4)
	local x = rng:NextNumber(area.minX, area.maxX)
	local z = rng:NextNumber(area.minZ, area.maxZ)
	if side == 1 then
		x = area.minX
	elseif side == 2 then
		x = area.maxX
	elseif side == 3 then
		z = area.minZ
	else
		z = area.maxZ
	end
	return Vector3.new(x, area.y + 3, z)
end

local function makeSpeechBubble(head)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Speech"
	gui.Size = UDim2.fromOffset(260, 70)
	gui.StudsOffset = Vector3.new(0, 4.2, 0)
	gui.MaxDistance = 60
	gui.Enabled = false

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 12)
	corner.Parent = frame
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.fromRGB(20, 20, 20)
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = frame
	gui.Parent = head
end

local function makeNameTag(head, visitor, rarity)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.fromOffset(220, 56)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.MaxDistance = rarity.odds >= 143 and 250 or 60

	local rarityLabel = Instance.new("TextLabel")
	rarityLabel.BackgroundTransparency = 1
	rarityLabel.Size = UDim2.fromScale(1, 0.42)
	rarityLabel.Font = Enum.Font.GothamBlack
	rarityLabel.Text = string.upper(rarity.name)
	rarityLabel.TextColor3 = rarity.color
	rarityLabel.TextStrokeTransparency = 0.2
	rarityLabel.TextScaled = true
	rarityLabel.Parent = gui

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.fromScale(0, 0.42)
	label.Size = UDim2.fromScale(1, 0.58)
	label.Font = Enum.Font.GothamBold
	label.Text = visitor.name
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Parent = gui

	if rarity.id == "ultra" or rarity.id == "exotic" then
		-- Cycle the rarity label through the rainbow.
		local gradient = Instance.new("UIGradient")
		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 80)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(80, 200, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 80, 220)),
		})
		gradient.Parent = rarityLabel
		task.spawn(function()
			while gui.Parent do
				gradient.Offset = Vector2.new(math.sin(os.clock() * 2) * 0.5, 0)
				task.wait(0.05)
			end
		end)
	end
	gui.Parent = head
end

local slotOwners = {} -- door zones: [zoneId] = { [slot] = state }

local function buildCustomer(visitor, zone, fromEdge)
	local archetypeKey = visitor.archetype
	local rarity = Config.getRarity(visitor.rarity)
	local model = OutfitService.buildVisitor(visitor)
	if not model then
		return nil
	end

	model.Name = visitor.name
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = rng:NextNumber(6, 10)
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
	humanoid.MaxHealth = math.huge
	humanoid.Health = math.huge

	local head = model:WaitForChild("Head")
	makeNameTag(head, visitor, rarity)
	makeSpeechBubble(head)

	local root = model:WaitForChild("HumanoidRootPart")
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PitchPrompt"
	prompt.ActionText = "Sell Me This Pen"
	prompt.ObjectText = string.format("%s  ·  %s", visitor.name, rarity.name)
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 11
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt:SetAttribute("Zone", zone.id)
	prompt.Parent = root

	model:SetAttribute("Zone", zone.id)
	model:SetAttribute("Archetype", archetypeKey)
	model:SetAttribute("Rarity", rarity.id)
	prompt:SetAttribute("Rarity", rarity.id)
	local spawnAt
	if zone.mode == "door" then
		spawnAt = zone.door + Vector3.new(rng:NextNumber(-2, 2), 3, 0)
	elseif fromEdge then
		spawnAt = edgePoint(zone.area)
	else
		spawnAt = randomPoint(zone.area)
	end
	model:PivotTo(CFrame.new(spawnAt) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model.Parent = folder
	-- Animations can only load once the rig is in the workspace.
	AnimationService.animateNpc(humanoid, Animations.ByRarity[rarity.id] or Animations.ByArchetype[archetypeKey])
	pcall(function()
		root:SetNetworkOwner(nil)
	end)

	local state = {
		model = model,
		humanoid = humanoid,
		root = root,
		prompt = prompt,
		zone = zone,
		archetypeKey = archetypeKey,
		visitor = visitor,
		busy = false,
		leaving = false,
		-- Visitors don't hang around forever: after a while they move on.
		expiresAt = os.clock() + rng:NextNumber(Config.VisitorStay.min, Config.VisitorStay.max),
		cooldowns = {}, -- [Player] = os.clock() until they'll listen again
	}
	customers[model] = state

	prompt.Triggered:Connect(function(player)
		if promptCallback then
			promptCallback(player, state)
		end
	end)

	if zone.mode == "door" then
		-- Walk in from the elevator, take a free spot in the queue and wait.
		slotOwners[zone.id] = slotOwners[zone.id] or {}
		local owners = slotOwners[zone.id]
		for slot, position in zone.queue do
			if not owners[slot] then
				owners[slot] = state
				state.slot = slot
				task.delay(0.5, function()
					-- Through the front door first, then to the spot.
					if zone.entry then
						humanoid:MoveTo(zone.entry)
						humanoid.MoveToFinished:Wait()
					end
					humanoid:MoveTo(position)
					humanoid.MoveToFinished:Wait()
					if model.Parent and not state.busy then
						local face = Vector3.new(position.X, root.Position.Y, position.Z + 5)
						root.CFrame = CFrame.lookAt(root.Position, face)
						CustomerService.say(state, "*ding dong*  You wanted to see me?", 3)
					end
				end)
				break
			end
		end
		-- Leave once their time is up (unless someone is pitching them).
		task.spawn(function()
			while model.Parent and not state.leaving do
				task.wait(1)
				if not state.busy and os.clock() > state.expiresAt then
					CustomerService.leave(state, 0)
				end
			end
		end)
		return state
	end

	-- Wander.
	task.spawn(function()
		while model.Parent and not state.leaving do
			if not state.busy and os.clock() > state.expiresAt then
				CustomerService.leave(state, 0)
				break
			end
			if not state.busy then
				humanoid:MoveTo(randomPoint(zone.area))
				local finished = false
				local connection = humanoid.MoveToFinished:Once(function()
					finished = true
				end)
				local started = os.clock()
				while not finished and not state.busy and os.clock() - started < 9 and model.Parent do
					task.wait(0.25)
				end
				connection:Disconnect()
				if not state.busy then
					humanoid:MoveTo(root.Position)
					task.wait(rng:NextNumber(1.5, 6))
				end
			else
				task.wait(0.5)
			end
			-- Fell off the map somehow: put them back.
			if root.Position.Y < zone.area.y - 30 then
				model:PivotTo(CFrame.new(randomPoint(zone.area)))
			end
		end
	end)

	return state
end

local function spawnFor(zone, fromEdge)
	local rarity = Config.rollRarity(zone.luck, rng)
	local visitor = pick(Visitors.byRarity[rarity.id])
	local state = buildCustomer(visitor, zone, fromEdge)
	local _, rarityIndex = Config.findById(Config.Rarities, rarity.id)
	local _, announceIndex = Config.findById(Config.Rarities, Config.AnnounceRarity)
	if state and rarityIndex >= announceIndex then
		Remotes.Notify:FireAllClients(
			string.format("A %s visitor appeared at %s: %s!", string.upper(rarity.name), zone.name, visitor.name),
			"event"
		)
	end
	return state
end

function CustomerService.say(state, text, duration)
	local head = state.model:FindFirstChild("Head")
	local bubble = head and head:FindFirstChild("Speech")
	if not bubble then
		return
	end
	bubble.Frame.Text.Text = text
	bubble.Enabled = true
	local token = {}
	state.speechToken = token
	task.delay(duration or 3.5, function()
		if state.speechToken == token and bubble.Parent then
			bubble.Enabled = false
		end
	end)
end

function CustomerService.setBusy(state, busy, facePlayer)
	state.busy = busy
	state.prompt.Enabled = not busy
	if busy then
		state.humanoid:MoveTo(state.root.Position)
		local character = facePlayer and facePlayer.Character
		local other = character and character:FindFirstChild("HumanoidRootPart")
		if other then
			local look = Vector3.new(other.Position.X, state.root.Position.Y, other.Position.Z)
			if (look - state.root.Position).Magnitude > 0.1 then
				state.root.CFrame = CFrame.lookAt(state.root.Position, look)
			end
		end
	end
end

-- The customer bought (or got arrested): they leave and someone new shows up.
-- The visitor walks off (to the rim of the zone, or back out the front
-- door), fades away, and someone new walks in a moment later.
function CustomerService.leave(state, delaySeconds)
	if state.leaving then
		return
	end
	state.leaving = true
	state.busy = true
	state.prompt.Enabled = false
	customers[state.model] = nil
	if state.slot and slotOwners[state.zone.id] then
		slotOwners[state.zone.id][state.slot] = nil
	end
	task.delay(delaySeconds or 0, function()
		local model, humanoid, zone = state.model, state.humanoid, state.zone
		if model.Parent and humanoid.Parent then
			local route = zone.mode == "door" and { zone.entry, zone.door } or { edgePoint(zone.area) }
			for _, point in route do
				if point then
					humanoid:MoveTo(point)
					local finished = false
					local connection = humanoid.MoveToFinished:Once(function()
						finished = true
					end)
					local started = os.clock()
					while not finished and os.clock() - started < 8 and model.Parent do
						task.wait(0.2)
					end
					connection:Disconnect()
				end
			end
			-- Fade out.
			for _, gui in model:GetDescendants() do
				if gui:IsA("BillboardGui") then
					gui.Enabled = false
				end
			end
			for step = 1, 10 do
				for _, part in model:GetDescendants() do
					if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
						part.Transparency = math.max(part.Transparency, step / 10)
					elseif part:IsA("Decal") then
						part.Transparency = step / 10
					end
				end
				task.wait(0.05)
			end
			model:Destroy()
		end
		task.wait(rng:NextNumber(1, 3))
		spawnFor(zone, true)
	end)
end

-- Kept for callers: a sale or a bust sends the visitor on their way.
function CustomerService.replace(state, delaySeconds)
	CustomerService.leave(state, delaySeconds or 3)
end

function CustomerService.start(onPrompt)
	promptCallback = onPrompt

	folder = Instance.new("Folder")
	folder.Name = "Customers"
	folder.Parent = Workspace

	for _, zone in Config.Zones do
		for _ = 1, zone.customers do
			task.spawn(spawnFor, zone)
			task.wait(0.05)
		end
	end
end

return CustomerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- Loads, holds and saves every player's profile.
-- Works without DataStore access (e.g. an unpublished place in Studio):
-- progress then simply isn't saved.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local STORE_NAME = "SellMeThisPen_v2"
local LEADERBOARD_NAME = "SellMeThisPen_NetWorth_v2"

local store
local leaderboardStore
do
	local ok, err = pcall(function()
		store = DataStoreService:GetDataStore(STORE_NAME)
		leaderboardStore = DataStoreService:GetOrderedDataStore(LEADERBOARD_NAME)
	end)
	if not ok then
		warn("[DataService] DataStores unavailable, progress won't save:", err)
	end
end

local profiles = {} -- [Player] = profile
local loaded = {} -- [Player] = true once the load attempt finished
local changedCallbacks = {}

local function defaultProfile()
	return {
		cash = Config.StartingCash,
		lifetime = 0, -- lifetime earnings, never reset (leaderboard)
		pensSold = 0,
		ipos = 0,
		pen = "bic",
		suit = "thrift",
		phone = "none",
		brokers = {}, -- array of visitor ids, max Config.MaxBrokers
		index = {}, -- [visitorId] = times sold to
		best = nil, -- id of the rarest visitor ever sold to
		perfectCloses = 0,
		napkins = 0,
		lastOnline = 0,
		tutorialStep = 0, -- steps finished
		tutorialDone = false,
		boostUntil = 0, -- os.time() until x2 money ends
		lastDaily = 0,
	}
end

-- Fill in fields added in later versions of the game.
local function reconcile(data)
	local template = defaultProfile()
	for key, value in template do
		if data[key] == nil then
			data[key] = value
		end
	end
	-- Brokers must be a plain array of visitor ids.
	local clean = {}
	for _, id in ipairs(data.brokers) do
		if type(id) == "string" and #clean < Config.MaxBrokers then
			table.insert(clean, id)
		end
	end
	data.brokers = clean
	data.zones = nil
	return data
end

local function withRetries(fn)
	for attempt = 1, 4 do
		local ok, result = pcall(fn)
		if ok then
			return true, result
		end
		warn(string.format("[DataService] attempt %d failed: %s", attempt, tostring(result)))
		-- No API access (e.g. Studio without "Enable Studio Access to API Services"): don't bother retrying.
		local message = tostring(result)
		if message:find("403") or message:find("Studio") or message:find("publish") then
			return false, nil
		end
		task.wait(attempt * 1.5)
	end
	return false, nil
end

function DataService.onChanged(callback)
	table.insert(changedCallbacks, callback)
end

function DataService.get(player)
	return profiles[player]
end

function DataService.isLoaded(player)
	return loaded[player] == true
end

-- Call after mutating a profile so clients and leaderstats refresh.
function DataService.changed(player)
	local profile = profiles[player]
	if not profile then
		return
	end
	for _, callback in changedCallbacks do
		task.spawn(callback, player, profile)
	end
end

function DataService.addCash(player, amount)
	local profile = profiles[player]
	if not profile then
		return
	end
	profile.cash += amount
	if amount > 0 then
		profile.lifetime += amount
	end
	DataService.changed(player)
end

function DataService.load(player)
	local key = "player_" .. player.UserId
	local data
	if store then
		local ok, result = withRetries(function()
			return store:GetAsync(key)
		end)
		if ok then
			data = result
		else
			-- Don't let a failed load overwrite the real save later.
			player:SetAttribute("SaveDisabled", true)
			warn("[DataService] could not load", player.Name, "- saving disabled this session")
		end
	end
	if not player.Parent then
		return nil
	end
	local profile = reconcile(type(data) == "table" and data or defaultProfile())
	profiles[player] = profile
	loaded[player] = true
	return profile
end

function DataService.save(player)
	local profile = profiles[player]
	if not store or not profile or player:GetAttribute("SaveDisabled") then
		return
	end
	profile.lastOnline = os.time()
	local key = "player_" .. player.UserId
	withRetries(function()
		store:SetAsync(key, profile)
	end)
	if leaderboardStore then
		pcall(function()
			leaderboardStore:SetAsync(key, math.floor(profile.lifetime))
		end)
	end
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
end

function DataService.getTopEarners(count)
	if not leaderboardStore then
		return {}
	end
	local ok, pages = pcall(function()
		return leaderboardStore:GetSortedAsync(false, count)
	end)
	if not ok then
		return {}
	end
	local results = {}
	for rank, entry in pages:GetCurrentPage() do
		local userId = tonumber(string.match(entry.key, "%d+"))
		local name = "???"
		if userId then
			local nameOk, fetched = pcall(function()
				return Players:GetNameFromUserIdAsync(userId)
			end)
			if nameOk then
				name = fetched
			end
		end
		table.insert(results, { rank = rank, name = name, value = entry.value })
	end
	return results
end

function DataService.start()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for player in profiles do
				task.spawn(DataService.save, player)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait()
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- Money: multipliers, passive income, the shop, IPOs, leaderstats,
-- player titles and the pen every player carries.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Visitors = require(ReplicatedStorage.Shared.Visitors)
local Tutorial = require(ReplicatedStorage.Shared.Tutorial)
local DataService = require(script.Parent.DataService)

local Remotes = ReplicatedStorage.Remotes

local EconomyService = {}

EconomyService.Ranks = Config.Ranks

function EconomyService.notify(player, text, kind)
	Remotes.Notify:FireClient(player, text, kind or "info")
end

function EconomyService.notifyAll(text, kind)
	Remotes.Notify:FireAllClients(text, kind or "info")
end

function EconomyService.getRank(lifetime)
	local best = EconomyService.Ranks[1]
	for _, rank in EconomyService.Ranks do
		if lifetime >= rank.min then
			best = rank
		end
	end
	return best
end

function EconomyService.ipoMult(profile)
	return 1 + profile.ipos * Config.IPO.multPerIPO
end

function EconomyService.passiveIncome(profile)
	local income = 0
	local phone = Config.findById(Config.Phones, profile.phone)
	if phone then
		income += phone.income
	end
	for _, visitorId in profile.brokers do
		local visitor = Visitors.byId[visitorId]
		if visitor then
			income += Config.brokerIncome(visitor.rarity)
		end
	end
	return income * EconomyService.ipoMult(profile) * EconomyService.boostMult(profile)
end

-- The tutorial reward: temporary x2 money.
function EconomyService.boostMult(profile)
	return (profile.boostUntil or 0) > os.time() and Tutorial.RewardMult or 1
end

function EconomyService.indexCount(profile)
	local count = 0
	for id in profile.index do
		if Visitors.byId[id] then
			count += 1
		end
	end
	return count
end

function EconomyService.indexMult(profile)
	return 1 + EconomyService.indexCount(profile) * Config.IndexBonusPerVisitor
end

-- Everything that boosts a single sale, as one number plus a breakdown.
function EconomyService.saleMult(player, profile)
	local mult = EconomyService.ipoMult(profile) * EconomyService.indexMult(profile) * EconomyService.boostMult(profile)
	local suit = Config.findById(Config.Suits, profile.suit)
	if suit then
		mult *= suit.cashMult
	end
	if Workspace:GetAttribute("SpeechActive") then
		mult *= Config.Speech.mult
	end
	if (player:GetAttribute("HumUntil") or 0) > os.clock() then
		local humming = 0
		for _, other in Players:GetPlayers() do
			if (other:GetAttribute("HumUntil") or 0) > os.clock() then
				humming += 1
			end
		end
		mult *= humming >= Config.Hum.crowdSize and Config.Hum.crowdMult or Config.Hum.mult
	end
	return mult
end

local function sync(player, profile)
	Remotes.DataSync:FireClient(player, {
		profile = profile,
		income = EconomyService.passiveIncome(profile),
		ipoMult = EconomyService.ipoMult(profile),
		nextIpoMult = 1 + (profile.ipos + 1) * Config.IPO.multPerIPO,
		rebirthCost = Config.rebirthCost(profile.ipos),
		indexCount = EconomyService.indexCount(profile),
		indexMult = EconomyService.indexMult(profile),
	})

	local stats = player:FindFirstChild("leaderstats")
	if stats then
		stats.Cash.Value = Format.cash(profile.cash)
		stats["Pens Sold"].Value = profile.pensSold
		stats.Rebirths.Value = profile.ipos
	end

	local rank = EconomyService.getRank(profile.lifetime)
	if player:GetAttribute("Rank") ~= rank.title then
		player:SetAttribute("Rank", rank.title)
		EconomyService.updateTitle(player)
	end
end

local function createLeaderstats(player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Parent = stats
	local sold = Instance.new("IntValue")
	sold.Name = "Pens Sold"
	sold.Parent = stats
	local ipos = Instance.new("IntValue")
	ipos.Name = "Rebirths"
	ipos.Parent = stats
	stats.Parent = player
end

-- Overhead title: rank + IPO count.
function EconomyService.updateTitle(player)
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	local profile = DataService.get(player)
	if not head or not profile then
		return
	end
	local rank = EconomyService.getRank(profile.lifetime)
	local gui = head:FindFirstChild("RankTitle")
	if not gui then
		gui = Instance.new("BillboardGui")
		gui.Name = "RankTitle"
		gui.Size = UDim2.fromOffset(200, 50)
		gui.StudsOffset = Vector3.new(0, 2.6, 0)
		gui.MaxDistance = 80
		gui.AlwaysOnTop = false
		local label = Instance.new("TextLabel")
		label.Name = "Label"
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextStrokeTransparency = 0.3
		label.Parent = gui
		gui.Parent = head
	end
	local text = rank.title
	if profile.ipos > 0 then
		text ..= string.format("  ·  Rebirth %d", profile.ipos)
	end
	gui.Label.Text = text
	gui.Label.TextColor3 = rank.color
end

-- Every player holds their current pen.
function EconomyService.givePen(player)
	local profile = DataService.get(player)
	if not profile then
		return
	end
	local pen = Config.findById(Config.Pens, profile.pen)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return
	end

	for _, container in { backpack, player.Character } do
		if container then
			local old = container:FindFirstChild("SalesPen")
			if old then
				old:Destroy()
			end
		end
	end

	local tool = Instance.new("Tool")
	tool.Name = "SalesPen"
	tool.ToolTip = pen.name
	tool.CanBeDropped = false
	tool.GripPos = Vector3.new(0, -0.1, 0)
	tool.GripForward = Vector3.new(0, 0, -1)
	tool.GripUp = Vector3.new(0, 1, 0)
	tool:SetAttribute("PenName", pen.name)

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.18, 1.4, 0.18)
	handle.Color = pen.color
	handle.Material = pen.id == "diamond" and Enum.Material.Glass or Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Cylinder
	mesh.Parent = handle
	handle.Parent = tool

	local cap = Instance.new("Part")
	cap.Name = "Cap"
	cap.Size = Vector3.new(0.22, 0.4, 0.22)
	cap.Color = pen.id == "gold" and Color3.fromRGB(255, 230, 140) or Color3.fromRGB(230, 200, 90)
	cap.Material = Enum.Material.Metal
	cap.CanCollide = false
	cap.Massless = true
	cap.CFrame = handle.CFrame * CFrame.new(0, 0.55, 0)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = cap
	weld.Parent = cap
	cap.Parent = tool

	if pen.id == "wolf" or pen.id == "diamond" then
		local sparkle = Instance.new("Sparkles")
		sparkle.SparkleColor = pen.color
		sparkle.Parent = handle
	end

	tool.Parent = backpack
end

local CATEGORY_LISTS = {
	pen = Config.Pens,
	suit = Config.Suits,
	phone = Config.Phones,
}

function EconomyService.purchase(player, category, id)
	local profile = DataService.get(player)
	if not profile or type(category) ~= "string" or type(id) ~= "string" then
		return false, "Not ready yet."
	end

	if CATEGORY_LISTS[category] then
		local list = CATEGORY_LISTS[category]
		local item, index = Config.findById(list, id)
		local _, currentIndex = Config.findById(list, profile[category])
		if not item then
			return false, "Unknown item."
		end
		if index <= (currentIndex or 0) then
			return false, "You already own something better."
		end
		if profile.cash < item.cost then
			return false, "Not enough cash. Go sell some pens!"
		end
		profile.cash -= item.cost
		profile[category] = id
		DataService.changed(player)
		if category == "pen" then
			EconomyService.givePen(player)
		end
		return true, "Bought " .. item.name .. "!"
	end
	return false, "Unknown category."
end

local function teleportTo(player, position)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.new(position)
	end
end

function EconomyService.teleport(player, zoneId)
	local profile = DataService.get(player)
	local zone = type(zoneId) == "string" and Config.getZone(zoneId)
	if not profile or not zone then
		return false, "Unknown zone."
	end
	if player:GetAttribute("InPitch") then
		return false, "Finish your pitch first."
	end
	if not Config.zoneUnlocked(profile, zone.id) then
		return false, string.format("%s needs %d rebirths.", zone.name, zone.rebirths)
	end
	teleportTo(player, zone.tp)
	return true, "Welcome to " .. zone.name .. "."
end

local function rebirth(player)
	local profile = DataService.get(player)
	if not profile then
		return false, "Not ready yet."
	end
	local cost = Config.rebirthCost(profile.ipos)
	if profile.cash < cost then
		return false, "You need " .. Format.cash(cost) .. " to rebirth."
	end
	local before = {}
	for _, zone in Config.Zones do
		before[zone.id] = Config.zoneUnlocked(profile, zone.id)
	end

	profile.ipos += 1
	profile.cash = Config.StartingCash
	profile.pen = "bic"
	profile.suit = "thrift"
	profile.phone = "none"
	DataService.changed(player)
	EconomyService.givePen(player)
	EconomyService.updateTitle(player)

	EconomyService.notifyAll(
		string.format("%s just took the firm public! (Rebirth %d)", player.DisplayName, profile.ipos),
		"big"
	)
	-- New zone? Take them straight there.
	for _, zone in Config.Zones do
		if not before[zone.id] and Config.zoneUnlocked(profile, zone.id) then
			teleportTo(player, zone.tp)
			task.delay(1, EconomyService.notify, player, "NEW ZONE UNLOCKED: " .. zone.name .. "!", "big")
		end
	end
	return true, string.format("Rebirth complete! Permanent x%.1f multiplier.", EconomyService.ipoMult(profile))
end

-- A visitor joins your firm. When the firm is full the weakest broker is
-- replaced (only if the new one earns more).
function EconomyService.recruit(player, visitorId)
	local profile = DataService.get(player)
	local visitor = Visitors.byId[visitorId]
	if not profile or not visitor then
		return false
	end
	if #profile.brokers >= Config.MaxBrokers then
		local weakestIndex, weakestIncome = nil, math.huge
		for index, id in profile.brokers do
			local other = Visitors.byId[id]
			local income = other and Config.brokerIncome(other.rarity) or 0
			if income < weakestIncome then
				weakestIndex, weakestIncome = index, income
			end
		end
		if not weakestIndex or weakestIncome >= Config.brokerIncome(visitor.rarity) then
			return false
		end
		table.remove(profile.brokers, weakestIndex)
	end
	table.insert(profile.brokers, visitorId)
	DataService.changed(player)
	return true
end

-- The weakest broker a new recruit would replace, if the firm is full.
function EconomyService.weakestBroker(profile)
	if #profile.brokers < Config.MaxBrokers then
		return nil
	end
	local weakest, weakestIncome = nil, math.huge
	for _, id in profile.brokers do
		local visitor = Visitors.byId[id]
		local income = visitor and Config.brokerIncome(visitor.rarity) or 0
		if income < weakestIncome then
			weakest, weakestIncome = visitor, income
		end
	end
	return weakest
end

local function fireBroker(player, slot)
	local profile = DataService.get(player)
	slot = tonumber(slot)
	if not profile or not slot or not profile.brokers[slot] then
		return false, "No broker in that seat."
	end
	local visitor = Visitors.byId[profile.brokers[slot]]
	table.remove(profile.brokers, slot)
	DataService.changed(player)
	return true, (visitor and visitor.name or "Broker") .. " cleared out their desk."
end

-- Tutorial progress. The client reports each finished step in order; the
-- server saves it and pays the reward at the end.
local function onTutorial(player, stepId)
	local profile = DataService.get(player)
	if not profile or profile.tutorialDone or type(stepId) ~= "string" then
		return
	end
	if stepId == "reset" then
		-- A pitch fell through before the deal: start the pitch part again.
		if profile.tutorialStep < Tutorial.byId.deal.index then
			profile.tutorialStep = 0
			DataService.changed(player)
		end
		return
	end
	local step = Tutorial.byId[stepId]
	if not step or step.index ~= profile.tutorialStep + 1 then
		return
	end
	if step.id == "shop" and profile.pen == "bic" then
		return
	end
	profile.tutorialStep = step.index

	local nextStep = Tutorial.Steps[step.index + 1]
	if nextStep and nextStep.id == "shop" and profile.pen == "bic" then
		-- Make sure they can afford the pen the tutorial asks for.
		local pen = Config.findById(Config.Pens, Tutorial.ShopTarget)
		if profile.cash < pen.cost then
			profile.cash = pen.cost
		end
	end
	if step.index == #Tutorial.Steps then
		profile.tutorialDone = true
		profile.boostUntil = os.time() + Tutorial.RewardDuration
		EconomyService.notify(
			player,
			string.format("TUTORIAL COMPLETE! x%d money for %d minutes. Go get rich.", Tutorial.RewardMult, Tutorial.RewardDuration / 60),
			"big"
		)
	end
	DataService.changed(player)
end

function EconomyService.onPlayerLoaded(player, profile)
	createLeaderstats(player)

	-- Offline earnings from phones and brokers.
	if profile.lastOnline > 0 then
		local away = math.clamp(os.time() - profile.lastOnline, 0, Config.OfflineEarningsCap)
		local earned = math.floor(EconomyService.passiveIncome(profile) * away * Config.OfflineEarningsRate)
		if earned > 0 then
			DataService.addCash(player, earned)
			task.delay(3, EconomyService.notify, player, "Your brokers made " .. Format.cash(earned) .. " while you were away.", "big")
		end
	end

	-- Daily bonus.
	if os.time() - profile.lastDaily >= Config.DailyBonusCooldown then
		profile.lastDaily = os.time()
		local bonus = math.max(250, math.floor(EconomyService.passiveIncome(profile) * 300))
		DataService.addCash(player, bonus)
		task.delay(5, EconomyService.notify, player, "Daily bonus: " .. Format.cash(bonus) .. ". Rise and grind.", "big")
	end

	sync(player, profile)

	local function onCharacter(character)
		character:WaitForChild("Head")
		task.wait(0.2)
		EconomyService.givePen(player)
		EconomyService.updateTitle(player)
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end
end

function EconomyService.start()
	DataService.onChanged(sync)

	Remotes.Purchase.OnServerInvoke = function(player, category, id)
		local ok, message = EconomyService.purchase(player, category, id)
		return ok, message
	end
	Remotes.IPO.OnServerInvoke = rebirth
	Remotes.Teleport.OnServerInvoke = EconomyService.teleport
	Remotes.FireBroker.OnServerInvoke = fireBroker
	Remotes.Tutorial.OnServerEvent:Connect(onTutorial)
	-- The client asks for a snapshot once its UI is listening.
	Remotes.DataSync.OnServerEvent:Connect(function(player)
		local profile = DataService.get(player)
		if profile then
			sync(player, profile)
		end
	end)

	-- Passive income tick.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				local profile = DataService.get(player)
				if profile then
					local income = EconomyService.passiveIncome(profile)
					if income > 0 then
						DataService.addCash(player, income)
					end
				end
			end
		end
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="35">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server entry point.

local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local PitchService = require(script.Parent.PitchService)
local WorldService = require(script.Parent.WorldService)
local AnimationService = require(script.Parent.AnimationService)
local OutfitService = require(script.Parent.OutfitService)

DataService.start()
EconomyService.start()
PitchService.start()
WorldService.start()
AnimationService.start()
OutfitService.start(function(player)
	local profile = DataService.get(player)
	return profile and profile.suit or "thrift"
end)
-- Buying a suit (or rebirthing out of one) changes what you wear.
DataService.onChanged(function(player, profile)
	OutfitService.suitChanged(player, profile.suit)
end)

local function onPlayerAdded(player)
	local profile = DataService.load(player)
	if profile then
		EconomyService.onPlayerLoaded(player, profile)
		AnimationService.refresh(player)
		OutfitService.suitChanged(player, profile.suit)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in Players:GetPlayers() do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	DataService.release(player)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">OutfitService</string>
          <string name="Source"><![CDATA[-- Dresses people. Visitors get a look built from their personality and
-- rarity (the same visitor always looks the same, in the world and in the
-- Index preview), and players wear the suit they bought.
--
-- Visitors wear real Roblox catalog items (clothing, hair, hats, glasses,
-- necklaces, faces), every id checked against the Roblox catalog API. A
-- few welded props (briefcases, coffee, capes...) go on top. If catalog
-- items ever fail to load, the visitor falls back to an outfit built
-- entirely from welded parts, so nobody spawns naked.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Visitors = require(ReplicatedStorage.Shared.Visitors)

local Remotes = ReplicatedStorage.Remotes

local OutfitService = {}

-- Real catalog items (verified via economy.roblox.com asset details).
local C = {
	-- Classic shirts
	greySuit = 6554200369, -- Grey Suit w/ Black Vest
	whiteSuit = 6553589977, -- White Suit w/ Black Vest
	crimsonSuit = 6554202849, -- Crimson Suit w/ Black Vest
	redSuit = 7152018398, -- Red Suit w/ Black Vest
	purpleSuit = 6554199135, -- Purple Suit w/ Black Vest
	pinkSuit = 6554219952, -- Pink Suit w/ Black Vest
	orangeSuit = 6554208237, -- Orange Suit w/ Black Vest
	tuxedo = 88519549662877, -- Tuxedo
	motorcycle = 144076358, -- Blue and Black Motorcycle Shirt (Roblox)
	robloxJacket = 607785314, -- ROBLOX Jacket (Roblox)
	denimHoodie = 398633584, -- Denim Jacket with White Hoodie (Roblox)
	stripedDenim = 144076436, -- Grey Striped Shirt with Denim Jacket (Roblox)
	bluePlaid = 398635081, -- Blue Plaid Shirt (Roblox)
	tealShirt = 382537702, -- Teal Shirt (Roblox)
	pizzaShirt = 382537085, -- I <3 Pizza Shirt (Roblox)
	guitarTee = 382538295, -- Guitar Tee with Black Jacket (Roblox)
	greenJersey = 382538059, -- Green Jersey (Roblox)
	pastelTop = 398634295, -- Pastel Starburst Top with Gray Jacket (Roblox)
	-- Classic pants
	blackSlacks = 129459077, -- Black Slacks (Roblox)
	greySuitPants = 6555797786, -- Grey Suit w/ Black Vest [-]
	whiteSuitPants = 6555794614, -- White Suit 'n' Black Vest [-]
	darkGreenJeans = 144076760, -- (Roblox)
	beautifulJeans = 398634487, -- Beautiful You Jeans (Roblox)
	blackJeansShoes = 398633812, -- Black Jeans with White Shoes (Roblox)
	skaterPants = 398635338, -- Ripped Skater Pants (Roblox)
	jeanShorts = 382537806, -- Jean Shorts (Roblox)
	blackJeans = 382537569, -- Black Jeans (Roblox)
	jeans = 129458426, -- Jeans (Roblox)
	-- Hair
	palHair = 63690008,
	trueBlue = 451221329,
	brownCharmer = 376548738,
	blondeSpiked = 376524487,
	straightBlonde = 376526888,
	blackPonytail = 376527350,
	lavenderUpdo = 451220849,
	beautifulHair = 16630147,
	belleRed = 2956239660,
	flamingMohawk = 191101707,
	mangaHero = 398672920,
	goldenHair = 13476917,
	longBlack = 1772372988,
	pigtails = 11913660,
	shaggy2 = 417457139,
	-- Hats
	fedora = 1029025, -- The Classic ROBLOX Fedora
	businessHat = 19027209, -- Perfectly Legitimate Business Hat
	blackCowboy = 425117435, -- Fancy Black Cowboy Hat
	brownCowboy = 1029597,
	robloxCap = 607702162,
	redCap = 48474313,
	blueTopHat = 1016145591,
	goldenCrown = 1081300,
	royalCrown = 10159600649, -- 8-Bit Royal Crown
	robotBeanie = 215724779,
	moneyHeadphones = 283751750,
	extremeHeadphones = 96079043,
	-- Face accessories
	stylishAviators = 376526673,
	goldenAviators = 63247316,
	silverAviators = 134823161,
	orangeShades = 376527500,
	midnightShades = 30331986,
	blingShades = 44114585,
	shutterShades = 15318115,
	monocle = 30390853,
	-- Neck / back
	businessTie = 30111567, -- BC Business Tie
	blueTie = 28503039,
	jadeNecklace = 376527115,
	dogTags = 31312480,
	lanyard = 30200246,
	scarf = 99860652,
	axeGuitar = 1230404580, -- Back Axe Guitar
	-- Faces
	smile = 144075659,
	manFace = 86487700,
	womanFace = 86487766,
	sillyFun = 7699174,
	stare = 8560971,
	err = 20418658,
	freckles = 12145366,
	surprised = 7317773,
	suspicious = 209994929,
}
OutfitService.Catalog = C

-- What each personality wears. Every visitor picks one item per slot from
-- their pool, seeded by their number (so the same visitor always looks the
-- same). hatChance / faceAccChance: odds of wearing one at all. `props` are
-- welded extras that still get added on top of the catalog outfit.
local WARDROBE = {
	tourist = { shirt = { C.tealShirt, C.pizzaShirt, C.bluePlaid, C.greenJersey }, pants = { C.jeanShorts, C.jeans }, hair = { C.palHair, C.blondeSpiked, C.straightBlonde, C.brownCharmer }, hat = { C.robloxCap, C.redCap }, hatChance = 0.6, faceAcc = { C.orangeShades }, faceAccChance = 0.5, faces = { C.smile, C.sillyFun, C.surprised }, props = { "camera" } },
	plumber = { shirt = { C.bluePlaid }, pants = { C.jeans, C.darkGreenJeans }, hair = { C.palHair, C.shaggy2 }, hat = { C.redCap }, hatChance = 1, faces = { C.manFace, C.err }, props = { "toolbelt", "mustache" } },
	dentist = { shirt = { C.tealShirt, C.stripedDenim }, pants = { C.blackSlacks }, hair = { C.brownCharmer, C.shaggy2, C.beautifulHair }, faces = { C.smile, C.stare }, props = { "coat", "headmirror", "glasses" } },
	mom = { shirt = { C.pastelTop, C.tealShirt }, pants = { C.beautifulJeans }, hair = { C.lavenderUpdo, C.blackPonytail, C.belleRed, C.straightBlonde }, neck = { C.jadeNecklace }, neckChance = 0.5, faces = { C.womanFace, C.freckles }, props = { "purse" } },
	intern = { shirt = { C.denimHoodie, C.stripedDenim }, pants = { C.blackJeans, C.skaterPants }, hair = { C.palHair, C.shaggy2, C.mangaHero }, neck = { C.lanyard }, neckChance = 1, faces = { C.err, C.surprised, C.smile }, props = { "coffee" } },
	accountant = { shirt = { C.greySuit }, pants = { C.greySuitPants }, hair = { C.brownCharmer, C.palHair }, neck = { C.businessTie }, neckChance = 0.6, faces = { C.stare, C.manFace }, props = { "glasses", "briefcase" } },
	shoes = { shirt = { C.purpleSuit, C.pinkSuit, C.orangeSuit }, pants = { C.blackSlacks, C.whiteSuitPants }, hair = { C.flamingMohawk, C.goldenHair }, faceAcc = { C.blingShades, C.shutterShades }, faceAccChance = 0.8, faces = { C.sillyFun, C.smile }, props = { "platforms" } },
	bro = { shirt = { C.greySuit, C.crimsonSuit, C.redSuit }, pants = { C.blackSlacks, C.greySuitPants }, hair = { C.brownCharmer, C.blondeSpiked, C.mangaHero }, faceAcc = { C.stylishAviators, C.silverAviators }, faceAccChance = 0.7, faces = { C.manFace, C.smile }, props = { "watch" } },
	swiss = { shirt = { C.tuxedo, C.greySuit }, pants = { C.blackSlacks }, hair = { C.brownCharmer, C.straightBlonde }, hat = { C.businessHat, C.fedora }, hatChance = 0.35, faceAcc = { C.monocle }, faceAccChance = 0.6, faces = { C.stare, C.manFace }, props = { "briefcase" } },
	duchess = { shirt = { C.pastelTop, C.pinkSuit }, pants = { C.beautifulJeans }, hair = { C.lavenderUpdo, C.beautifulHair, C.belleRed }, hat = { C.blueTopHat }, hatChance = 0.3, neck = { C.jadeNecklace }, neckChance = 0.7, faces = { C.womanFace }, props = { "dress", "pearls" } },
	oil = { shirt = { C.whiteSuit }, pants = { C.whiteSuitPants }, hair = { C.palHair }, hat = { C.blackCowboy, C.brownCowboy }, hatChance = 1, faceAcc = { C.goldenAviators }, faceAccChance = 0.6, faces = { C.manFace }, props = { "bolo", "watch", "mustache" } },
	fbi = { shirt = { C.tuxedo, C.greySuit }, pants = { C.blackSlacks }, hair = { C.brownCharmer, C.palHair }, faceAcc = { C.midnightShades }, faceAccChance = 1, faces = { C.suspicious }, props = { "earpiece" } },
	crypto = { shirt = { C.denimHoodie, C.robloxJacket, C.motorcycle }, pants = { C.blackJeansShoes, C.skaterPants }, hair = { C.mangaHero, C.palHair }, hat = { C.robotBeanie, C.moneyHeadphones }, hatChance = 0.8, faceAcc = { C.shutterShades }, faceAccChance = 0.6, faces = { C.sillyFun, C.surprised }, props = { "chain" } },
	influencer = { shirt = { C.pastelTop, C.pinkSuit }, pants = { C.beautifulJeans }, hair = { C.straightBlonde, C.belleRed, C.longBlack, C.pigtails }, faceAcc = { C.orangeShades }, faceAccChance = 0.5, faces = { C.womanFace, C.smile }, props = { "phone" } },
	rockstar = { shirt = { C.guitarTee, C.motorcycle }, pants = { C.skaterPants, C.blackJeans }, hair = { C.flamingMohawk, C.mangaHero, C.shaggy2 }, hat = { C.extremeHeadphones }, hatChance = 0.2, neck = { C.dogTags }, neckChance = 0.7, back = { C.axeGuitar }, backChance = 1, faces = { C.sillyFun, C.err } },
	prince = { shirt = { C.crimsonSuit, C.purpleSuit }, pants = { C.whiteSuitPants }, hair = { C.goldenHair, C.brownCharmer }, hat = { C.royalCrown }, hatChance = 1, faces = { C.smile, C.stare }, props = { "cape", "sash" } },
	wolf = { shirt = { C.tuxedo }, pants = { C.blackSlacks }, hair = { C.brownCharmer }, faceAcc = { C.goldenAviators }, faceAccChance = 1, neck = { C.businessTie }, neckChance = 1, faces = { C.manFace }, props = { "watch", "chain" } },
}

local SKIN_TONES = {
	Color3.fromRGB(255, 220, 190),
	Color3.fromRGB(240, 195, 160),
	Color3.fromRGB(215, 160, 120),
	Color3.fromRGB(175, 120, 85),
	Color3.fromRGB(130, 85, 60),
	Color3.fromRGB(95, 60, 45),
}
local HAIR_COLORS = {
	Color3.fromRGB(30, 22, 18),
	Color3.fromRGB(70, 45, 25),
	Color3.fromRGB(120, 75, 35),
	Color3.fromRGB(215, 175, 95),
	Color3.fromRGB(160, 60, 30),
	Color3.fromRGB(200, 200, 205),
}
local GOLD = Color3.fromRGB(255, 200, 60)
local WHITE = Color3.fromRGB(245, 245, 240)
local BLACK = Color3.fromRGB(20, 20, 22)

-- Personality looks. jacket = torso/arm color, pants = legs, extras = the
-- welded pieces added on top.
local LOOKS = {
	tourist = { jackets = { Color3.fromRGB(255, 120, 170), Color3.fromRGB(80, 200, 220), Color3.fromRGB(255, 190, 60) }, pants = { Color3.fromRGB(90, 150, 220), Color3.fromRGB(200, 180, 140) }, hair = { "short", "pal", "cap" }, extras = { "camera", "shades" }, shorts = true },
	plumber = { jackets = { Color3.fromRGB(40, 80, 170) }, pants = { Color3.fromRGB(40, 80, 170) }, hair = { "cap" }, hatColor = Color3.fromRGB(200, 40, 40), extras = { "toolbelt", "mustache" } },
	dentist = { jackets = { WHITE }, pants = { Color3.fromRGB(90, 110, 130) }, hair = { "side", "bald", "short" }, extras = { "coat", "headmirror", "glasses" } },
	mom = { jackets = { Color3.fromRGB(120, 200, 180), Color3.fromRGB(230, 150, 160), Color3.fromRGB(180, 150, 220) }, pants = { Color3.fromRGB(60, 60, 90) }, hair = { "long", "bun" }, extras = { "purse", "pearls" } },
	intern = { jackets = { WHITE }, pants = { Color3.fromRGB(40, 40, 60), Color3.fromRGB(80, 70, 60) }, hair = { "pal", "messy", "short" }, extras = { "looseTie", "lanyard", "coffee" } },
	accountant = { jackets = { Color3.fromRGB(110, 110, 115), Color3.fromRGB(80, 75, 70) }, pants = { Color3.fromRGB(80, 80, 85) }, hair = { "side", "bald" }, extras = { "suit", "glasses", "briefcase" } },
	shoes = { jackets = { Color3.fromRGB(150, 50, 200), Color3.fromRGB(230, 60, 120), Color3.fromRGB(40, 180, 160) }, pants = { BLACK }, hair = { "slick", "mohawk" }, extras = { "suit", "shades", "platforms" } },
	bro = { jackets = { Color3.fromRGB(25, 35, 70), Color3.fromRGB(35, 35, 40) }, pants = { Color3.fromRGB(25, 30, 55) }, hair = { "slick", "spiky" }, extras = { "suit", "aviators", "watch" } },
	swiss = { jackets = { Color3.fromRGB(20, 20, 25) }, pants = { Color3.fromRGB(20, 20, 25) }, hair = { "side", "slick" }, extras = { "suit", "monocle", "briefcase" } },
	duchess = { jackets = { Color3.fromRGB(200, 170, 230), Color3.fromRGB(240, 200, 210), Color3.fromRGB(170, 220, 200) }, pants = nil, hair = { "updo" }, extras = { "dress", "bigHat", "pearls" } },
	oil = { jackets = { Color3.fromRGB(215, 190, 150) }, pants = { Color3.fromRGB(120, 90, 60) }, hair = { "cowboy" }, extras = { "suit", "bolo", "watch", "mustache" } },
	fbi = { jackets = { BLACK }, pants = { BLACK }, hair = { "short", "side" }, extras = { "suit", "shades", "earpiece" } },
	crypto = { jackets = { Color3.fromRGB(35, 35, 40), Color3.fromRGB(60, 60, 70) }, pants = { Color3.fromRGB(90, 90, 100) }, hair = { "beanie" }, extras = { "hood", "neonShades", "chain" } },
	influencer = { jackets = { Color3.fromRGB(255, 170, 210), Color3.fromRGB(255, 240, 150) }, pants = { WHITE }, hair = { "long", "bun" }, extras = { "phone", "shades" } },
	rockstar = { jackets = { BLACK }, pants = { Color3.fromRGB(30, 30, 60) }, hair = { "mohawk", "long" }, extras = { "leather", "guitar", "chain" } },
	prince = { jackets = { Color3.fromRGB(120, 30, 60), Color3.fromRGB(30, 50, 120) }, pants = { Color3.fromRGB(240, 235, 220) }, hair = { "side", "short" }, extras = { "cape", "sash" } },
	wolf = { jackets = { BLACK }, pants = { BLACK }, hair = { "slick" }, extras = { "wolfsuit", "aviators", "watch", "chain" } },
}

-- Player suits (see Config.Suits). The thrift suit leaves your own avatar alone.
-- `shirt`/`pants` are real catalog clothing; the colors are the fallback
-- look if the clothing can't be loaded.
OutfitService.SuitStyles = {
	rack = { shirtId = 6554200369, pantsId = 6555797786, jacket = Color3.fromRGB(110, 110, 118), pants = Color3.fromRGB(95, 95, 102), shirt = WHITE, tie = Color3.fromRGB(40, 60, 140) },
	tailored = { shirtId = 6554202849, pantsId = 129459077, jacket = Color3.fromRGB(120, 20, 35), pants = Color3.fromRGB(20, 20, 24), shirt = WHITE, tie = Color3.fromRGB(20, 20, 24), pocket = WHITE },
	silk = { shirtId = 6553589977, pantsId = 6555794614, jacket = Color3.fromRGB(235, 235, 230), pants = Color3.fromRGB(235, 235, 230), shirt = Color3.fromRGB(30, 30, 35), tie = GOLD, pocket = GOLD, sheen = true },
	wolfsuit = { shirtId = 88519549662877, pantsId = 129459077, faceAccId = 63247316, jacket = Color3.fromRGB(12, 12, 14), pants = Color3.fromRGB(12, 12, 14), shirt = WHITE, bowtie = BLACK, lapelTrim = GOLD, pocket = GOLD, extras = { "watch", "chain" } },
}

-- Building blocks -------------------------------------------------------------

local function piece(model, anchorName, size, offset, color, material, shape)
	local anchor = model:FindFirstChild(anchorName)
	if not anchor then
		return nil
	end
	local part = Instance.new("Part")
	part.Name = "Outfit"
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	if shape then
		part.Shape = shape
	end
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = anchor.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = anchor
	weld.Part1 = part
	weld.Parent = part
	part.Parent = model:FindFirstChild("OutfitPieces") or model
	return part
end

local function dims(model, name)
	local part = model:FindFirstChild(name)
	return part and part.Size or Vector3.new(1, 1, 1)
end

local function front(model, name, inset)
	return -dims(model, name).Z / 2 - (inset or 0.03)
end

local function tie(model, color, loose)
	local t = dims(model, "UpperTorso")
	piece(model, "UpperTorso", Vector3.new(0.28, 0.2, 0.08), CFrame.new(0, t.Y * 0.36, front(model, "UpperTorso", 0.05)), color)
	piece(model, "UpperTorso", Vector3.new(0.3, t.Y * 0.62, 0.06), CFrame.new(loose and 0.06 or 0, t.Y * 0.02, front(model, "UpperTorso", 0.05)) * CFrame.Angles(0, 0, loose and 0.15 or 0), color, Enum.Material.Fabric)
end

local function suit(model, style)
	local t = dims(model, "UpperTorso")
	local z = front(model, "UpperTorso", 0.02)
	-- Shirt showing through the jacket, then the two lapels forming a V.
	piece(model, "UpperTorso", Vector3.new(t.X * 0.34, t.Y * 0.9, 0.04), CFrame.new(0, t.Y * 0.05, z), style.shirt or WHITE)
	for side = -1, 1, 2 do
		piece(model, "UpperTorso", Vector3.new(t.X * 0.16, t.Y * 0.62, 0.06), CFrame.new(side * t.X * 0.15, t.Y * 0.18, z - 0.02) * CFrame.Angles(0, 0, side * -0.32), style.lapelTrim or style.jacket)
		piece(model, "UpperTorso", Vector3.new(0.14, 0.14, 0.05), CFrame.new(side * 0.05, -t.Y * 0.28, z - 0.02), style.lapelTrim and GOLD or BLACK, Enum.Material.Metal, Enum.PartType.Ball)
	end
	if style.bowtie then
		for side = -1, 1, 2 do
			piece(model, "UpperTorso", Vector3.new(0.3, 0.22, 0.08), CFrame.new(side * 0.14, t.Y * 0.36, z - 0.06) * CFrame.Angles(0, 0, side * 0.3), style.bowtie)
		end
	elseif style.tie then
		tie(model, style.tie)
	end
	if style.pocket then
		piece(model, "UpperTorso", Vector3.new(0.28, 0.12, 0.05), CFrame.new(-t.X * 0.3, t.Y * 0.2, z - 0.03), style.pocket)
	end
end

local function hair(model, style, color)
	local h = dims(model, "Head")
	local top = h.Y / 2
	if style == "bald" then
		return
	elseif style == "short" or style == "side" or style == "messy" then
		piece(model, "Head", Vector3.new(h.X * 1.04, h.Y * 0.22, h.Z * 1.06), CFrame.new(0, top - h.Y * 0.04, 0.02), color)
		piece(model, "Head", Vector3.new(h.X * 1.04, h.Y * 0.5, h.Z * 0.2), CFrame.new(0, top - h.Y * 0.28, h.Z * 0.46), color)
		if style == "side" then
			piece(model, "Head", Vector3.new(h.X * 0.5, h.Y * 0.12, h.Z * 0.4), CFrame.new(h.X * 0.22, top + h.Y * 0.06, -h.Z * 0.28), color)
		elseif style == "messy" then
			for i = -1, 1 do
				piece(model, "Head", Vector3.new(0.25, 0.3, 0.25), CFrame.new(i * 0.3, top + 0.12, i * 0.1) * CFrame.Angles(0.4 * i, 0, 0.5 * i), color)
			end
		end
	elseif style == "slick" then
		piece(model, "Head", Vector3.new(h.X * 1.05, h.Y * 0.2, h.Z * 1.08), CFrame.new(0, top - h.Y * 0.02, 0.04), color, Enum.Material.Glass)
		piece(model, "Head", Vector3.new(h.X * 1.05, h.Y * 0.55, h.Z * 0.22), CFrame.new(0, top - h.Y * 0.3, h.Z * 0.46), color, Enum.Material.Glass)
		piece(model, "Head", Vector3.new(h.X * 0.9, h.Y * 0.14, h.Z * 0.5), CFrame.new(0, top + h.Y * 0.08, -h.Z * 0.2) * CFrame.Angles(-0.25, 0, 0), color, Enum.Material.Glass)
	elseif style == "spiky" then
		piece(model, "Head", Vector3.new(h.X * 1.04, h.Y * 0.18, h.Z * 1.04), CFrame.new(0, top - h.Y * 0.02, 0.02), color)
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			piece(model, "Head", Vector3.new(0.22, 0.45, 0.22), CFrame.new(math.cos(a) * 0.3, top + 0.15, math.sin(a) * 0.3) * CFrame.Angles(math.sin(a) * 0.5, 0, -math.cos(a) * 0.5), color)
		end
	elseif style == "mohawk" then
		piece(model, "Head", Vector3.new(0.22, 0.55, h.Z * 1.05), CFrame.new(0, top + 0.18, 0.05), color, Enum.Material.Neon)
	elseif style == "long" then
		piece(model, "Head", Vector3.new(h.X * 1.06, h.Y * 0.22, h.Z * 1.08), CFrame.new(0, top - h.Y * 0.03, 0.03), color)
		piece(model, "Head", Vector3.new(h.X * 1.1, h.Y * 1.5, h.Z * 0.25), CFrame.new(0, -h.Y * 0.15, h.Z * 0.5), color)
		for side = -1, 1, 2 do
			piece(model, "Head", Vector3.new(0.18, h.Y * 1.1, h.Z * 0.6), CFrame.new(side * h.X * 0.54, -h.Y * 0.05, h.Z * 0.15), color)
		end
	elseif style == "bun" or style == "updo" then
		piece(model, "Head", Vector3.new(h.X * 1.05, h.Y * 0.24, h.Z * 1.07), CFrame.new(0, top - h.Y * 0.03, 0.03), color)
		piece(model, "Head", Vector3.new(0.7, 0.7, 0.7), CFrame.new(0, top + (style == "updo" and 0.3 or 0.05), h.Z * 0.35), color, nil, Enum.PartType.Ball)
	elseif style == "cap" then
		piece(model, "Head", Vector3.new(h.X * 1.08, h.Y * 0.32, h.Z * 1.08), CFrame.new(0, top - h.Y * 0.02, 0), color)
		piece(model, "Head", Vector3.new(h.X * 0.9, 0.08, h.Z * 0.55), CFrame.new(0, top - h.Y * 0.15, -h.Z * 0.7), color)
	elseif style == "beanie" then
		piece(model, "Head", Vector3.new(h.X * 1.1, h.Y * 0.45, h.Z * 1.1), CFrame.new(0, top - h.Y * 0.06, 0), color, Enum.Material.Fabric)
		piece(model, "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, top + h.Y * 0.2, 0), WHITE, Enum.Material.Fabric, Enum.PartType.Ball)
	elseif style == "cowboy" then
		piece(model, "Head", Vector3.new(0.12, h.X * 2, h.X * 2), CFrame.new(0, top + 0.02, 0) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Fabric, Enum.PartType.Cylinder)
		piece(model, "Head", Vector3.new(h.X * 0.95, h.Y * 0.45, h.Z * 0.95), CFrame.new(0, top + h.Y * 0.22, 0), color, Enum.Material.Fabric)
		piece(model, "Head", Vector3.new(h.X * 0.97, 0.1, h.Z * 0.97), CFrame.new(0, top + 0.08, 0), Color3.fromRGB(60, 40, 25))
	end
end

local function extra(model, name, look)
	local h = dims(model, "Head")
	local t = dims(model, "UpperTorso")
	local faceZ = front(model, "Head", 0.02)
	if name == "shades" or name == "aviators" or name == "neonShades" then
		local lens = name == "neonShades" and Color3.fromRGB(0, 255, 200) or BLACK
		local material = name == "neonShades" and Enum.Material.Neon or Enum.Material.Glass
		for side = -1, 1, 2 do
			piece(model, "Head", Vector3.new(0.4, name == "aviators" and 0.3 or 0.22, 0.06), CFrame.new(side * 0.24, h.Y * 0.1, faceZ), lens, material)
		end
		piece(model, "Head", Vector3.new(0.9, 0.05, 0.05), CFrame.new(0, h.Y * 0.18, faceZ), name == "aviators" and GOLD or BLACK, Enum.Material.Metal)
	elseif name == "glasses" then
		for side = -1, 1, 2 do
			local lens = piece(model, "Head", Vector3.new(0.34, 0.26, 0.04), CFrame.new(side * 0.24, h.Y * 0.1, faceZ), Color3.fromRGB(180, 220, 240), Enum.Material.Glass)
			if lens then
				lens.Transparency = 0.4
			end
		end
		piece(model, "Head", Vector3.new(0.84, 0.05, 0.05), CFrame.new(0, h.Y * 0.2, faceZ), BLACK)
	elseif name == "monocle" then
		piece(model, "Head", Vector3.new(0.05, 0.3, 0.3), CFrame.new(0.24, h.Y * 0.1, faceZ) * CFrame.Angles(0, math.pi / 2, 0), GOLD, Enum.Material.Metal, Enum.PartType.Cylinder)
	elseif name == "headmirror" then
		piece(model, "Head", Vector3.new(0.06, 0.45, 0.45), CFrame.new(0, h.Y * 0.38, faceZ) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(220, 230, 240), Enum.Material.Glass, Enum.PartType.Cylinder)
	elseif name == "mustache" then
		piece(model, "Head", Vector3.new(0.55, 0.12, 0.06), CFrame.new(0, -h.Y * 0.12, faceZ), Color3.fromRGB(60, 40, 25))
	elseif name == "earpiece" then
		piece(model, "Head", Vector3.new(0.1, 0.2, 0.1), CFrame.new(h.X * 0.52, 0, 0), BLACK)
	elseif name == "bigHat" then
		piece(model, "Head", Vector3.new(0.1, h.X * 2.4, h.X * 2.4), CFrame.new(0, h.Y * 0.5, 0) * CFrame.Angles(0, 0, math.pi / 2), look.jacket, Enum.Material.Fabric, Enum.PartType.Cylinder)
		piece(model, "Head", Vector3.new(0.4, h.X * 1.05, h.X * 1.05), CFrame.new(0, h.Y * 0.68, 0) * CFrame.Angles(0, 0, math.pi / 2), look.jacket, Enum.Material.Fabric, Enum.PartType.Cylinder)
		piece(model, "Head", Vector3.new(0.3, 0.3, 0.3), CFrame.new(0.5, h.Y * 0.8, -0.3), Color3.fromRGB(255, 120, 150), Enum.Material.Fabric, Enum.PartType.Ball)
	elseif name == "pearls" then
		piece(model, "UpperTorso", Vector3.new(t.X * 0.5, 0.12, 0.08), CFrame.new(0, t.Y * 0.38, front(model, "UpperTorso", 0.04)), WHITE, Enum.Material.SmoothPlastic)
	elseif name == "chain" then
		piece(model, "UpperTorso", Vector3.new(t.X * 0.55, 0.14, 0.08), CFrame.new(0, t.Y * 0.3, front(model, "UpperTorso", 0.06)), GOLD, Enum.Material.Foil)
		piece(model, "UpperTorso", Vector3.new(0.26, 0.26, 0.08), CFrame.new(0, t.Y * 0.12, front(model, "UpperTorso", 0.07)), GOLD, Enum.Material.Foil, Enum.PartType.Ball)
	elseif name == "watch" then
		local hand = model:FindFirstChild("LeftLowerArm")
		if hand then
			piece(model, "LeftLowerArm", Vector3.new(hand.Size.X * 1.1, 0.2, hand.Size.Z * 1.1), CFrame.new(0, -hand.Size.Y * 0.35, 0), GOLD, Enum.Material.Foil)
		end
	elseif name == "camera" then
		piece(model, "UpperTorso", Vector3.new(0.6, 0.4, 0.3), CFrame.new(0, -t.Y * 0.1, front(model, "UpperTorso", 0.18)), BLACK)
		piece(model, "UpperTorso", Vector3.new(0.26, 0.26, 0.2), CFrame.new(0, -t.Y * 0.1, front(model, "UpperTorso", 0.38)), Color3.fromRGB(60, 60, 60), Enum.Material.Glass, Enum.PartType.Ball)
	elseif name == "toolbelt" then
		piece(model, "LowerTorso", Vector3.new(dims(model, "LowerTorso").X * 1.08, 0.25, dims(model, "LowerTorso").Z * 1.1), CFrame.new(0, 0.1, 0), Color3.fromRGB(110, 70, 35), Enum.Material.Leather)
	elseif name == "coat" then
		for side = -1, 1, 2 do
			piece(model, "LowerTorso", Vector3.new(0.9, 1.5, 0.1), CFrame.new(side * 0.5, -0.6, front(model, "LowerTorso", 0.02)), WHITE, Enum.Material.Fabric)
		end
	elseif name == "purse" or name == "briefcase" then
		local color = name == "purse" and Color3.fromRGB(180, 50, 80) or Color3.fromRGB(70, 45, 25)
		piece(model, "RightHand", Vector3.new(0.35, 0.9, 1.2), CFrame.new(0, -0.55, 0), color, Enum.Material.Leather)
		piece(model, "RightHand", Vector3.new(0.38, 0.1, 0.3), CFrame.new(0, -0.08, 0), GOLD, Enum.Material.Metal)
	elseif name == "coffee" then
		piece(model, "RightHand", Vector3.new(0.5, 0.35, 0.35), CFrame.new(0, -0.1, -0.2) * CFrame.Angles(0, 0, math.pi / 2), WHITE, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	elseif name == "phone" then
		piece(model, "RightHand", Vector3.new(0.1, 0.6, 0.35), CFrame.new(0, -0.3, -0.1), BLACK, Enum.Material.Glass)
	elseif name == "lanyard" then
		piece(model, "UpperTorso", Vector3.new(0.3, 0.38, 0.05), CFrame.new(0.35, -t.Y * 0.05, front(model, "UpperTorso", 0.05)), Color3.fromRGB(80, 150, 230))
	elseif name == "looseTie" then
		tie(model, Color3.fromRGB(200, 40, 40), true)
	elseif name == "bolo" then
		piece(model, "UpperTorso", Vector3.new(0.22, 0.22, 0.06), CFrame.new(0, t.Y * 0.28, front(model, "UpperTorso", 0.06)), Color3.fromRGB(60, 200, 190), Enum.Material.Neon, Enum.PartType.Ball)
		piece(model, "LowerTorso", Vector3.new(0.5, 0.35, 0.08), CFrame.new(0, 0.15, front(model, "LowerTorso", 0.06)), GOLD, Enum.Material.Foil)
	elseif name == "hood" then
		piece(model, "UpperTorso", Vector3.new(t.X * 0.7, t.Y * 0.5, 0.35), CFrame.new(0, t.Y * 0.5, t.Z * 0.55), look.jacket, Enum.Material.Fabric)
	elseif name == "leather" then
		for side = -1, 1, 2 do
			piece(model, "UpperTorso", Vector3.new(t.X * 0.14, t.Y * 0.7, 0.06), CFrame.new(side * t.X * 0.18, t.Y * 0.1, front(model, "UpperTorso", 0.04)) * CFrame.Angles(0, 0, side * -0.25), Color3.fromRGB(10, 10, 10), Enum.Material.Leather)
		end
		piece(model, "UpperTorso", Vector3.new(t.X * 0.3, t.Y * 0.9, 0.04), CFrame.new(0, t.Y * 0.02, front(model, "UpperTorso", 0.02)), Color3.fromRGB(200, 40, 40), Enum.Material.Fabric)
	elseif name == "guitar" then
		piece(model, "UpperTorso", Vector3.new(1.2, 2.2, 0.3), CFrame.new(0, -0.2, t.Z * 0.5 + 0.2) * CFrame.Angles(0, 0, 0.6), Color3.fromRGB(200, 30, 40))
		piece(model, "UpperTorso", Vector3.new(0.2, 1.6, 0.15), CFrame.new(0.9, 1.1, t.Z * 0.5 + 0.2) * CFrame.Angles(0, 0, 0.6), Color3.fromRGB(60, 40, 25), Enum.Material.Wood)
	elseif name == "cape" then
		piece(model, "UpperTorso", Vector3.new(t.X * 1.1, t.Y * 2.2, 0.1), CFrame.new(0, -t.Y * 0.55, t.Z * 0.56), Color3.fromRGB(170, 20, 40), Enum.Material.Fabric)
		piece(model, "UpperTorso", Vector3.new(t.X * 1.12, 0.25, t.Z * 1.2), CFrame.new(0, t.Y * 0.5, 0), WHITE, Enum.Material.Fabric)
	elseif name == "sash" then
		piece(model, "UpperTorso", Vector3.new(0.3, t.Y * 1.2, 0.06), CFrame.new(0, 0, front(model, "UpperTorso", 0.04)) * CFrame.Angles(0, 0, 0.6), Color3.fromRGB(60, 120, 220), Enum.Material.Fabric)
	elseif name == "dress" then
		local lt = dims(model, "LowerTorso")
		piece(model, "LowerTorso", Vector3.new(lt.X * 1.5, 2, lt.Z * 1.6), CFrame.new(0, -0.9, 0), look.jacket, Enum.Material.Fabric)
	elseif name == "platforms" then
		for _, foot in { "LeftFoot", "RightFoot" } do
			local size = dims(model, foot)
			piece(model, foot, Vector3.new(size.X * 1.1, 0.5, size.Z * 1.1), CFrame.new(0, -size.Y / 2 - 0.2, 0), GOLD, Enum.Material.Foil)
		end
	elseif name == "suit" then
		suit(model, { jacket = look.jacket, shirt = WHITE, tie = look.tie, pocket = look.pocket })
	elseif name == "wolfsuit" then
		suit(model, OutfitService.SuitStyles.wolfsuit)
	end
end

-- Rarer visitors get auras, crowns and glows on top of their outfit.
local function decorate(model, rarity)
	local head = model:FindFirstChild("Head")
	if not head then
		return
	end
	local id = rarity.id
	if id == "mythic" or id == "legendary" or id == "exotic" or id == "ultra" then
		extra(model, "chain", {})
	end
	if id == "exotic" then
		local h = head.Size
		local crown = piece(model, "Head", Vector3.new(h.X * 0.9, 0.45, h.Z * 0.9), CFrame.new(0, h.Y / 2 + 0.45, 0), id == "exotic" and rarity.color or GOLD, Enum.Material.Foil)
		if crown then
			for i = 0, 4 do
				local a = i / 5 * math.pi * 2
				piece(model, "Head", Vector3.new(0.15, 0.3, 0.15), CFrame.new(math.cos(a) * h.X * 0.38, h.Y / 2 + 0.8, math.sin(a) * h.Z * 0.38), GOLD, Enum.Material.Foil)
			end
		end
	end
	if id == "exotic" or id == "ultra" then
		local halo = piece(model, "Head", Vector3.new(0.12, 1.5, 1.5), CFrame.new(0, head.Size.Y / 2 + 1.1, 0) * CFrame.Angles(0, 0, math.pi / 2), id == "ultra" and GOLD or rarity.color, Enum.Material.Neon, Enum.PartType.Cylinder)
		if halo then
			halo.Transparency = 0.2
		end
	end
	local root = model:FindFirstChild("HumanoidRootPart")
	if root and id ~= "common" and id ~= "rare" then
		local aura = Instance.new("ParticleEmitter")
		aura.Name = "Aura"
		aura.Color = ColorSequence.new(rarity.color)
		aura.LightEmission = 0.8
		aura.Size = NumberSequence.new(0.35, 0)
		aura.Lifetime = NumberRange.new(0.8, 1.4)
		aura.Speed = NumberRange.new(0.5, 1.5)
		aura.SpreadAngle = Vector2.new(180, 180)
		aura.Rate = ({ superrare = 6, epic = 12, mythic = 20, legendary = 30, exotic = 45, ultra = 80 })[id] or 5
		aura.Parent = root
		if id == "legendary" or id == "exotic" or id == "ultra" then
			local glow = Instance.new("PointLight")
			glow.Color = id == "ultra" and Color3.fromRGB(255, 230, 150) or rarity.color
			glow.Brightness = 2
			glow.Range = 14
			glow.Parent = root
		end
		if id == "ultra" then
			local sparkles = Instance.new("Sparkles")
			sparkles.SparkleColor = GOLD
			sparkles.Parent = root
		end
	end
end

local function pick(seeded, list)
	return list[seeded:NextInteger(1, #list)]
end

-- Everything about a visitor's look, decided by their number alone.
function OutfitService.lookFor(visitor)
	local seeded = Random.new(visitor.number * 7919)
	local base = LOOKS[visitor.archetype] or LOOKS.tourist
	local jacket = pick(seeded, base.jackets)
	local look = {
		skin = pick(seeded, SKIN_TONES),
		hairColor = pick(seeded, HAIR_COLORS),
		hair = pick(seeded, base.hair),
		jacket = jacket,
		pants = base.pants and pick(seeded, base.pants) or jacket,
		tie = pick(seeded, { Color3.fromRGB(200, 30, 40), GOLD, Color3.fromRGB(40, 70, 170), Color3.fromRGB(20, 120, 70) }),
		pocket = seeded:NextNumber() < 0.5 and WHITE or nil,
		extras = base.extras,
		shorts = base.shorts,
		hatColor = base.hatColor,
		height = seeded:NextNumber(0.92, 1.08),
		width = seeded:NextNumber(0.9, 1.12),
	}
	-- Catalog outfit.
	local wardrobe = WARDROBE[visitor.archetype] or WARDROBE.tourist
	local function slot(pool, chance)
		local wear = pool and seeded:NextNumber() < (chance or 1)
		return wear and pick(seeded, pool) or nil
	end
	look.catalog = {
		shirt = slot(wardrobe.shirt),
		pants = slot(wardrobe.pants),
		hair = slot(wardrobe.hair),
		hat = slot(wardrobe.hat, wardrobe.hatChance),
		faceAcc = slot(wardrobe.faceAcc, wardrobe.faceAccChance),
		neck = slot(wardrobe.neck, wardrobe.neckChance),
		back = slot(wardrobe.back, wardrobe.backChance),
		face = slot(wardrobe.faces),
	}
	look.props = wardrobe.props or {}
	-- Legendary visitors wear a real gold crown.
	if visitor.rarity == "legendary" then
		look.catalog.hat = C.goldenCrown
	end
	return look
end

-- Build a visitor's rig. Nothing game-specific (prompts, tags) is added.
function OutfitService.buildVisitor(visitor)
	local look = OutfitService.lookFor(visitor)
	local rarity = Config.getRarity(visitor.rarity)

	local function describe(withCatalog)
		local description = Instance.new("HumanoidDescription")
		description.HeadColor = look.skin
		description.TorsoColor = look.jacket
		description.LeftArmColor = look.jacket
		description.RightArmColor = look.jacket
		description.LeftLegColor = look.shorts and look.skin or look.pants
		description.RightLegColor = look.shorts and look.skin or look.pants
		description.HeightScale = look.height
		description.WidthScale = look.width
		if withCatalog then
			local c = look.catalog
			description.Shirt = c.shirt or 0
			description.Pants = c.pants or 0
			description.Face = c.face or 0
			description.HairAccessory = c.hair and tostring(c.hair) or ""
			description.HatAccessory = c.hat and tostring(c.hat) or ""
			description.FaceAccessory = c.faceAcc and tostring(c.faceAcc) or ""
			description.NeckAccessory = c.neck and tostring(c.neck) or ""
			description.BackAccessory = c.back and tostring(c.back) or ""
		end
		return description
	end

	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(describe(true), Enum.HumanoidRigType.R15)
	end)
	local dressed = ok and model ~= nil
	if not ok or not model then
		-- A catalog item failed to load: build without them.
		ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(describe(false), Enum.HumanoidRigType.R15)
		end)
	end
	if not ok or not model then
		warn("[OutfitService] could not build", visitor.name, model)
		return nil
	end
	model.Name = visitor.name

	local pieces = Instance.new("Folder")
	pieces.Name = "OutfitPieces"
	pieces.Parent = model

	for _, name in { "LeftHand", "RightHand" } do
		local hand = model:FindFirstChild(name)
		if hand then
			hand.Color = look.skin
		end
	end
	if look.shorts then
		for _, name in { "LeftUpperLeg", "RightUpperLeg" } do
			local leg = model:FindFirstChild(name)
			if leg then
				leg.Color = look.pants
			end
		end
	end
	for _, name in { "LeftFoot", "RightFoot" } do
		local foot = model:FindFirstChild(name)
		if foot then
			foot.Color = Color3.fromRGB(30, 25, 22)
		end
	end
	if dressed then
		-- Real clothes on: just the props on top.
		for _, name in look.props do
			extra(model, name, look)
		end
	else
		-- Fallback: the all-parts outfit.
		hair(model, look.hair == "pal" and "messy" or look.hair, look.hatColor or look.hairColor)
		for _, name in look.extras do
			extra(model, name, look)
		end
	end
	decorate(model, rarity)
	return model
end

-- Players ------------------------------------------------------------------------

local originals = {} -- [Player] = HumanoidDescription they spawned with
local wearing = {} -- [Player] = suit id currently on the avatar

local CLOTHING_LAYERS = {
	[Enum.AccessoryType.Shirt] = true,
	[Enum.AccessoryType.TShirt] = true,
	[Enum.AccessoryType.Jacket] = true,
	[Enum.AccessoryType.Sweater] = true,
	[Enum.AccessoryType.Pants] = true,
	[Enum.AccessoryType.Shorts] = true,
	[Enum.AccessoryType.DressSkirt] = true,
}

-- Put the player's current suit on their avatar (the thrift suit = their own clothes).
function OutfitService.dressPlayer(player, suitId)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local original = originals[player]
	if not original then
		local ok, applied = pcall(function()
			return humanoid:GetAppliedDescription()
		end)
		if not ok then
			return
		end
		original = applied
		originals[player] = original
	end

	wearing[player] = suitId
	local old = character:FindFirstChild("OutfitPieces")
	if old then
		old:Destroy()
	end
	local style = OutfitService.SuitStyles[suitId]

	-- Strip layered clothing (it would sit on top of the suit).
	local function withoutClothingLayers(description)
		local ok, accessories = pcall(function()
			return description:GetAccessories(true)
		end)
		if ok then
			local kept = {}
			for _, accessory in accessories do
				if not CLOTHING_LAYERS[accessory.AccessoryType] then
					table.insert(kept, accessory)
				end
			end
			pcall(function()
				description:SetAccessories(kept, true)
			end)
		end
	end

	local function tryApply(description)
		return pcall(function()
			humanoid:ApplyDescription(description)
		end)
	end

	if not style then
		tryApply(original:Clone())
		return
	end

	-- First choice: the real suit from the catalog.
	local description = original:Clone()
	withoutClothingLayers(description)
	description.Shirt = style.shirtId or 0
	description.Pants = style.pantsId or 0
	description.GraphicTShirt = 0
	if style.faceAccId then
		local current = description.FaceAccessory
		description.FaceAccessory = current ~= "" and (current .. "," .. style.faceAccId) or tostring(style.faceAccId)
	end
	local realClothes = style.shirtId ~= nil and tryApply(description)

	if not realClothes then
		-- Fallback: color the body like a suit and build the details from parts.
		description = original:Clone()
		withoutClothingLayers(description)
		description.Shirt = 0
		description.Pants = 0
		description.GraphicTShirt = 0
		description.TorsoColor = style.jacket
		description.LeftArmColor = style.jacket
		description.RightArmColor = style.jacket
		description.LeftLegColor = style.pants
		description.RightLegColor = style.pants
		if not tryApply(description) then
			return
		end
	end

	local pieces = Instance.new("Folder")
	pieces.Name = "OutfitPieces"
	pieces.Parent = character
	if not realClothes then
		for _, name in { "LeftHand", "RightHand" } do
			local hand = character:FindFirstChild(name)
			if hand then
				hand.Color = original.HeadColor
			end
		end
		suit(character, style)
		if style.sheen then
			for _, name in { "UpperTorso", "LowerTorso", "LeftUpperArm", "RightUpperArm", "LeftLowerArm", "RightLowerArm" } do
				local part = character:FindFirstChild(name)
				if part then
					part.Reflectance = 0.12
				end
			end
		end
	end
	for _, name in style.extras or {} do
		extra(character, name, {})
	end
end

-- Index previews ------------------------------------------------------------------

local previewFolder
local previewBuilding = {}

local function getPreview(_, visitorId)
	local visitor = type(visitorId) == "string" and Visitors.byId[visitorId]
	if not visitor then
		return nil
	end
	local existing = previewFolder:FindFirstChild(visitor.id)
	if existing then
		return existing
	end
	if previewBuilding[visitor.id] then
		while previewBuilding[visitor.id] do
			task.wait(0.1)
		end
		return previewFolder:FindFirstChild(visitor.id)
	end
	previewBuilding[visitor.id] = true
	local model = OutfitService.buildVisitor(visitor)
	if model then
		model.Name = visitor.id
		for _, descendant in model:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
			elseif descendant:IsA("Script") or descendant:IsA("LocalScript") or descendant:IsA("ParticleEmitter") or descendant:IsA("Sparkles") then
				descendant:Destroy()
			end
		end
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
		model:PivotTo(CFrame.new(0, 0, 0))
		model.Parent = previewFolder
	end
	previewBuilding[visitor.id] = nil
	return model
end

-- Called on every profile change; only redresses when the suit changed.
function OutfitService.suitChanged(player, suitId)
	if player.Character and wearing[player] ~= nil and wearing[player] ~= suitId then
		task.spawn(OutfitService.dressPlayer, player, suitId)
	end
end

function OutfitService.start(getSuit)
	previewFolder = Instance.new("Folder")
	previewFolder.Name = "VisitorPreviews"
	previewFolder.Parent = ReplicatedStorage
	Remotes.GetPreview.OnServerInvoke = getPreview

	local function onPlayer(player)
		player.CharacterAdded:Connect(function(character)
			originals[player] = nil
			wearing[player] = nil
			character:WaitForChild("Humanoid")
			-- Let the avatar finish loading before we dress it.
			task.wait(1.2)
			if player.Character == character then
				OutfitService.dressPlayer(player, getSuit(player))
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		originals[player] = nil
		wearing[player] = nil
	end)
end

return OutfitService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">PitchService</string>
          <string name="Source"><![CDATA[-- The pitch minigame. Server-authoritative: the client only picks one of
-- the offered lines (plus how well it hit the tonality bar) or tries to close.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local PitchData = require(ReplicatedStorage.Shared.PitchData)
local Format = require(ReplicatedStorage.Shared.Format)
local Visitors = require(ReplicatedStorage.Shared.Visitors)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local CustomerService = require(script.Parent.CustomerService)

local Remotes = ReplicatedStorage.Remotes

local PitchService = {}

local sessions = {} -- [Player] = session
local pendingDeals = {} -- [Player] = { amount, visitorId, token }
local rng = Random.new()

local METERS = { "pen", "you", "firm" }
local MAX = Config.Pitch.meterMax

local function pick(list)
	return list[rng:NextInteger(1, #list)]
end

local function contains(list, value)
	return table.find(list, value) ~= nil
end

local function closeChance(meters)
	local minimum = math.min(meters.pen, meters.you, meters.firm) / MAX
	local average = (meters.pen + meters.you + meters.firm) / (3 * MAX)
	if minimum >= 1 then
		return 1
	end
	return math.clamp(0.08 + 0.9 * (0.6 * minimum + 0.4 * average), 0.05, 0.97)
end

local function drawOptions(session)
	local options = {}
	local usedTags = {}
	local badCount = 0
	local attempts = 0
	while #options < 3 and attempts < 100 do
		attempts += 1
		local line = pick(PitchData.Lines)
		if not usedTags[line.tag] and not (line.bad and badCount >= 1) then
			usedTags[line.tag] = true
			if line.bad then
				badCount += 1
			end
			table.insert(options, line)
		end
	end
	if not session.napkinUsed and rng:NextNumber() < Config.Pitch.napkinChance then
		options[rng:NextInteger(1, #options)] = PitchData.Napkin
	end
	-- Shuffle so the napkin isn't always in the same slot.
	for i = #options, 2, -1 do
		local j = rng:NextInteger(1, i)
		options[i], options[j] = options[j], options[i]
	end
	session.options = options
end

local function payoutFor(session, profile, player)
	local pen = Config.findById(Config.Pens, profile.pen)
	local rarity = Config.getRarity(session.visitor.rarity)
	local m = session.meters
	local average = (m.pen + m.you + m.firm) / (3 * MAX)
	local quality = 0.5 + 1.5 * average
	local perfect = m.pen >= MAX and m.you >= MAX and m.firm >= MAX
	local amount = pen.value * session.zone.budgetMult * rarity.mult * quality
	if perfect then
		amount *= Config.Pitch.perfectCloseBonus
	end
	amount *= EconomyService.saleMult(player, profile)
	return math.max(1, math.floor(amount)), perfect
end

local function snapshot(session)
	local options = {}
	for _, line in session.options do
		table.insert(options, { text = line.text, tag = line.tag, napkin = line.napkin == true })
	end
	return {
		meters = session.meters,
		patience = session.patience,
		maxPatience = session.maxPatience,
		options = options,
		closeChance = closeChance(session.meters),
	}
end

local function finish(player, result, amount, line, extra)
	local session = sessions[player]
	if not session then
		return
	end
	sessions[player] = nil
	player:SetAttribute("InPitch", nil)
	local customer = session.customer

	local payload = {
		result = result,
		amount = amount or 0,
		line = line,
		perfect = extra and extra.perfect or false,
		napkin = extra and extra.napkin or false,
	}
	if extra and extra.deal then
		for key, value in extra.deal do
			payload[key] = value
		end
	end
	Remotes.PitchEnd:FireClient(player, payload)

	if result == "deal" or result == "busted" or result == "walked" then
		-- Sold, busted or not interested: they say their piece and walk on.
		if line then
			CustomerService.say(customer, line, 3)
		end
		CustomerService.replace(customer, 3.2)
	else
		if line then
			CustomerService.say(customer, line, 3)
		end
		customer.cooldowns[player] = os.clock() + Config.Pitch.rejectCooldown
		CustomerService.setBusy(customer, false)
	end
end

local function start(player, customer)
	local profile = DataService.get(player)
	if not profile or sessions[player] or pendingDeals[player] or customer.busy then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - customer.root.Position).Magnitude > 16 then
		return
	end
	if not Config.zoneUnlocked(profile, customer.zone.id) then
		EconomyService.notify(player, string.format("%s needs %d rebirths.", customer.zone.name, customer.zone.rebirths), "error")
		return
	end
	local cooldown = customer.cooldowns[player]
	if cooldown and cooldown > os.clock() then
		CustomerService.say(customer, "I already said no, pal.", 2)
		return
	end

	local archetype = PitchData.Archetypes[customer.archetypeKey]
	local visitor = customer.visitor
	local rarity, rarityIndex = Config.findById(Config.Rarities, visitor.rarity)
	local suit = Config.findById(Config.Suits, profile.suit)
	local meters = {}
	-- Rarer visitors are tougher to convince.
	local toughness = (rarityIndex - 1) * 0.25
	for _, key in METERS do
		local value = Config.Pitch.startMeter + suit.startBonus - toughness + rng:NextNumber(-1, 1) * Config.Pitch.startJitter
		meters[key] = math.clamp(math.floor(value * 2 + 0.5) / 2, 0, MAX)
	end

	local session = {
		player = player,
		customer = customer,
		zone = customer.zone,
		archetypeKey = customer.archetypeKey,
		visitor = visitor,
		meters = meters,
		patience = Config.Pitch.patience,
		maxPatience = Config.Pitch.patience,
		lastAction = os.clock(),
		usedTags = {},
		napkinUsed = false,
	}
	drawOptions(session)
	sessions[player] = session
	player:SetAttribute("InPitch", true)
	CustomerService.setBusy(customer, true, player)
	local greeting = pick(archetype.greeting)
	CustomerService.say(customer, greeting, 4)

	local pen = Config.findById(Config.Pens, profile.pen)
	local data = snapshot(session)
	data.customer = {
		name = visitor.name,
		personality = archetype.name,
		key = customer.archetypeKey,
		visitorId = visitor.id,
		rarity = rarity.id,
		greeting = greeting,
		likes = archetype.likes,
		dislikes = archetype.dislikes,
		budget = rarity.mult * customer.zone.budgetMult,
		zone = customer.zone.name,
	}
	data.pen = pen.name
	data.estimate = math.floor(pen.value * customer.zone.budgetMult * rarity.mult * EconomyService.saleMult(player, profile))
	data.sweetSpot = suit.sweetSpot
	data.tags = PitchData.Tags
	data.model = customer.model
	Remotes.PitchStart:FireClient(player, data)
end

local function applyLine(session, line, tonality)
	local archetype = PitchData.Archetypes[session.archetypeKey]
	local liked = contains(archetype.likes, line.tag)
	local disliked = contains(archetype.dislikes, line.tag)
	local tonalityMult = 0.4 + 1.1 * tonality
	local total = 0
	local deltas = {}
	for index, key in METERS do
		local delta = line.fx[index]
		if delta > 0 then
			if line.napkin then
				delta *= math.max(1, tonalityMult)
			elseif disliked then
				delta = -math.max(1, delta * 0.6)
			else
				delta *= tonalityMult * (liked and 1.6 or 1)
			end
		end
		delta = math.floor(delta * 2 + 0.5) / 2
		session.meters[key] = math.clamp(session.meters[key] + delta, 0, MAX)
		deltas[key] = delta
		total += delta
	end
	session.usedTags[line.tag] = true
	if line.napkin then
		session.napkinUsed = true
	end
	return deltas, total, liked, disliked
end

local function onAction(player, action)
	local session = sessions[player]
	if not session or type(action) ~= "table" then
		return
	end
	if os.clock() - session.lastAction < Config.Pitch.minTurnTime then
		return
	end
	session.lastAction = os.clock()
	local customer = session.customer
	local archetype = PitchData.Archetypes[session.archetypeKey]
	local profile = DataService.get(player)
	if not profile then
		return
	end

	if action.type == "leave" then
		finish(player, "left", 0, "Okay... bye then?")
		return
	end

	if action.type == "line" then
		if session.patience <= 0 then
			return
		end
		local line = session.options[tonumber(action.index) or 0]
		if not line then
			return
		end
		local tonality = math.clamp(tonumber(action.tonality) or 0, 0, 1)
		if tonality ~= tonality then -- NaN
			tonality = 0
		end
		local deltas, total, liked, disliked = applyLine(session, line, tonality)
		session.patience -= 1

		local reaction
		if line.napkin then
			reaction = "I... don't have a pen. Oh. OH. Supply and demand!"
		elseif total >= 4 then
			reaction = pick(PitchData.Reactions.great)
		elseif total > 0 then
			reaction = pick(PitchData.Reactions.good)
		else
			reaction = pick(PitchData.Reactions.bad)
		end
		CustomerService.say(customer, reaction, 3)
		drawOptions(session)

		local data = snapshot(session)
		data.deltas = deltas
		data.reaction = reaction
		data.liked = liked
		data.disliked = disliked
		data.napkin = line.napkin == true
		data.tonality = tonality
		if session.patience <= 0 then
			data.options = {}
			data.lastChance = true
			CustomerService.say(customer, "Last chance. Close me or I'm gone.", 4)
		end
		Remotes.PitchUpdate:FireClient(player, data)
		return
	end

	if action.type == "close" then
		local chance = closeChance(session.meters)
		if rng:NextNumber() <= chance then
			-- FBI: any hard-sell line and you're fined instead of paid.
			if archetype.special == "fbi" then
				local hardSold = session.usedTags.pressure or session.usedTags.hype or session.usedTags.urgency
				if hardSold then
					local fine = math.floor(math.min(profile.cash * 0.05, 50_000 * (profile.ipos + 1)))
					DataService.addCash(player, -fine)
					finish(player, "busted", -fine, PitchData.FBI.busted)
					return
				end
			end

			local amount, perfect = payoutFor(session, profile, player)
			if archetype.special == "fbi" then
				amount *= 3
			end
			profile.pensSold += 1
			if perfect then
				profile.perfectCloses += 1
			end
			if session.napkinUsed then
				profile.napkins += 1
			end

			-- Index.
			local visitor = session.visitor
			local isNew = profile.index[visitor.id] == nil
			profile.index[visitor.id] = (profile.index[visitor.id] or 0) + 1
			local _, rarityIndex = Config.findById(Config.Rarities, visitor.rarity)
			local best = profile.best and Visitors.byId[profile.best]
			local _, bestIndex = Config.findById(Config.Rarities, best and best.rarity or "")
			if not best or rarityIndex > (bestIndex or 0) then
				profile.best = visitor.id
			end
			DataService.changed(player)

			-- Cash or recruit? The player decides; no answer = cash.
			local weakest = EconomyService.weakestBroker(profile)
			local daily = Config.getRarity(visitor.rarity).daily
			local canRecruit = weakest == nil or Config.getRarity(weakest.rarity).daily < daily
			local token = {}
			pendingDeals[player] = { amount = amount, visitorId = visitor.id, token = token }
			task.delay(Config.DealTimeout, function()
				local deal = pendingDeals[player]
				if deal and deal.token == token then
					PitchService.resolveDeal(player, "cash")
				end
			end)

			local line = archetype.special == "fbi" and PitchData.FBI.honest or pick(PitchData.CloseSuccess)
			finish(player, "deal", amount, line, {
				perfect = perfect,
				napkin = session.napkinUsed,
				deal = {
					visitorId = visitor.id,
					daily = daily,
					isNew = isNew,
					canRecruit = canRecruit,
					replaces = weakest and weakest.id or nil,
					brokerCount = #profile.brokers,
					timeout = Config.DealTimeout,
				},
			})
			if rarityIndex >= 5 then
				EconomyService.notifyAll(
					string.format("%s closed %s (%s)!", player.DisplayName, visitor.name, Config.getRarity(visitor.rarity).name),
					"big"
				)
			end
			return
		end

		-- Failed close: lose patience, certainty drops a notch.
		if session.patience <= 0 then
			finish(player, "walked", 0, pick(PitchData.WalkAway))
			return
		end
		session.patience -= 1
		for _, key in METERS do
			session.meters[key] = math.max(0, session.meters[key] - 1)
		end
		local reaction = pick(PitchData.CloseFail)
		CustomerService.say(customer, reaction, 3)
		local data = snapshot(session)
		data.reaction = reaction
		data.closeFailed = true
		data.deltas = { pen = -1, you = -1, firm = -1 }
		if session.patience <= 0 then
			data.options = {}
			data.lastChance = true
		end
		Remotes.PitchUpdate:FireClient(player, data)
	end
end

function PitchService.resolveDeal(player, choice)
	local deal = pendingDeals[player]
	if not deal then
		return
	end
	pendingDeals[player] = nil
	local visitor = Visitors.byId[deal.visitorId]
	if choice == "recruit" and EconomyService.recruit(player, deal.visitorId) then
		Remotes.PitchEnd:FireClient(player, { result = "recruited", visitorId = deal.visitorId })
		EconomyService.notify(player, visitor.name .. " joined your firm!", "success")
		return
	end
	DataService.addCash(player, deal.amount)
	Remotes.PitchEnd:FireClient(player, { result = "sold", amount = deal.amount, visitorId = deal.visitorId })
	if deal.amount >= 1_000_000 then
		EconomyService.notifyAll(
			string.format("%s just sold a pen for %s!", player.DisplayName, Format.cash(deal.amount)),
			"big"
		)
	end
end

function PitchService.start()
	CustomerService.start(start)
	Remotes.PitchAction.OnServerEvent:Connect(onAction)
	Remotes.Deal.OnServerEvent:Connect(function(player, choice)
		PitchService.resolveDeal(player, choice == "recruit" and "recruit" or "cash")
	end)

	Players.PlayerRemoving:Connect(function(player)
		-- Leaving mid-deal still pays out.
		if pendingDeals[player] then
			PitchService.resolveDeal(player, "cash")
		end
		local session = sessions[player]
		if session then
			sessions[player] = nil
			CustomerService.setBusy(session.customer, false)
		end
	end)

	-- Walking away or dying ends the pitch.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player, session in sessions do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				local gone = not root
					or not humanoid
					or humanoid.Health <= 0
					or not session.customer.model.Parent
					or (root.Position - session.customer.root.Position).Magnitude > 28
				if gone then
					finish(player, "left", 0, "Hey! Where are you going?")
				end
			end
		end
	end)
end

return PitchService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">WorldService</string>
          <string name="Source"><![CDATA[-- The living world: harbor water, zone gates, the Wolf Speech event,
-- the chest-thump hum and the global leaderboard board.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local Remotes = ReplicatedStorage.Remotes

local WorldService = {}

local map = Workspace:WaitForChild("Map")

local function fillWater()
	local terrain = Workspace.Terrain
	terrain.WaterColor = Color3.fromRGB(25, 70, 90)
	terrain.WaterTransparency = 0.35
	terrain.WaterReflectance = 0.6
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 8
	-- The main bay, plus open sea around the far-away Swiss Vault and
	-- Private Island. Filled in chunks so the server doesn't hitch.
	local regions = {
		{ minX = -760, maxX = 760, minZ = -560, maxZ = 760 },
		{ minX = -2950, maxX = -2250, minZ = 1050, maxZ = 1750 },
		{ minX = 2050, maxX = 2750, minZ = 1650, maxZ = 2350 },
	}
	for _, region in regions do
		for x = region.minX, region.maxX, 190 do
			for z = region.minZ, region.maxZ, 190 do
				terrain:FillBlock(CFrame.new(x, -18, z), Vector3.new(190, 30, 190), Enum.Material.Water)
				terrain:FillBlock(CFrame.new(x, -36, z), Vector3.new(190, 6, 190), Enum.Material.Sand)
			end
			task.wait()
		end
	end

	-- Soft moving clouds.
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.6
	clouds.Color = Color3.fromRGB(255, 250, 245)
	clouds.Parent = terrain
end

-- Parts named "Elevator_<zoneId>" take you to that zone.
local function setupElevators()
	for _, part in map:GetDescendants() do
		local zoneId = part:IsA("BasePart") and string.match(part.Name, "^Elevator_(%w+)$")
		local zone = zoneId and Config.getZone(zoneId)
		if zone then
			local prompt = Instance.new("ProximityPrompt")
			prompt.Name = "ElevatorPrompt"
			prompt.ActionText = "Ride elevator"
			prompt.ObjectText = zone.name .. (zone.rebirths > 0 and string.format(" (%d rebirths)", zone.rebirths) or "")
			prompt.HoldDuration = 0.4
			prompt.MaxActivationDistance = 10
			prompt.RequiresLineOfSight = false
			prompt.Parent = part
			prompt.Triggered:Connect(function(player)
				local ok, message = EconomyService.teleport(player, zone.id)
				EconomyService.notify(player, message, ok and "success" or "error")
			end)
		end
	end
end

-- The Wolf Speech ---------------------------------------------------------

local function setStage(active)
	local stage = map:FindFirstChild("SpeechStage", true)
	if not stage then
		return
	end
	for _, descendant in stage:GetDescendants() do
		if descendant:IsA("BasePart") and descendant.Name == "StageLight" then
			descendant.Color = active and Color3.fromRGB(255, 40, 40) or Color3.fromRGB(255, 190, 60)
		elseif descendant:IsA("SpotLight") or descendant:IsA("PointLight") then
			descendant.Brightness = active and 6 or 2
		end
	end
end

local SPEECH_LINES = {
	"Let me tell you something. There's no nobility in poverty!",
	"I'm not leaving! The show goes on!",
	"Pick up the phone and start dialing!",
	"The only thing standing between you and your goal is the story you keep telling yourself!",
	"Are you behind a desk right now? Then SELL SOMETHING!",
}

local function runSpeechLoop()
	while true do
		-- Nobody knows when the Wolf will speak.
		task.wait(math.random(Config.Speech.minInterval, Config.Speech.maxInterval))

		EconomyService.notifyAll(string.format("THE WOLF IS SPEAKING! x%.1f money for %ds!", Config.Speech.mult, Config.Speech.duration), "event")
		Workspace:SetAttribute("SpeechActive", true)
		Workspace:SetAttribute("SpeechEndsAt", os.time() + Config.Speech.duration)
		Workspace:SetAttribute("SpeechLine", SPEECH_LINES[math.random(1, #SPEECH_LINES)])
		setStage(true)
		task.wait(Config.Speech.duration)
		Workspace:SetAttribute("SpeechActive", false)
		setStage(false)
		EconomyService.notifyAll("The speech is over. Back to the phones!", "info")
	end
end

-- The hum -----------------------------------------------------------------

local humCooldowns = {}

local function showHum(player)
	local head = player.Character and player.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("HumBubble")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "HumBubble"
	gui.Size = UDim2.fromOffset(170, 40)
	gui.StudsOffset = Vector3.new(0, 4.4, 0)
	gui.MaxDistance = 90
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.Text = "mm-MM-mm-MM"
	label.TextColor3 = Color3.fromRGB(255, 220, 90)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Parent = gui
	gui.Parent = head
	task.delay(Config.Hum.duration, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
end

local function onHum(player)
	local now = os.clock()
	if (humCooldowns[player] or 0) > now then
		return
	end
	humCooldowns[player] = now + Config.Hum.cooldown
	player:SetAttribute("HumUntil", now + Config.Hum.duration)
	player:SetAttribute("HumReadyAt", os.time() + Config.Hum.cooldown)
	showHum(player)

	local humming = 0
	for _, other in Players:GetPlayers() do
		if (other:GetAttribute("HumUntil") or 0) > now then
			humming += 1
		end
	end
	if humming >= Config.Hum.crowdSize then
		EconomyService.notifyAll(
			string.format("%d wolves are humming! Sales x%.2f for everyone humming.", humming, Config.Hum.crowdMult),
			"event"
		)
	else
		EconomyService.notify(player, string.format("You're humming. Sales x%.1f for %ds.", Config.Hum.mult, Config.Hum.duration), "success")
	end
end

-- Leaderboard -------------------------------------------------------------

local function buildBoard(part)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Brightness = 1.4

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(8, 14, 12)
	bg.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0.14, 0)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.Text = "RICHEST WOLVES (ALL-TIME)"
	title.TextColor3 = Color3.fromRGB(255, 205, 70)
	title.Parent = bg

	local list = Instance.new("Frame")
	list.Name = "List"
	list.Position = UDim2.fromScale(0.04, 0.16)
	list.Size = UDim2.fromScale(0.92, 0.82)
	list.BackgroundTransparency = 1
	list.Parent = bg
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0.01, 0)
	layout.Parent = list

	gui.Parent = part
	return list
end

local function refreshBoard(list)
	local top = DataService.getTopEarners(10)
	if #top == 0 then
		-- No DataStores (Studio): show the players in this server instead.
		for _, player in Players:GetPlayers() do
			local profile = DataService.get(player)
			if profile then
				table.insert(top, { name = player.DisplayName, value = profile.lifetime })
			end
		end
		table.sort(top, function(a, b)
			return a.value > b.value
		end)
	end
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(10, #top) do
		local entry = top[rank]
		local row = Instance.new("TextLabel")
		row.LayoutOrder = rank
		row.Size = UDim2.new(1, 0, 0.09, 0)
		row.BackgroundTransparency = rank % 2 == 0 and 1 or 0.85
		row.BackgroundColor3 = Color3.fromRGB(60, 200, 120)
		row.Font = Enum.Font.Code
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextColor3 = rank == 1 and Color3.fromRGB(255, 215, 80) or Color3.fromRGB(120, 255, 160)
		row.Text = string.format(" #%-2d %-18s %s", rank, string.sub(entry.name, 1, 18), Format.cash(entry.value))
		row.Parent = list
	end
end

function WorldService.start()
	task.spawn(fillWater)
	setupElevators()
	setStage(false)
	task.spawn(runSpeechLoop)

	Remotes.Hum.OnServerEvent:Connect(onHum)
	Players.PlayerRemoving:Connect(function(player)
		humCooldowns[player] = nil
	end)

	local boardPart = map:FindFirstChild("LeaderboardBoard", true)
	if boardPart then
		local list = buildBoard(boardPart)
		task.spawn(function()
			task.wait(5)
			while true do
				refreshBoard(list)
				task.wait(60)
			end
		end)
	end
end

return WorldService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="SoundService" referent="39">
    <Properties>
      <string name="Name">SoundService</string>
      <bool name="RespectFilteringEnabled">true</bool>
    </Properties>
  </Item>
  <Item class="StarterPlayer" referent="40">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="41">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="LocalScript" referent="43">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- Client entry point: builds the UI and wires up keybinds.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")

local Format = require(ReplicatedStorage.Shared.Format)
local Store = require(script.Parent.Store)
local Theme = require(script.Parent.UI.Theme)
local Notifier = require(script.Parent.UI.Notifier)
local Hud = require(script.Parent.UI.Hud)
local Shop = require(script.Parent.UI.Shop)
local Collection = require(script.Parent.UI.Collection)
local PitchUI = require(script.Parent.UI.PitchUI)
local World = require(script.Parent.World)
local Movement = require(script.Parent.Movement)
local Tutorial = require(script.Parent.Tutorial)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local screen = Theme.create("ScreenGui", {
	Name = "SellMeThisPen",
	ResetOnSpawn = false,
	IgnoreGuiInset = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local function hum()
	Remotes.Hum:FireServer()
end

Notifier.mount(screen)
Hud.mount(screen, {
	openShop = function()
		Shop.toggleShop()
	end,
	hum = hum,
	openFirm = Collection.toggleFirm,
	openIndex = Collection.toggleIndex,
	openTeleport = Collection.toggleTeleport,
	openIPO = Shop.openIPO,
})
Shop.mount(screen)
Collection.mount(screen)
PitchUI.mount(screen)
World.start()
Movement.start(screen)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	-- The HUD owns the top-right corner (like the big simulators).
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false)
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or Store.inPitch then
		return
	end
	if input.KeyCode == Enum.KeyCode.B then
		Shop.toggleShop()
	elseif input.KeyCode == Enum.KeyCode.H then
		hum()
	elseif input.KeyCode == Enum.KeyCode.F then
		Collection.toggleFirm()
	elseif input.KeyCode == Enum.KeyCode.I then
		Collection.toggleIndex()
	elseif input.KeyCode == Enum.KeyCode.T then
		Collection.toggleTeleport()
	end
end)

-- Earnings popups whenever cash jumps.
Store.Changed:Connect(function(data, previous)
	if not previous then
		return
	end
	local delta = data.profile.cash - previous.profile.cash
	-- Passive ticks are small and constant; only celebrate real sales.
	if delta > data.income * 1.5 + 1 then
		Hud.floatText("+" .. Format.cash(delta), Theme.Colors.money)
	elseif delta < -1 and data.profile.pensSold == previous.profile.pensSold then
		Hud.floatText("-" .. Format.cash(-delta), Theme.Colors.red)
	end
end)

-- New players get the playthrough tutorial.
Tutorial.start(screen)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Movement</string>
            <string name="Source"><![CDATA[-- Sprint (hold Left Shift, or the RUN button on touch screens), a double
-- jump that always flips, and the occasional flip on a normal jump. Flips
-- are visual only: they rotate the root joint, so physics are untouched.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Theme = require(script.Parent.UI.Theme)
local Store = require(script.Parent.Store)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer

local Movement = {}

-- Fires "sprint" (after a proper sprint) and "flip" for the tutorial.
local signal = Instance.new("BindableEvent")
Movement.Event = signal.Event

local WALK_SPEED = 16
local SPRINT_SPEED = 28
local FLIP_CHANCE = 0.3
local DOUBLE_JUMP_VELOCITY = 55
local FLIP_TIME = 0.5

local FLIPS = {
	back = function(t)
		return CFrame.Angles(t * math.pi * 2, 0, 0)
	end,
	front = function(t)
		return CFrame.Angles(-t * math.pi * 2, 0, 0)
	end,
	side = function(t)
		return CFrame.Angles(0, 0, t * math.pi * 2)
	end,
	spin = function(t)
		-- A corkscrew: a full twist while flipping backwards.
		return CFrame.Angles(t * math.pi * 2, t * math.pi * 2, 0)
	end,
}
local FLIP_KINDS = { "back", "back", "front", "side", "spin" }

local sprintHeld = false
local sprintToggled = false

local function rootJoint(character)
	local lowerTorso = character:FindFirstChild("LowerTorso")
	local joint = lowerTorso and lowerTorso:FindFirstChild("Root")
	if not joint then
		local root = character:FindFirstChild("HumanoidRootPart")
		joint = root and root:FindFirstChild("RootJoint")
	end
	return joint
end

-- Spin the character around its middle by rotating the root joint's C0.
function Movement.flip(character, kind)
	local joint = character and rootJoint(character)
	local curve = FLIPS[kind]
	if not joint or not curve or character:GetAttribute("Flipping") then
		return
	end
	character:SetAttribute("Flipping", true)
	local original = joint.C0
	local pivot = CFrame.new(0, 1, 0) -- rotate around the torso, not the hips
	local started = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local t = math.min(1, (os.clock() - started) / FLIP_TIME)
		local eased = 1 - (1 - t) ^ 2
		if not joint.Parent then
			connection:Disconnect()
			return
		end
		joint.C0 = original * pivot * curve(eased) * pivot:Inverse()
		if t >= 1 then
			connection:Disconnect()
			joint.C0 = original
			character:SetAttribute("Flipping", nil)
		end
	end)
end

local function doFlip(character, kind)
	kind = kind or FLIP_KINDS[math.random(1, #FLIP_KINDS)]
	Movement.flip(character, kind)
	Remotes.Flip:FireServer(kind)
	signal:Fire("flip")
end

local jumpedAt = 0
local doubleJumped = false

local function onCharacter(character)
	local humanoid = character:WaitForChild("Humanoid")
	doubleJumped = false
	humanoid.StateChanged:Connect(function(_, new)
		if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
			doubleJumped = false
		end
		if new ~= Enum.HumanoidStateType.Jumping or Store.inPitch then
			return
		end
		jumpedAt = os.clock()
		if math.random() < FLIP_CHANCE then
			-- Wait until we're actually off the ground.
			task.delay(0.08, doFlip, character)
		end
	end)
end

-- Jump again in the air: a second jump, and you always flip.
local lastRequest = 0
local function onJumpRequest()
	-- JumpRequest repeats every frame while the button is held; only a new
	-- press (after a short gap) counts.
	local fresh = os.clock() - lastRequest > 0.12
	lastRequest = os.clock()
	if not fresh then
		return
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root or Store.inPitch or doubleJumped then
		return
	end
	local state = humanoid:GetState()
	local airborne = state == Enum.HumanoidStateType.Freefall or state == Enum.HumanoidStateType.Jumping
	if not airborne or os.clock() - jumpedAt < 0.2 then
		return
	end
	doubleJumped = true
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, DOUBLE_JUMP_VELOCITY, velocity.Z)
	if not character:GetAttribute("Flipping") then
		doFlip(character, math.random() < 0.5 and "back" or "front")
	end
end

local function buildSprintButton(screen)
	if not UserInputService.TouchEnabled then
		return
	end
	local button = Theme.button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -110, 1, -150),
		Size = UDim2.fromOffset(70, 70),
		BackgroundColor3 = Theme.Colors.panel,
		BackgroundTransparency = 0.25,
		Font = Theme.FontBlack,
		Text = "RUN",
		TextColor3 = Theme.Colors.text,
		Parent = screen,
	}, function()
		sprintToggled = not sprintToggled
	end)
	Theme.corner(35).Parent = button
	local stroke = Theme.stroke(Theme.Colors.gold, 2)
	stroke.Parent = button
	RunService.Heartbeat:Connect(function()
		button.TextColor3 = sprintToggled and Theme.Colors.gold or Theme.Colors.text
	end)
end

function Movement.start(screen)
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		task.spawn(onCharacter, player.Character)
	end

	-- Other players' flips.
	Remotes.Flip.OnClientEvent:Connect(function(other, kind)
		if typeof(other) == "Instance" and other:IsA("Player") and other.Character then
			Movement.flip(other.Character, kind)
		end
	end)

	UserInputService.JumpRequest:Connect(onJumpRequest)
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.LeftShift and not processed then
			sprintHeld = true
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			sprintHeld = false
		end
	end)
	buildSprintButton(screen)

	local fov = 70
	local sprintTime = 0
	RunService.RenderStepped:Connect(function(dt)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		-- The pitch screen plants your feet and runs its own camera.
		if not humanoid or Store.inPitch then
			return
		end
		local sprinting = (sprintHeld or sprintToggled) and humanoid.MoveDirection.Magnitude > 0.1
		humanoid.WalkSpeed = sprinting and SPRINT_SPEED or WALK_SPEED
		sprintTime = sprinting and sprintTime + dt or 0
		if sprintTime > 1.2 and sprintTime - dt <= 1.2 then
			signal:Fire("sprint")
		end
		local camera = Workspace.CurrentCamera
		if camera.CameraType == Enum.CameraType.Custom then
			fov += ((sprinting and 80 or 70) - fov) * math.min(1, dt * 6)
			camera.FieldOfView = fov
		end
	end)
end

return Movement
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[-- Client-side copy of the player's profile, kept fresh by DataSync.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Store = {
	data = nil, -- { profile, income, ipoMult, nextIpoMult }
	inPitch = false,
}

local changed = Instance.new("BindableEvent")
Store.Changed = changed.Event

local dataSync = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DataSync")
dataSync.OnClientEvent:Connect(function(data)
	local previous = Store.data
	Store.data = data
	changed:Fire(data, previous)
end)
dataSync:FireServer()

function Store.profile()
	return Store.data and Store.data.profile
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[-- The playthrough tutorial: a quest card that walks new players through
-- everything, with a guide line to the nearest customer and a bouncing
-- arrow on the button you need. Finishing it pays x2 money for a while.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local TutorialData = require(ReplicatedStorage.Shared.Tutorial)
local Theme = require(script.Parent.UI.Theme)
local Hud = require(script.Parent.UI.Hud)
local Modal = require(script.Parent.UI.Modal)
local PitchUI = require(script.Parent.UI.PitchUI)
local Movement = require(script.Parent.Movement)
local Store = require(script.Parent.Store)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local player = Players.LocalPlayer
local Colors = Theme.Colors
local Steps = TutorialData.Steps

local Tutorial = {}

local completed -- number of finished steps (local, so the card reacts instantly)
local done = false
local card, cardTitle, cardText, cardBar, cardCount
local arrow
local beam, beamStart, beamEnd, marker
local linesPicked = 0
local sprinted, flipped = false, false

local function current()
	return completed and Steps[completed + 1]
end

local function render()
	local step = current()
	if done or not step then
		card.Visible = false
		arrow.Visible = false
		return
	end
	card.Visible = true
	cardCount.Text = string.format("TUTORIAL %d/%d", step.index, #Steps)
	cardTitle.Text = step.title
	cardText.Text = step.text
	Theme.tween(cardBar, 0.3, { Size = UDim2.fromScale((step.index - 1) / #Steps, 1) })
	Theme.pop(card, 0.3)
	sprinted, flipped = false, false
	local profile = Store.profile()
	if step.id == "shop" and profile and profile.pen ~= "bic" then
		-- Already upgraded: nothing to teach here.
		task.defer(function()
			Tutorial.complete("shop")
		end)
	end
end

function Tutorial.complete(stepId)
	local step = current()
	if done or not step or step.id ~= stepId then
		return
	end
	completed = step.index
	Remotes.Tutorial:FireServer(step.id)
	if completed >= #Steps then
		done = true
	end
	render()
end

-- A pitch fell through before the deal: back to "find a customer".
local function resetPitchPart()
	local step = current()
	if step and step.index <= TutorialData.byId.deal.index and step.index > 1 then
		completed = 0
		linesPicked = 0
		Remotes.Tutorial:FireServer("reset")
		render()
	end
end

-- Guide line to the nearest customer you're allowed to pitch.
local function nearestCustomer()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local folder = Workspace:FindFirstChild("Customers")
	local profile = Store.profile()
	if not root or not folder or not profile then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, model in folder:GetChildren() do
		local zoneId = model:GetAttribute("Zone")
		local customerRoot = model:FindFirstChild("HumanoidRootPart")
		local prompt = customerRoot and customerRoot:FindFirstChild("PitchPrompt")
		if customerRoot and prompt and prompt.Enabled and zoneId and Config.zoneUnlocked(profile, zoneId) then
			local distance = (customerRoot.Position - root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = model, distance
			end
		end
	end
	return best
end

local function buildGuides(screen)
	beamStart = Instance.new("Attachment")
	beamStart.Name = "TutorialStart"
	beamEnd = Instance.new("Attachment")
	beamEnd.Name = "TutorialEnd"
	beam = Instance.new("Beam")
	beam.Name = "TutorialGuide"
	beam.Color = ColorSequence.new(Colors.gold)
	beam.LightEmission = 1
	beam.FaceCamera = true
	beam.Width0 = 0.6
	beam.Width1 = 0.6
	beam.Segments = 1
	beam.Transparency = NumberSequence.new(0.2)
	beam.Attachment0 = beamStart
	beam.Attachment1 = beamEnd
	beam.Enabled = false
	beam.Parent = Workspace.Terrain
	beamStart.Parent = Workspace.Terrain
	beamEnd.Parent = Workspace.Terrain

	marker = Theme.create("BillboardGui", {
		Name = "TutorialMarker",
		Size = UDim2.fromOffset(140, 70),
		StudsOffset = Vector3.new(0, 5.5, 0),
		AlwaysOnTop = true,
		Enabled = false,
		Parent = player:WaitForChild("PlayerGui"),
	})
	Theme.label({
		Size = UDim2.fromScale(1, 1),
		Font = Theme.FontBlack,
		Text = "PITCH ME!\n▼",
		TextColor3 = Colors.gold,
		Outline = 3,
		Parent = marker,
	})

	arrow = Theme.label({
		Name = "TutorialArrow",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromOffset(60, 60),
		Font = Theme.Font,
		Text = "👈",
		Visible = false,
		ZIndex = 20,
		Outline = false,
		Parent = screen,
	})
end

local function buildCard(screen)
	card = Theme.create("Frame", {
		Name = "TutorialCard",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 86),
		Size = UDim2.new(0.9, 0, 0, 118),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = screen,
	}, {
		Theme.corner(16),
		Theme.stroke(Colors.stroke, 3.5),
		Theme.create("UISizeConstraint", { MaxSize = Vector2.new(520, 118) }),
	})
	Theme.fill(card, "blue")
	cardCount = Theme.label({
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(0.5, 0, 0, 22),
		Font = Theme.FontBlack,
		TextColor3 = Colors.gold,
		TextXAlignment = Enum.TextXAlignment.Left,
		Outline = 2,
		Parent = card,
	})
	Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 6),
		Size = UDim2.new(0.5, -14, 0, 22),
		Font = Theme.FontBlack,
		Text = string.format("REWARD: x%d MONEY %dMIN", TutorialData.RewardMult, TutorialData.RewardDuration / 60),
		TextColor3 = Colors.money,
		TextXAlignment = Enum.TextXAlignment.Right,
		Outline = 2,
		Parent = card,
	})
	cardTitle = Theme.label({
		Position = UDim2.fromOffset(14, 30),
		Size = UDim2.new(1, -28, 0, 30),
		Font = Theme.FontBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Outline = 2.5,
		Parent = card,
	})
	cardText = Theme.label({
		Position = UDim2.fromOffset(14, 62),
		Size = UDim2.new(1, -28, 0, 36),
		Font = Theme.FontBold,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		Outline = 1.5,
		Parent = card,
	})
	local track = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.new(1, -28, 0, 10),
		BackgroundColor3 = Color3.fromRGB(20, 30, 70),
		Parent = card,
	}, { Theme.corner(5), Theme.stroke(Colors.stroke, 2) })
	cardBar = Theme.create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Colors.gold,
		Parent = track,
	}, { Theme.corner(5) })
end

local function screenWidth()
	return Workspace.CurrentCamera.ViewportSize.X
end

-- Per-frame: move the guide line, marker and arrow for the current step.
local function updateGuides()
	local step = current()
	local target = step and not done and step.target
	local showBeam = target == "customer" and not Store.inPitch
	local customer = showBeam and nearestCustomer()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if customer and root then
		beam.Enabled = true
		beamStart.WorldPosition = root.Position - Vector3.new(0, 2.5, 0)
		beamEnd.WorldPosition = customer.HumanoidRootPart.Position - Vector3.new(0, 2.5, 0)
		marker.Adornee = customer:FindFirstChild("Head")
		marker.Enabled = true
		marker.StudsOffset = Vector3.new(0, 5 + math.sin(os.clock() * 5) * 0.4, 0)
	else
		beam.Enabled = false
		marker.Enabled = false
	end

	local button = target and Hud.buttons[target]
	if button and button.Visible and not Store.inPitch then
		arrow.Visible = true
		local position = button.AbsolutePosition
		local size = button.AbsoluteSize
		local bounce = math.sin(os.clock() * 8) * 8
		if position.X > screenWidth() / 2 then
			-- Button on the right: point at it from the left.
			arrow.Text = "👉"
			arrow.Position = UDim2.fromOffset(position.X - 66 - bounce, position.Y + size.Y / 2)
		else
			arrow.Text = "👈"
			arrow.Position = UDim2.fromOffset(position.X + size.X + 6 + bounce, position.Y + size.Y / 2)
		end
	else
		arrow.Visible = false
	end
	-- Keep the card out of the way of the pitch screen.
	card.Position = Store.inPitch and UDim2.new(0.5, 0, 0.3, 0) or UDim2.new(0.5, 0, 0, 86)
end

function Tutorial.start(screen)
	buildCard(screen)
	buildGuides(screen)

	-- Wait for the saved progress.
	task.spawn(function()
		repeat
			task.wait(0.25)
		until Store.profile()
		local profile = Store.profile()
		done = profile.tutorialDone == true
		completed = profile.tutorialStep or 0
		render()
	end)

	PitchUI.Event:Connect(function(event)
		if event == "start" then
			Tutorial.complete("talk")
		elseif event == "line" then
			Tutorial.complete("line")
		elseif event == "tonality" then
			linesPicked += 1
			Tutorial.complete("tonality")
			if linesPicked >= 2 then
				Tutorial.complete("meters")
			end
		elseif event == "close" then
			-- Closing early skips straight past the meters lesson.
			Tutorial.complete("meters")
			Tutorial.complete("close")
		elseif event == "deal" then
			Tutorial.complete("close")
		elseif event == "done" then
			Tutorial.complete("deal")
		elseif event == "failed" then
			resetPitchPart()
		end
	end)
	Modal.Opened:Connect(function(key)
		if key == "firm" or key == "index" or key == "teleport" or key == "rebirth" then
			Tutorial.complete(key)
		end
	end)
	Movement.Event:Connect(function(event)
		local step = current()
		if not step or step.id ~= "move" then
			return
		end
		if event == "sprint" then
			sprinted = true
		elseif event == "flip" then
			flipped = true
		end
		if sprinted and flipped then
			Tutorial.complete("move")
		end
	end)
	Store.Changed:Connect(function(data)
		if data.profile.pen ~= "bic" then
			Tutorial.complete("shop")
		end
		if data.profile.tutorialDone and not done then
			done = true
			render()
		end
	end)

	RunService.RenderStepped:Connect(updateGuides)
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Collection</string>
              <string name="Source"><![CDATA[-- Your firm (brokers), the visitor Index and the teleporter.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Visitors = require(ReplicatedStorage.Shared.Visitors)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Notifier = require(script.Parent.Notifier)
local Store = require(script.Parent.Parent.Store)

local Remotes = ReplicatedStorage.Remotes
local Colors = Theme.Colors

local Collection = {}

local firmModal, indexModal, tpModal

local function scroller(parent, layout)
	local frame = Theme.create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = Colors.stroke,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = parent,
	})
	layout.Parent = frame
	return frame
end

local function clear(frame)
	for _, child in frame:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function rarityGradient(rarity, parent)
	if rarity.id == "ultra" or rarity.id == "exotic" then
		Theme.create("UIGradient", {
			Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 230, 90)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 200, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 90, 220)),
			}),
			Rotation = 20,
			Parent = parent,
		})
	end
end

-- Firm ---------------------------------------------------------------------------

local firmList, firmHeader

local function renderFirm()
	local profile = Store.profile()
	if not profile or not firmList then
		return
	end
	clear(firmList)
	local total = 0
	for slot = 1, Config.MaxBrokers do
		local visitor = Visitors.byId[profile.brokers[slot] or ""]
		local row = Theme.create("Frame", {
			LayoutOrder = slot,
			Size = UDim2.new(1, -8, 0, 58),
			BackgroundColor3 = Colors.panel,
			Parent = firmList,
		}, { Theme.corner(10) })
		if visitor then
			local rarity = Config.getRarity(visitor.rarity)
			local perSecond = Config.brokerIncome(visitor.rarity)
			total += perSecond
			Theme.stroke(rarity.color, 1.5).Parent = row
			local tag = Theme.label({
				Position = UDim2.fromOffset(12, 6),
				Size = UDim2.new(0.6, 0, 0, 18),
				Font = Theme.FontBlack,
				Text = string.upper(rarity.name),
				TextColor3 = rarity.color,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
			rarityGradient(rarity, tag)
			Theme.label({
				Position = UDim2.fromOffset(12, 26),
				Size = UDim2.new(1, -150, 0, 24),
				Text = visitor.name,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
			Theme.label({
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.new(1, -100, 0, 8),
				Size = UDim2.fromOffset(170, 42),
				Font = Theme.FontBold,
				Text = string.format("%s/day\n%s/s", Format.cash(rarity.daily), Format.rate(perSecond)),
				TextColor3 = Colors.money,
				TextXAlignment = Enum.TextXAlignment.Right,
				Parent = row,
			})
			local fire = Theme.button({
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Size = UDim2.fromOffset(80, 38),
				BackgroundColor3 = Color3.fromRGB(110, 40, 40),
				Font = Theme.FontBlack,
				Text = "FIRE",
				Parent = row,
			}, function()
				local ok, message = Remotes.FireBroker:InvokeServer(slot)
				Notifier.show(message, ok and "info" or "error")
			end)
			Theme.corner(8).Parent = fire
		else
			Theme.stroke(Colors.stroke, 1).Parent = row
			Theme.label({
				Position = UDim2.fromOffset(12, 0),
				Size = UDim2.new(1, -24, 1, 0),
				Font = Theme.Font,
				Text = "Empty desk. Close a sale and choose RECRUIT to fill it.",
				TextColor3 = Colors.muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				Parent = row,
			})
		end
	end
	local data = Store.data
	firmHeader.Text = string.format(
		"%d/%d brokers  ·  %s/s  (x%.1f rebirth = %s/s)  ·  offline x%.1f",
		#profile.brokers,
		Config.MaxBrokers,
		Format.rate(total),
		data.ipoMult,
		Format.rate(total * data.ipoMult),
		Config.OfflineEarningsRate
	)
end

local function buildFirm(screen)
	firmModal = Modal.new(screen, "YOUR FIRM", Colors.firm, Vector2.new(640, 640))
	firmModal.key = "firm"
	firmHeader = Theme.label({
		Size = UDim2.new(1, 0, 0, 24),
		Font = Theme.FontBold,
		TextColor3 = Colors.money,
		Parent = firmModal.content,
	})
	local holder = Theme.create("Frame", {
		Position = UDim2.fromOffset(0, 32),
		Size = UDim2.new(1, 0, 1, -32),
		BackgroundTransparency = 1,
		Parent = firmModal.content,
	})
	firmList = scroller(holder, Theme.create("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }))
	firmModal.onOpen = renderFirm
end

-- Index ----------------------------------------------------------------------------

local indexGrid, indexHeader, indexSignature
local viewports = {} -- [visitorId] = { viewport, sold } for the cards on screen
local previews = {} -- [visitorId] = preview model from the server
local loading = false

-- Put a visitor's model in their card: full color if you've sold to them,
-- a black silhouette if not.
local function showPreview(visitorId, model)
	local entry = viewports[visitorId]
	if not entry or entry.viewport:FindFirstChild("Model") then
		return
	end
	local copy = model:Clone()
	copy.Name = "Model"
	for _, descendant in copy:GetDescendants() do
		if descendant:IsA("Humanoid") then
			descendant.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		elseif not entry.sold then
			if descendant:IsA("BasePart") then
				descendant.Color = Color3.new(0, 0, 0)
				descendant.Material = Enum.Material.SmoothPlastic
				descendant.Reflectance = 0
				if descendant:IsA("MeshPart") then
					descendant.TextureID = ""
				end
			elseif descendant:IsA("SpecialMesh") then
				descendant.TextureId = ""
			elseif descendant:IsA("Decal") or descendant:IsA("Texture") or descendant:IsA("SurfaceAppearance") then
				descendant:Destroy()
			end
		end
	end
	copy.Parent = entry.viewport
	local camera = entry.viewport:FindFirstChildOfClass("Camera") or Instance.new("Camera")
	camera.FieldOfView = 32
	camera.CFrame = CFrame.lookAt(Vector3.new(2.2, 1.4, -10), Vector3.new(0, 0.3, 0))
	camera.Parent = entry.viewport
	entry.viewport.CurrentCamera = camera
end

-- Fetch previews one at a time in the background (the server builds them on demand).
local function loadPreviews()
	if loading then
		return
	end
	loading = true
	task.spawn(function()
		for _, visitor in ipairs(Visitors) do
			if not indexModal.frame.Visible then
				break
			end
			if not previews[visitor.id] then
				local ok, model = pcall(function()
					return Remotes.GetPreview:InvokeServer(visitor.id)
				end)
				if ok and model then
					previews[visitor.id] = model
				end
			end
			if previews[visitor.id] then
				showPreview(visitor.id, previews[visitor.id])
			end
		end
		loading = false
	end)
end

local function renderIndex(force)
	local data = Store.data
	if not data or not indexGrid then
		return
	end
	local profile = data.profile
	local signature = tostring(data.indexCount)
	for id, count in profile.index do
		signature ..= id .. count
	end
	if signature == indexSignature and not force then
		return
	end
	indexSignature = signature

	local counts = {}
	for id in profile.index do
		local visitor = Visitors.byId[id]
		if visitor then
			counts[visitor.rarity] = (counts[visitor.rarity] or 0) + 1
		end
	end
	local parts = {}
	for _, rarity in Config.Rarities do
		table.insert(parts, string.format('<font color="#%s">%s %d/%d</font>', rarity.color:ToHex(), rarity.name, counts[rarity.id] or 0, #(Visitors.byRarity[rarity.id] or {})))
	end
	indexHeader.Text = string.format(
		"<b>%d/%d collected  ·  +%.1f%% sales</b>\n%s",
		data.indexCount,
		#Visitors,
		(data.indexMult - 1) * 100,
		table.concat(parts, "  ")
	)

	clear(indexGrid)
	table.clear(viewports)
	for order, visitor in ipairs(Visitors) do
		local rarity = Config.getRarity(visitor.rarity)
		local sold = profile.index[visitor.id]
		local card = Theme.create("Frame", {
			LayoutOrder = order,
			BackgroundColor3 = Color3.new(1, 1, 1),
			Parent = indexGrid,
		}, { Theme.corner(12), Theme.stroke(sold and rarity.color or Colors.stroke, sold and 3 or 2) })
		Theme.fill(card, sold and { rarity.color:Lerp(Color3.new(1, 1, 1), 0.25), rarity.color:Lerp(Color3.new(0, 0, 0), 0.45) } or "navy")
		local viewport = Theme.create("ViewportFrame", {
			Position = UDim2.fromOffset(4, 22),
			Size = UDim2.new(1, -8, 0, 118),
			BackgroundTransparency = 1,
			Ambient = sold and Color3.fromRGB(200, 200, 200) or Color3.new(0, 0, 0),
			LightColor = sold and Color3.new(1, 1, 1) or Color3.new(0, 0, 0),
			LightDirection = Vector3.new(-0.4, -0.6, 0.7),
			Parent = card,
		})
		viewports[visitor.id] = { viewport = viewport, sold = sold ~= nil }
		local tag = Theme.label({
			Position = UDim2.fromOffset(6, 4),
			Size = UDim2.new(1, -12, 0, 18),
			Font = Theme.FontBlack,
			Text = string.format("#%d  %s", visitor.number, string.upper(rarity.name)),
			TextColor3 = sold and Colors.text or rarity.color,
			Outline = 2,
			Parent = card,
		})
		rarityGradient(rarity, tag)
		Theme.label({
			Position = UDim2.new(0, 6, 1, -48),
			Size = UDim2.new(1, -12, 0, 26),
			Font = Theme.FontBlack,
			Text = sold and visitor.name or "???",
			TextWrapped = true,
			Outline = 2,
			Parent = card,
		})
		Theme.label({
			Position = UDim2.new(0, 6, 1, -21),
			Size = UDim2.new(1, -12, 0, 16),
			Font = Theme.FontBold,
			Text = sold and string.format("sold x%d  ·  x%s", sold, Format.short(rarity.mult)) or ("1 in " .. Format.commas(rarity.odds)),
			TextColor3 = sold and Colors.gold or Colors.muted,
			Outline = 1.5,
			Parent = card,
		})
		local cached = previews[visitor.id]
		if cached then
			showPreview(visitor.id, cached)
		end
	end
	loadPreviews()
end

local function buildIndex(screen)
	indexModal = Modal.new(screen, "VISITOR INDEX", Colors.gold, Vector2.new(820, 620))
	indexModal.key = "index"
	indexHeader = Theme.label({
		Size = UDim2.new(1, 0, 0, 46),
		Font = Theme.Font,
		TextScaled = false,
		TextSize = 15,
		TextWrapped = true,
		RichText = true,
		TextColor3 = Colors.text,
		Parent = indexModal.content,
	})
	local holder = Theme.create("Frame", {
		Position = UDim2.fromOffset(0, 52),
		Size = UDim2.new(1, 0, 1, -52),
		BackgroundTransparency = 1,
		Parent = indexModal.content,
	})
	indexGrid = scroller(holder, Theme.create("UIGridLayout", {
		CellSize = UDim2.fromOffset(150, 196),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}))
	indexModal.onOpen = function()
		renderIndex(true)
	end
end

-- Teleport ------------------------------------------------------------------------

local tpList

local function renderTeleport()
	local profile = Store.profile()
	if not profile or not tpList then
		return
	end
	clear(tpList)
	for order, zone in Config.Zones do
		local unlocked = Config.zoneUnlocked(profile, zone.id)
		local row = Theme.create("Frame", {
			LayoutOrder = order,
			Size = UDim2.new(1, -8, 0, 64),
			BackgroundColor3 = Colors.panel,
			Parent = tpList,
		}, { Theme.corner(10), Theme.stroke(unlocked and Colors.gold or Colors.stroke, 1.5) })
		Theme.label({
			Position = UDim2.fromOffset(14, 6),
			Size = UDim2.new(1, -170, 0, 26),
			Font = Theme.FontBlack,
			Text = zone.name,
			TextColor3 = unlocked and Colors.gold or Colors.muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		Theme.label({
			Position = UDim2.fromOffset(14, 34),
			Size = UDim2.new(1, -170, 0, 20),
			Font = Theme.Font,
			Text = string.format("Rebirths %s  ·  pays x%s  ·  luck x%.2g  ·  %s", Config.zoneRange(zone), Format.short(zone.budgetMult), zone.luck, zone.subtitle),
			TextColor3 = Colors.muted,
			TextXAlignment = Enum.TextXAlignment.Left,
			Parent = row,
		})
		local go = Theme.button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(140, 46),
			BackgroundColor3 = unlocked and Color3.fromRGB(40, 150, 80) or Colors.panelLight,
			Font = Theme.FontBlack,
			Text = unlocked and "TELEPORT" or string.format("%d REBIRTHS", zone.rebirths),
			Parent = row,
		}, function()
			if not unlocked then
				return
			end
			local ok, message = Remotes.Teleport:InvokeServer(zone.id)
			Notifier.show(message, ok and "success" or "error")
			if ok then
				tpModal:close()
			end
		end)
		Theme.corner(10).Parent = go
	end
end

local function buildTeleport(screen)
	tpModal = Modal.new(screen, "TELEPORT", Colors.blue, Vector2.new(640, 560))
	tpModal.key = "teleport"
	tpList = scroller(tpModal.content, Theme.create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }))
	tpModal.onOpen = renderTeleport
end

function Collection.mount(screen)
	buildFirm(screen)
	buildIndex(screen)
	buildTeleport(screen)
	local lastBrokers
	Store.Changed:Connect(function(data)
		local brokers = table.concat(data.profile.brokers, ",") .. data.ipoMult
		if firmModal.frame.Visible and brokers ~= lastBrokers then
			renderFirm()
		end
		lastBrokers = brokers
		if indexModal.frame.Visible then
			renderIndex()
		end
	end)
end

function Collection.toggleFirm()
	firmModal:toggle()
end

function Collection.toggleIndex()
	indexModal:toggle()
end

function Collection.toggleTeleport()
	tpModal:toggle()
end

return Collection
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Always-on HUD, in the style of the big Roblox simulators:
--   left:          2x2 grid of chunky menu buttons
--   bottom left:   brokers, cash and rebirths
--   bottom center: income + level bar
--   top center:    a goal hint
--   top right:     square icon buttons (teleport, hum)
--   right:         active boosts (x2 money, Wolf Speech)

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Theme = require(script.Parent.Theme)
local Store = require(script.Parent.Parent.Store)

local player = Players.LocalPlayer
local Colors = Theme.Colors

local Hud = {}
Hud.buttons = {} -- name -> button, so the tutorial can point at them

local root
local displayedCash = 0

-- Building blocks ---------------------------------------------------------------

local function bigButton(name, icon, label, gradient, onClick)
	local button = Theme.button({
		Name = name,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
		AutoButtonColor = false,
	}, onClick)
	Theme.corner(18).Parent = button
	Theme.stroke(Colors.stroke, 3.5).Parent = button
	Theme.fill(button, gradient)
	-- Glossy top half.
	Theme.create("Frame", {
		Position = UDim2.fromScale(0.06, 0.05),
		Size = UDim2.fromScale(0.88, 0.38),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		Parent = button,
	}, { Theme.corner(14) })
	Theme.label({
		Name = "Icon",
		Position = UDim2.fromScale(0.1, 0.02),
		Size = UDim2.fromScale(0.8, 0.66),
		Font = Theme.Font,
		Text = icon,
		Outline = false,
		Parent = button,
	})
	Theme.label({
		Name = "Label",
		Position = UDim2.fromScale(0.02, 0.66),
		Size = UDim2.fromScale(0.96, 0.3),
		Font = Theme.FontBlack,
		Text = label,
		Outline = 2.5,
		Parent = button,
	})
	Hud.buttons[name] = button
	return button
end

local function iconButton(name, icon, onClick)
	local button = Theme.button({
		Name = name,
		Size = UDim2.fromOffset(62, 62),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "",
	}, onClick)
	Theme.corner(12).Parent = button
	Theme.stroke(Colors.stroke, 3).Parent = button
	Theme.fill(button, "gray")
	Theme.label({
		Name = "Icon",
		Position = UDim2.fromScale(0.12, 0.08),
		Size = UDim2.fromScale(0.76, 0.76),
		Font = Theme.Font,
		Text = icon,
		Outline = false,
		Parent = button,
	})
	local badge = Theme.label({
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 12),
		Size = UDim2.fromOffset(72, 20),
		Font = Theme.FontBlack,
		Text = "",
		Parent = button,
	})
	Hud.buttons[name] = button
	return button, badge
end

local function statPill(parent, order, icon)
	local pill = Theme.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(250, 56),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Parent = parent,
	}, { Theme.corner(28) })
	Theme.create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.7, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Parent = pill,
	})
	Theme.label({
		Position = UDim2.fromOffset(4, 2),
		Size = UDim2.fromOffset(52, 52),
		Font = Theme.Font,
		Text = icon,
		Outline = false,
		Parent = pill,
	})
	return Theme.label({
		Position = UDim2.fromOffset(62, 6),
		Size = UDim2.new(1, -66, 1, -12),
		Font = Theme.FontBlack,
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Left,
		Outline = 3,
		Parent = pill,
	})
end

local function boostCard(parent, order, gradient, title)
	local card = Theme.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(170, 64),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		Parent = parent,
	}, { Theme.corner(14), Theme.stroke(Colors.stroke, 3) })
	Theme.fill(card, gradient)
	Theme.label({
		Position = UDim2.fromOffset(8, 4),
		Size = UDim2.new(1, -16, 0, 32),
		Font = Theme.FontBlack,
		Text = title,
		Outline = 2.5,
		Parent = card,
	})
	local sub = Theme.label({
		Position = UDim2.fromOffset(8, 36),
		Size = UDim2.new(1, -16, 0, 22),
		Font = Theme.FontBlack,
		Text = "",
		TextColor3 = Colors.gold,
		Outline = 2,
		Parent = card,
	})
	return card, sub
end

-- Effects --------------------------------------------------------------------

function Hud.floatText(text, color)
	if not root then
		return
	end
	local label = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, math.random(-80, 80), 0.62, 0),
		Size = UDim2.fromOffset(320, 48),
		Font = Theme.FontBlack,
		Text = text,
		TextColor3 = color or Colors.money,
		Outline = 3,
		ZIndex = 5,
		Parent = root,
	})
	Theme.pop(label, 0.25)
	Theme.tween(label, 1.4, { Position = label.Position - UDim2.fromOffset(0, 90), TextTransparency = 1 })
	task.delay(1.5, function()
		label:Destroy()
	end)
end

-- Big title card in the middle of the screen (zones, the Wolf Speech).
function Hud.zoneCard(zone)
	if not root then
		return
	end
	local card = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.2, 0),
		Size = UDim2.fromOffset(640, 120),
		BackgroundTransparency = 1,
		Parent = root,
	})
	local title = Theme.label({
		Size = UDim2.new(1, 0, 0.6, 0),
		Font = Theme.FontBlack,
		Text = string.upper(zone.name),
		TextColor3 = Colors.gold,
		TextTransparency = 1,
		Outline = 4,
		Parent = card,
	})
	local subtitle = Theme.label({
		Position = UDim2.new(0, 0, 0.62, 0),
		Size = UDim2.new(1, 0, 0.3, 0),
		Font = Theme.FontBold,
		Text = zone.subtitle,
		TextTransparency = 1,
		Outline = 2.5,
		Parent = card,
	})
	Theme.pop(card, 0.4)
	Theme.tween(title, 0.4, { TextTransparency = 0 })
	Theme.tween(subtitle, 0.7, { TextTransparency = 0 })
	task.delay(3, function()
		Theme.tween(title, 0.5, { TextTransparency = 1 })
		Theme.tween(subtitle, 0.5, { TextTransparency = 1 })
		task.wait(0.55)
		card:Destroy()
	end)
end

-- Mount ------------------------------------------------------------------------------

function Hud.mount(screen, actions)
	root = screen

	-- Menu grid (left) ------------------------------------------------------------
	local grid = Theme.create("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 14, 0.42, 0),
		Size = UDim2.fromOffset(222, 222),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Theme.create("UIGridLayout", {
			CellSize = UDim2.fromOffset(106, 106),
			CellPadding = UDim2.fromOffset(10, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local items = {
		{ "shop", "🛒", "Shop", "orange", actions.openShop },
		{ "firm", "💼", "Firm", "green", actions.openFirm },
		{ "index", "📖", "Index", "red", actions.openIndex },
		{ "rebirth", "🔄", "Rebirth", "purple", actions.openIPO },
	}
	for order, item in items do
		local button = bigButton(item[1], item[2], item[3], item[4], item[5])
		button.LayoutOrder = order
		button.Parent = grid
	end
	-- Rainbow ring on Rebirth when you can afford it.
	local rebirthRing = Theme.create("UIStroke", {
		Thickness = 5,
		Color = Color3.new(1, 1, 1),
		Enabled = false,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
	Theme.create("Frame", {
		Size = UDim2.new(1, 8, 1, 8),
		Position = UDim2.fromOffset(-4, -4),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Parent = Hud.buttons.rebirth,
	}, { Theme.corner(20), rebirthRing })
	local rainbow = Theme.create("UIGradient", { Color = Theme.Rainbow, Parent = rebirthRing })
	local ready = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -8, 0, 8),
		Size = UDim2.fromOffset(70, 26),
		Rotation = 20,
		Font = Theme.FontBlack,
		Text = "READY!",
		TextColor3 = Colors.money,
		Visible = false,
		ZIndex = 3,
		Outline = 2.5,
		Parent = Hud.buttons.rebirth,
	})

	-- Stats (bottom left) ---------------------------------------------------------
	local stats = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 14, 1, -14),
		Size = UDim2.fromOffset(260, 184),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { Theme.create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, VerticalAlignment = Enum.VerticalAlignment.Bottom }) })
	local brokersLabel = statPill(stats, 1, "💼")
	local cashLabel = statPill(stats, 2, "💰")
	cashLabel.TextColor3 = Colors.money
	local rebirthLabel = statPill(stats, 3, "🔄")
	rebirthLabel.TextColor3 = Color3.fromRGB(220, 170, 255)

	-- Income + level bar (bottom center) -----------------------------------------------
	local bottom = Theme.create("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.new(0.5, 0, 0, 92),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { Theme.create("UISizeConstraint", { MaxSize = Vector2.new(660, 92), MinSize = Vector2.new(320, 92) }) })
	local incomeLabel = Theme.label({
		Size = UDim2.new(1, 0, 0, 30),
		Font = Theme.FontBlack,
		Text = "Income: +$0/s",
		TextColor3 = Colors.blue,
		Outline = 2.5,
		Parent = bottom,
	})
	local bar = Theme.create("Frame", {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, 0, 0, 50),
		BackgroundColor3 = Color3.fromRGB(40, 30, 20),
		Parent = bottom,
	}, { Theme.corner(10), Theme.stroke(Colors.stroke, 4) })
	local barFill = Theme.create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = bar,
	}, { Theme.corner(8) })
	Theme.create("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(255, 150, 20), Color3.fromRGB(255, 235, 60)),
		Parent = barFill,
	})
	local levelLabel = Theme.label({
		Position = UDim2.fromOffset(14, 6),
		Size = UDim2.new(0.55, 0, 1, -12),
		Font = Theme.FontBlack,
		Text = "Lv.1",
		TextXAlignment = Enum.TextXAlignment.Left,
		Outline = 3,
		ZIndex = 2,
		Parent = bar,
	})
	local progressLabel = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 6),
		Size = UDim2.new(0.42, 0, 1, -12),
		Font = Theme.FontBlack,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Right,
		Outline = 3,
		ZIndex = 2,
		Parent = bar,
	})

	-- Goal hint (top center) --------------------------------------------------------------
	local hint = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(560, 40),
		Font = Theme.FontBlack,
		Text = "",
		Outline = 3,
		Parent = screen,
	})
	local multLabel = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 56),
		Size = UDim2.fromOffset(460, 22),
		Font = Theme.FontBold,
		Text = "",
		TextColor3 = Colors.gold,
		Outline = 2,
		Parent = screen,
	})

	-- Icon buttons (top right) ----------------------------------------------------------------
	local icons = Theme.create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(140, 62),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Theme.create("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 10),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	local tp = iconButton("teleport", "🗺️", actions.openTeleport)
	tp.LayoutOrder = 1
	tp.Parent = icons
	local hum, humBadge = iconButton("hum", "🥁", actions.hum)
	hum.LayoutOrder = 2
	hum.Parent = icons

	-- Boosts (right) -------------------------------------------------------------------------------
	local boosts = Theme.create("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0.6, 0),
		Size = UDim2.fromOffset(170, 220),
		BackgroundTransparency = 1,
		Parent = screen,
	}, { Theme.create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Right }) })
	local moneyCard, moneySub = boostCard(boosts, 1, "gold", "x2 MONEY")
	local speechCard, speechSub = boostCard(boosts, 2, "red", string.format("WOLF x%.1f", Config.Speech.mult))
	local humCard, humSub = boostCard(boosts, 3, "purple", "HUMMING")

	-- Live updates ---------------------------------------------------------------------------------
	-- Everything that steps aside while you're pitching.
	local hideInPitch = { grid, stats, bottom, hint, multLabel, icons }
	local t = 0
	RunService.RenderStepped:Connect(function(dt)
		t += dt
		for _, element in hideInPitch do
			element.Visible = not Store.inPitch
		end
		rainbow.Rotation = (t * 120) % 360
		local data = Store.data
		if not data then
			return
		end
		local profile = data.profile
		local target = profile.cash
		displayedCash += (target - displayedCash) * math.min(1, dt * 8)
		if math.abs(target - displayedCash) < 1 then
			displayedCash = target
		end
		cashLabel.Text = Format.cash(displayedCash)

		local now = os.time()
		moneyCard.Visible = (profile.boostUntil or 0) > now
		if moneyCard.Visible then
			moneySub.Text = Format.time(profile.boostUntil - now)
		end
		speechCard.Visible = Workspace:GetAttribute("SpeechActive") == true
		if speechCard.Visible then
			speechSub.Text = "SPEECH! " .. Format.time((Workspace:GetAttribute("SpeechEndsAt") or now) - now)
		end
		local readyAt = player:GetAttribute("HumReadyAt") or 0
		humBadge.Text = readyAt > now and Format.time(readyAt - now) or ""
		humCard.Visible = readyAt - now > Config.Hum.cooldown - Config.Hum.duration
		if humCard.Visible then
			humSub.Text = string.format("x%.1f  %s", Config.Hum.mult, Format.time(readyAt - now - (Config.Hum.cooldown - Config.Hum.duration)))
		end

		local canRebirth = profile.cash >= data.rebirthCost
		rebirthRing.Enabled = canRebirth
		ready.Visible = canRebirth
		if speechCard.Visible then
			hint.Text = "THE WOLF IS SPEAKING! SELL SELL SELL!"
			hint.TextColor3 = Colors.gold
		elseif canRebirth then
			hint.Text = "Rebirth to earn even more!"
			hint.TextColor3 = Color3.fromRGB(220, 170, 255)
		else
			hint.Text = "Sell pens. Get rich."
			hint.TextColor3 = Colors.text
		end
	end)

	Store.Changed:Connect(function(data, previous)
		local profile = data.profile
		incomeLabel.Text = "Income: +" .. Format.rate(data.income) .. "/s"
		brokersLabel.Text = string.format("%d/%d", #profile.brokers, Config.MaxBrokers)
		rebirthLabel.Text = tostring(profile.ipos)
		local pen = Config.findById(Config.Pens, profile.pen)
		multLabel.Text = string.format("🖊️ %s   ·   x%.1f rebirth   ·   x%.2f index", pen and pen.name or "?", data.ipoMult, data.indexMult)

		local level, progress, nextAt = Config.levelFor(profile.lifetime)
		local rank = Config.rankFor(profile.lifetime)
		levelLabel.Text = string.format("Lv.%d  %s", level, rank.title)
		levelLabel.TextColor3 = Color3.new(1, 1, 1)
		progressLabel.Text = Format.short(profile.lifetime) .. " / " .. Format.short(nextAt)
		Theme.tween(barFill, 0.3, { Size = UDim2.fromScale(math.max(0.02, progress), 1) })
		if not previous then
			displayedCash = profile.cash
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Modal</string>
              <string name="Source"><![CDATA[-- A centered window: colored header with a chunky outlined title, a navy
-- body and a big red close button.

local Theme = require(script.Parent.Theme)
local Colors = Theme.Colors

local Modal = {}
Modal.__index = Modal

local openModal

-- Fires with a modal's `key` whenever one opens (the tutorial listens).
local opened = Instance.new("BindableEvent")
Modal.Opened = opened.Event

local ACCENT_GRADIENT = {
	[Colors.money] = "green",
	[Colors.gold] = "gold",
	[Colors.purple] = "purple",
	[Colors.blue] = "blue",
	[Colors.firm] = "purple",
	[Colors.red] = "red",
}

-- `maxSize` is the size on a big screen; on phones the window shrinks to fit.
function Modal.new(screen, title, accent, maxSize)
	local self = setmetatable({}, Modal)
	maxSize = maxSize or Vector2.new(640, 460)
	accent = accent or Colors.money
	self.frame = Theme.create("Frame", {
		Name = title,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.52),
		Size = UDim2.fromScale(0.94, 0.86),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 10,
		Parent = screen,
	}, {
		Theme.corner(22),
		Theme.stroke(Colors.stroke, 4),
		Theme.create("UISizeConstraint", { MaxSize = maxSize }),
	})
	Theme.fill(self.frame, "navy")

	local bar = Theme.create("Frame", {
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = self.frame,
	}, {
		Theme.corner(22),
	})
	Theme.fill(bar, ACCENT_GRADIENT[accent] or "blue")
	-- Square off the bottom corners of the header.
	local seam = Theme.create("Frame", {
		Position = UDim2.new(0, 0, 1, -22),
		Size = UDim2.new(1, 0, 0, 22),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		Parent = bar,
	})
	Theme.fill(seam, { (Theme.Gradients[ACCENT_GRADIENT[accent] or "blue"])[2], (Theme.Gradients[ACCENT_GRADIENT[accent] or "blue"])[2] })
	Theme.create("Frame", {
		Position = UDim2.new(0, 0, 1, -2),
		Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = Colors.stroke,
		BorderSizePixel = 0,
		Parent = bar,
	})
	Theme.label({
		Position = UDim2.new(0, 22, 0, 10),
		Size = UDim2.new(1, -100, 0, 44),
		Font = Theme.FontBlack,
		Text = title,
		TextColor3 = Colors.text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Outline = 3,
		Parent = bar,
	})
	local close = Theme.button({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 8, 0, -8),
		Size = UDim2.fromOffset(52, 52),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Font = Theme.FontBlack,
		Text = "X",
		TextColor3 = Colors.text,
		ZIndex = 12,
		Parent = self.frame,
	}, function()
		self:close()
	end)
	Theme.corner(14).Parent = close
	Theme.stroke(Colors.stroke, 3).Parent = close
	Theme.fill(close, "red")

	self.content = Theme.create("Frame", {
		Name = "Content",
		Position = UDim2.new(0, 16, 0, 74),
		Size = UDim2.new(1, -32, 1, -88),
		BackgroundTransparency = 1,
		Parent = self.frame,
	})
	return self
end

function Modal:open()
	if openModal and openModal ~= self then
		openModal:close()
	end
	openModal = self
	self.frame.Visible = true
	Theme.pop(self.frame, 0.3)
	if self.onOpen then
		self.onOpen()
	end
	opened:Fire(self.key)
end

function Modal:close()
	self.frame.Visible = false
	if openModal == self then
		openModal = nil
	end
end

function Modal:toggle()
	if self.frame.Visible then
		self:close()
	else
		self:open()
	end
end

function Modal.closeAll()
	if openModal then
		openModal:close()
	end
end

return Modal
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Notifier</string>
              <string name="Source"><![CDATA[-- Stacking toast notifications on the right side of the screen.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Theme = require(script.Parent.Theme)

local Notifier = {}

local KIND_COLORS = {
	info = Theme.Colors.blue,
	success = Theme.Colors.money,
	error = Theme.Colors.red,
	big = Theme.Colors.gold,
	event = Theme.Colors.purple,
}

local container

function Notifier.mount(screen)
	container = Theme.create("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 90),
		Size = UDim2.new(0, 340, 0.6, 0),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		Theme.create("UIListLayout", {
			SortOrder = Enum.SortOrder.LayoutOrder,
			Padding = UDim.new(0, 8),
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
		}),
		Theme.create("UISizeConstraint", { MaxSize = Vector2.new(340, math.huge) }),
	})

	ReplicatedStorage.Remotes.Notify.OnClientEvent:Connect(Notifier.show)
end

local order = 0
function Notifier.show(text, kind)
	if not container then
		return
	end
	order += 1
	local color = KIND_COLORS[kind] or KIND_COLORS.info
	local toast = Theme.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Theme.Colors.panel,
		BackgroundTransparency = 0.08,
		Parent = container,
	}, {
		Theme.corner(10),
		Theme.stroke(color, 2),
		Theme.padding(10),
		Theme.create("Frame", {
			Size = UDim2.new(0, 4, 1, 0),
			BackgroundColor3 = color,
			BorderSizePixel = 0,
		}),
		Theme.create("TextLabel", {
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -12, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			Font = kind == "big" and Theme.FontBlack or Theme.FontBold,
			TextSize = kind == "big" and 19 or 17,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Theme.Colors.text,
			Text = text,
		}),
	})
	Theme.pop(toast, 0.3)

	-- Keep the stack short.
	local toasts = {}
	for _, child in container:GetChildren() do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	if #toasts > 5 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end

	task.delay(kind == "big" and 6 or 4, function()
		if toast.Parent then
			Theme.tween(toast, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

return Notifier
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">PitchUI</string>
              <string name="Source"><![CDATA[-- The pitch minigame screen.
--
-- Flow: pick a line (1/2/3) -> stop the tonality needle (Space/click) ->
-- the customer reacts and the certainty meters move. CLOSE (C) whenever
-- you dare. X or walking away ends the pitch.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local Visitors = require(ReplicatedStorage.Shared.Visitors)
local Theme = require(script.Parent.Theme)
local Modal = require(script.Parent.Modal)
local Store = require(script.Parent.Parent.Store)

local Remotes = ReplicatedStorage.Remotes
local Colors = Theme.Colors
local player = Players.LocalPlayer

local PitchUI = {}

-- Fires ("start" | "line" | "tonality" | "close" | "deal" | "done" | "failed") for the tutorial.
local signal = Instance.new("BindableEvent")
PitchUI.Event = signal.Event

local METERS = {
	{ key = "pen", label = "PEN", color = Colors.pen },
	{ key = "you", label = "YOU", color = Colors.you },
	{ key = "firm", label = "FIRM", color = Colors.firm },
}

local screen
local ui = {}
local session -- current pitch data
local phase = "idle" -- idle | choose | tonality | waiting | ended
local chosenIndex
local needle = { pos = 0, dir = 1, speed = 1.3, center = 0.5 }
local revealedDislikes = {}
local cameraConnection

local function playDing(pitch)
	local sound = Instance.new("Sound")
	sound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	sound.Volume = 0.5
	sound.PlaybackSpeed = pitch or 1
	SoundService:PlayLocalSound(sound)
	task.delay(2, function()
		sound:Destroy()
	end)
end

-- Camera ---------------------------------------------------------------------

local function startCamera(model)
	local camera = Workspace.CurrentCamera
	local character = player.Character
	local myRoot = character and character:FindFirstChild("HumanoidRootPart")
	local head = model and model:FindFirstChild("Head")
	if not myRoot or not head then
		return
	end
	camera.CameraType = Enum.CameraType.Scriptable
	local t = 0
	cameraConnection = RunService.RenderStepped:Connect(function(dt)
		if not head.Parent or not myRoot.Parent then
			return
		end
		t += dt
		-- Over-the-shoulder, slowly drifting like a film dolly shot.
		local toCustomer = (head.Position - myRoot.Position) * Vector3.new(1, 0, 1)
		if toCustomer.Magnitude < 0.1 then
			return
		end
		local forward = toCustomer.Unit
		local right = forward:Cross(Vector3.yAxis)
		local drift = math.sin(t * 0.35) * 0.6
		local eye = myRoot.Position - forward * 5 + right * (2.4 + drift) + Vector3.new(0, 2.6, 0)
		local target = head.Position + Vector3.new(0, -0.3, 0)
		local goal = CFrame.lookAt(eye, target)
		camera.CFrame = camera.CFrame:Lerp(goal, math.min(1, dt * 4))
		camera.FieldOfView += (48 - camera.FieldOfView) * math.min(1, dt * 3)
	end)
end

local function stopCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end
	local camera = Workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom
	camera.FieldOfView = 70
end

-- Building blocks --------------------------------------------------------------

local function meterRow(parent, info, order)
	local row = Theme.create("Frame", {
		LayoutOrder = order,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
		Parent = parent,
	})
	Theme.label({
		Size = UDim2.new(0, 60, 1, 0),
		Font = Theme.FontBlack,
		Text = info.label,
		TextColor3 = info.color,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local track = Theme.create("Frame", {
		Position = UDim2.new(0, 66, 0.15, 0),
		Size = UDim2.new(1, -130, 0.7, 0),
		BackgroundColor3 = Colors.bg,
		Parent = row,
	}, { Theme.corner(8), Theme.stroke(Colors.stroke, 1) })
	local fill = Theme.create("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = info.color,
		Parent = track,
	}, { Theme.corner(8), Theme.gradient(info.color, info.color:Lerp(Color3.new(0, 0, 0), 0.35)) })
	-- Tick marks every 2 points.
	for i = 1, 4 do
		Theme.create("Frame", {
			Position = UDim2.new(i / 5, 0, 0, 0),
			Size = UDim2.new(0, 1, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 0.6,
			BorderSizePixel = 0,
			Parent = track,
		})
	end
	local value = Theme.label({
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 56, 1, 0),
		Font = Theme.FontBlack,
		Text = "0",
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = row,
	})
	return { fill = fill, value = value, row = row, track = track }
end

local function deltaPopup(meter, delta)
	if delta == 0 then
		return
	end
	local label = Theme.label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -90, 0.5, 0),
		Size = UDim2.fromOffset(60, 26),
		Font = Theme.FontBlack,
		Text = (delta > 0 and "+" or "") .. tostring(delta),
		TextColor3 = delta > 0 and Colors.money or Colors.red,
		TextStrokeTransparency = 0.3,
		ZIndex = 5,
		Parent = meter.row,
	})
	Theme.tween(label, 1, { Position = label.Position - UDim2.fromOffset(0, 26), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1.1, function()
		label:Destroy()
	end)
end

